import ds/list;
import ds/tree;
import string;

export {
	// For deserialization of downloaded binary content (.binflow).

	// Be sure it has the correct MIME type and encoding on the web server.
	// Easy way to do it is to add "AddType "text/plain; charset=UTF-16" .binflow" in a .htaccess
	// file in the same folder as the binflow file.
	// Another way is to the line to the httpd.conf:
	//   AddType "text/plain; charset=UTF-16" .binflow

	// Also, make sure that when you save a binary file using flow, use setFileContentUTF16.
	// You have to use httpRequest to retrieve it (and not downloadfile), and the BOM marker from
	// the server will make our end understand that it is UCS-2 (camouflaged as UTF-16).
	deserializeBinary(value : string, default_ : flow) -> flow;
	deserializeBinary2(value : string, structFixups : Tree<string, (args : [flow]) -> flow>, default_ : flow) -> flow;
	native toBinary : (value : flow) -> string = Native.toBinary;
	native stringbytes2double : (str : string) -> double = Native.stringbytes2double;
	native stringbytes2int : (str : string) -> int = Native.stringbytes2int;
}

native fromBinary : (s : string, default_ : flow, fixups : (string)->Maybe<([flow])->flow>) -> flow = Native.fromBinary;

deserializeBinary(s, default_) {
	deserializeBinary2(s, makeTree(), default_);
}

deserializeBinary2(s, structFixups, default_) {
	rv = fromBinary(s, default_, \name -> lookupTree(structFixups, name));
	if (rv == flow(s)) { // Not implemented
		deserializeBinaryFlow(s, structFixups, default_);
	} else {
		rv;
	}
}

// The input up to the end of the value being read, and the struct definitions its footer declares
BinaryInput(s : string, endIndex : int, structDefs : [BinaryStructDef]);
BinaryStructDef(arity : int, name : string, fixup : Maybe<([flow]) -> flow>);

// A value still being read around the current one
BinaryFrame ::= BinaryArrayFrame, BinaryStructFrame, BinaryRefFrame;
	// Elements still to read, and those read so far with the last one first
	BinaryArrayFrame(remaining : int, elements : List<flow>);
	BinaryStructFrame(def : BinaryStructDef, remaining : int, elements : List<flow>);
	BinaryRefFrame();

// A result index below zero marks damaged input: the whole value becomes the default
damagedBinaryIndex = -1;
damagedBinaryInt = Pair(0, damagedBinaryIndex);
damagedBinaryString = Pair("", damagedBinaryIndex);

damagedBinary(default_ : flow) -> Pair<flow, int> {
	Pair(default_, damagedBinaryIndex);
}

isDamagedBinary(r : Pair<?, int>) -> bool {
	r.second < 0;
}

getFooterOffset(s : string) -> Pair<int, int> {
	// UTF-16 reserves these values 0xD800-0xDFFF for surrogates
	// This is a workaround for having reserved valuew in structs offset: first pair of symbols contains 0x00000001
	// the next two pairs have (offset & 0x0F0F0F0F) and (offset & 0xF0F0F0F0). So if the first pair of symbols
	// contain 0x00000001 then offset = <2nd pair> | <3rd pair>
	if (strlen(s) < 2) {
		Pair(0, 2)
	} else {
		footerOffset = stringbytes2int(strLeft(s, 2));
		if (footerOffset != 1) {
			Pair(footerOffset, 2)
		} else if (strlen(s) < 6) {
			Pair(0, 6)
		} else {
			Pair(bitOr(stringbytes2int(substring(s, 2, 2)), stringbytes2int(substring(s, 4, 2))), 6)
		}
	}
}

deserializeBinaryFlow(s : string, structFixups : Tree<string, ([flow]) -> flow>, default_ : flow) -> flow {
	footer = getFooterOffset(s);
	footerOffset = footer.first;
	bodyStart = footer.second;
	// The footer lies after the header words and holds at least one word
	defs = if (bodyStart < footerOffset && footerOffset < strlen(s)) {
		readBinaryFooter(BinaryInput(s, strlen(s), []), footerOffset, structFixups);
	} else {
		None();
	}
	r = switch (defs) {
		Some(structDefs): readBinary(BinaryInput(s, footerOffset, structDefs), bodyStart, makeList(), None(), default_);
		None(): damagedBinary(default_);
	}
	if (isDamagedBinary(r)) {
		println("Binary file damaged!");
		default_;
	} else {
		if (r.second < footerOffset) {
			println("Did not understand all!");
		}
		r.first;
	}
}

// Bounded reads: each checks that its words lie before endIndex and yields the value and the index after it
readBinaryWord(input : BinaryInput, index : int) -> Pair<int, int> {
	if (index >= input.endIndex) damagedBinaryInt
	else Pair(getCharCodeAt(input.s, index), index + 1);
}

readBinaryInt(input : BinaryInput, index : int) -> Pair<int, int> {
	if (input.endIndex - index < 2) damagedBinaryInt
	else Pair(stringbytes2int(substring(input.s, index, 2)), index + 2);
}

readBinaryDouble(input : BinaryInput, index : int) -> Pair<double, int> {
	if (input.endIndex - index < 4) Pair(0.0, damagedBinaryIndex)
	else Pair(stringbytes2double(substring(input.s, index, 4)), index + 4);
}

// A run of l characters; a negative length is damaged too
readBinaryChars(input : BinaryInput, index : int, l : int) -> Pair<string, int> {
	if (l < 0 || l > input.endIndex - index) damagedBinaryString
	else Pair(substring(input.s, index, l), index + l);
}

// An int at index: a small word, or a tagged 32-bit int in one of its two forms
readBinaryIntValue(input : BinaryInput, index : int) -> Pair<int, int> {
	tag = readBinaryWord(input, index);
	if (isDamagedBinary(tag)) tag
	else if (tag.first < 0xFFF3) tag
	else if (tag.first == 0xFFF5) readBinaryInt(input, tag.second)
	else if (tag.first == 0xFFF3) {
		// Two ints, value & 0xF0F0F0F0 and value & 0x0F0F0F0F, so that no word is a UTF-16 surrogate
		high = readBinaryInt(input, tag.second);
		low = if (isDamagedBinary(high)) high else readBinaryInt(input, high.second);
		if (isDamagedBinary(low)) low else Pair(bitOr(high.first, low.first), low.second);
	} else damagedBinaryInt;
}

// A string at index: its length in a word or an int after the tag, then its characters
readBinaryStringValue(input : BinaryInput, index : int) -> Pair<string, int> {
	tag = readBinaryWord(input, index);
	l = if (isDamagedBinary(tag)) tag
		else if (tag.first == 0xFFFA) readBinaryWord(input, tag.second)
		else if (tag.first == 0xFFFB) readBinaryInt(input, tag.second)
		else damagedBinaryInt;
	if (isDamagedBinary(l)) damagedBinaryString else readBinaryChars(input, l.second, l.first);
}

// An array head at index: its element count, which fits the words that remain, and where its elements start
readBinaryCount(input : BinaryInput, index : int) -> Pair<int, int> {
	tag = readBinaryWord(input, index);
	count = if (isDamagedBinary(tag)) tag
		else if (tag.first == 0xFFF7) Pair(0, tag.second)
		else if (tag.first == 0xFFF8) readBinaryWord(input, tag.second)
		else if (tag.first == 0xFFF9) readBinaryInt(input, tag.second)
		else damagedBinaryInt;
	// Each element takes at least one word
	if (isDamagedBinary(count) || count.first < 0 || count.first > input.endIndex - count.second) damagedBinaryInt
	else count;
}

// A value with no elements of its own, read with its tag at index
readBinaryLeaf(input : BinaryInput, index : int) -> Pair<flow, int> {
	word = getCharCodeAt(input.s, index);
	ni = index + 1;
	if (word == 0xFFF3 || word == 0xFFF5) {
		i = readBinaryIntValue(input, index);
		Pair(flow(i.first), i.second);
	} else if (word == 0xFFFA || word == 0xFFFB) {
		str = readBinaryStringValue(input, index);
		Pair(flow(str.first), str.second);
	} else if (word == 0xFFFC) {
		d = readBinaryDouble(input, ni);
		Pair(flow(d.first), d.second);
	} else if (word == 0xFFFD) Pair(flow(false), ni)
	else if (word == 0xFFFE) Pair(flow(true), ni)
	else Pair(flow(0), ni); // 0xFFFF is void, which no flow value can hold
}

// The footer is [[arity, name], ...]: an array of entries, each an array of exactly an int and a string
readBinaryFooter(input : BinaryInput, index : int, structFixups : Tree<string, ([flow]) -> flow>) -> Maybe<[BinaryStructDef]> {
	count = readBinaryCount(input, index);
	if (isDamagedBinary(count)) None()
	else readBinaryStructDefs(input, count.second, structFixups, count.first, makeList());
}

readBinaryStructDefs(input : BinaryInput, index : int, structFixups : Tree<string, ([flow]) -> flow>, remaining : int,
	defs : List<BinaryStructDef>) -> Maybe<[BinaryStructDef]> {
	if (remaining == 0) Some(list2array(defs))
	else {
		size = readBinaryCount(input, index);
		arity = if (isDamagedBinary(size) || size.first != 2) damagedBinaryInt else readBinaryIntValue(input, size.second);
		name = if (isDamagedBinary(arity) || arity.first < 0) damagedBinaryString else readBinaryStringValue(input, arity.second);
		if (isDamagedBinary(name)) None()
		else {
			def = BinaryStructDef(arity.first, name.first, lookupTree(structFixups, name.first));
			readBinaryStructDefs(input, name.second, structFixups, remaining - 1, Cons(def, defs));
		}
	}
}

makeBinaryStruct(def : BinaryStructDef, args : [flow]) -> flow {
	switch (def.fixup) {
		Some(fixup): fixup(args);
		None(): makeStructValue(def.name, args, IllegalStruct());
	}
}

// Reads the value at index inside the open frames around it, the innermost first. A value just
// completed, in done, closes the frames it completes; a damaged value damages the whole input
readBinary(input : BinaryInput, index : int, frames : List<BinaryFrame>, done : Maybe<flow>, default_ : flow) -> Pair<flow, int> {
	switch (done) {
		Some(value): {
			switch (frames) {
				EmptyList(): Pair(value, index);
				Cons(frame, rest): {
					switch (frame) {
						BinaryRefFrame(): readBinary(input, index, rest, Some(flow(ref value)), default_);
						BinaryArrayFrame(remaining, elements): {
							read = Cons(value, elements);
							if (remaining > 1) {
								readBinary(input, index, Cons(BinaryArrayFrame(remaining - 1, read), rest), None(), default_);
							} else {
								readBinary(input, index, rest, Some(flow(list2array(read))), default_);
							}
						}
						BinaryStructFrame(def, remaining, elements): {
							read = Cons(value, elements);
							if (remaining > 1) {
								readBinary(input, index, Cons(BinaryStructFrame(def, remaining - 1, read), rest), None(), default_);
							} else {
								readBinary(input, index, rest, Some(makeBinaryStruct(def, list2array(read))), default_);
							}
						}
					}
				}
			}
		}
		None(): {
			if (index >= input.endIndex) {
				damagedBinary(default_);
			} else {
				word = getCharCodeAt(input.s, index);
				if (word < 0xFFF3) {
					// Small ints are the most common value
					readBinary(input, index + 1, frames, Some(flow(word)), default_);
				} else if (word == 0xFFF4) {
					structIndex = readBinaryWord(input, index + 1);
					if (isDamagedBinary(structIndex) || structIndex.first >= length(input.structDefs)) {
						damagedBinary(default_);
					} else {
						def = input.structDefs[structIndex.first];
						// Each field takes at least one word
						if (def.arity > input.endIndex - structIndex.second) {
							damagedBinary(default_);
						} else if (def.arity == 0) {
							readBinary(input, structIndex.second, frames, Some(makeBinaryStruct(def, [])), default_);
						} else {
							readBinary(input, structIndex.second, Cons(BinaryStructFrame(def, def.arity, makeList()), frames), None(), default_);
						}
					}
				} else if (word == 0xFFF6) {
					readBinary(input, index + 1, Cons(BinaryRefFrame(), frames), None(), default_);
				} else if (word == 0xFFF7 || word == 0xFFF8 || word == 0xFFF9) {
					count = readBinaryCount(input, index);
					if (isDamagedBinary(count)) {
						damagedBinary(default_);
					} else if (count.first == 0) {
						empty : [flow] = [];
						readBinary(input, count.second, frames, Some(flow(empty)), default_);
					} else {
						readBinary(input, count.second, Cons(BinaryArrayFrame(count.first, makeList()), frames), None(), default_);
					}
				} else {
					leaf = readBinaryLeaf(input, index);
					if (isDamagedBinary(leaf)) damagedBinary(default_)
					else readBinary(input, leaf.second, frames, Some(leaf.first), default_);
				}
			}
		}
	}
}

// Proposed format:

// It is designed so that all values are a multiple of 2 bytes to fit
// UCS-2 indexing we have for our strings.

// FFFF: void
// FFFE: true
// FFFD: false

// FFFC  B1 B2 B3 B4 B5 B6 B7 B8: double 0x...

// FFFB  L1 L2 L3 L4 B0 ... Bn: string of length 0xL4L3L2L1 encoded in UTF-16
// FFFA  L1 L2 B0 ... (Bn): string of length 0x0000L2L1 encoded in UTF-16

// FFF9  L1 L2 L3 L4 (data): array of length 0xL4L3L2L1, each value itself encoded
// FFF8  L1 L2 (data): array of length 0x0000L2L1, each value itself encoded
// FFF7  empty array

// FFF6 (value): ref to value

// FFF5 B1 B2 B3 B4: int 0xB4B3B2B1

// FFF4 B1 B2  n*value: strut with structdef index 0xB2B1 in the footer
// Footer: [ [FIELDS_COUNT, STRUCT_NAME ] ]

// FFF3 B1 B2 B3 B4 B5 B6 B7 B8: 32-bit integer preserving UTF-16 surrogate pairs
// stored as two 32-bit integers: value & 0xF0F0F0F0 and value & 0x0F0F0F0F

// FE B1 (structname:string) n*value: struct with B1 values

// 00-EF B1: int 0x00B1-0xEFB1

// Free prefixes: F0-FB
