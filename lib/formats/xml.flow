import string;
import behaviour;
import ds/list;
import ds/set;
import math/math;
import net/url_parameter;

// A SAX-style and a DOM-style XML parser.

// It does the most important parts of the XML spec at http://www.w3.org/TR/xml/, but it might fail
// spectacularly on your XML files.

// At some point, we might provide some helper to resolve these guys:
// Predefined entities: &amp; &lt; &gt; &apos; &quot;
// (You can try unescapeHtmlEntities in html2form.)

// The parser does not handle these guys:
// <!ELEMENT ... >
// <!ATTLIST ... >
// <!DOCTYPE ... >
// <!DOCTYPE ... "[" (stuff that can contain < and >) "]>"
// <![IGNORE[ ... ]]>
// <![INCLUDE[ ...]]>
// <!ENTITY ... >
// <!NOTATION >
export {

	// This is a primitive XML SAX-style parser that spits out a stream of XML tags and texts.
	parseXml(xml : string, events : DynamicBehaviour<XmlEvent>) -> void;
	parseXmlWithStrategy(xml : string, events : DynamicBehaviour<XmlEvent>, strategy : [XmlParsingOption]) -> void;

	XmlParsingOption ::= XmlParseLeadingSpaces, XmlValidateNames, XmlKeepComments, XmlEscaping;
		XmlParseLeadingSpaces : (preserve : bool, makeEventForSpaces : bool); // default (false, false);

		// This will check that tag names and attribute names conform to the XML standard.
		// This is a little slower, but can help disambiguate XML text where there are unescaped < characters,
		// in which case they are not treated as tags, but as text
		XmlValidateNames();

		// Whether to keep comments in DOM style parsing - only works with parseXml3WithStrategy!
		XmlKeepComments();

	XmlEscaping ::= LegacyEscaping, StandardEscaping;
		
		// Do not escape/unescape text nodes. However, do escape/unescape attribute values.
		// This was the initial behavior of xml.flow library, and a lot of content relies on it.
		// This is the default.
		LegacyEscaping();
		
		// Escape/unescape according to XML specs.
		StandardEscaping();

	// Escapes < > & ' " to &entities;
	xmlEscape(s : string) -> string;
	// Text node escaping: escapes < > &
	xmlEscapeText(s : string) -> string;
	// restore original string from string processed by xmlEscape or xmlEscapeText
	xmlUnescape(s : string) -> string;

	XmlEvent ::= XmlTagEvent, XmlTextEvent, XmlEndEvent, XmlCommentEvent;

		XmlTagEvent ::= XmlEmptyElement, XmlElementStart, XmlElementEnd, XmlProcessingEvent;

		// Both start and end tag, with attributes "<something a=b ... />"
		XmlEmptyElement(tag : string, attributes : [XmlAttribute]);
		// XML attributes
		XmlAttribute(key : string, value : string);
		// Start tag with attributes "<something a=b ...>"
		XmlElementStart(tag : string, attributes : [XmlAttribute]);
		// The end tag "<something/>"
		XmlElementEnd(tag : string);
		// Text between tags (also "outside" elements)
		XmlTextEvent(text : string);
		// A <!-- comment -->
		XmlCommentEvent(comment : string);
		// <?xml attr=something ?>
		XmlProcessingEvent(tag : string, attributes : [XmlAttribute]);
		// The end of the parsing
		XmlEndEvent();


	// A DOM-style parser that builds a tree. Is somewhat robust against tag errors, but not much
	parseXml2(xml : string) -> XmlNode;
	parseXml2WithStrategy(xml : string, strategy : [XmlParsingOption]) -> XmlNode;

	// If you do not have a single root, this is useful
	parseXml3(xml : string) -> [XmlNode];
	parseXml3WithStrategy(xml : string, strategy : [XmlParsingOption]) -> [XmlNode2];

	stripXmlComments(xml : [XmlNode2]) -> [XmlNode];

	XmlNode ::= XmlElement, XmlText;
		XmlElement(tag : string, attributes : [XmlAttribute], children : [XmlNode]);
		XmlText(text : string);

	XmlNode2 ::= XmlElement2, XmlText, XmlComment;
		XmlElement2(tag : string, attributes : [XmlAttribute], children : [XmlNode2]);
		XmlComment(text : string);

	getXmlChildren(xml : XmlNode) -> [XmlNode];
	getXmlChildren2(xml : XmlNode2) -> [XmlNode2];
	getXmlNodeById(nodes : [XmlNode], filterId : string) -> Maybe<XmlElement>;
	getXmlNode2ById(nodes : [XmlNode2], filterId : string) -> Maybe<XmlElement2>;
	getXmlAttributes(xml : XmlNode) -> [XmlAttribute];
	getXmlAttribute(attributes : [XmlAttribute], attribute : string, default_ : string) -> string;
	getXmlAttributeM(attributes : [XmlAttribute], attribute : string) -> Maybe<string>;

	// Return "" if attribute is not found
	getXmlAttr(attributes: [XmlAttribute], attr: string) -> string;

	// returns only XmlElements without XmlTexts. Useful for stripping spaces and newlines between XmlElements and
	// to get rid of one 'switch' structure, to be able to access tag, attributes and children of every resulting element
	// NOTE: tagFilter must be lowercase!
	filterElements(children : [XmlNode], tagFilter : string) -> [XmlElement];
	filterElementsByTag(elements : [XmlNode2], tagFilter : string) -> [XmlElement2];
	xmlElements(nodes : [XmlNode]) -> [XmlElement] {
		filterElements(nodes, "");
	}

	// searches for the first tag within xmlroots or their children.
	// tag must be lowercase; comparison is case-insensitive!
	getXmlElement(xmlroots: [XmlElement], tag: string) -> Maybe<XmlElement>;

	// tag must be lowercase
	getXmlTagElements(xmlroots: XmlNode, tag: string) -> [XmlElement];

	// Recursive function for finding corresponding element on top level
	getTopLevelElement(xmlroots: [XmlNode2], tag: string) -> Maybe<XmlElement2>;

	// Recursive
	getXmlElement2(xmlroots: [XmlNode2], tag: string) -> Maybe<XmlElement2>;

	getFirstXmlTextContents(children : [XmlNode]) -> string;

	// An attribute whose key is not a valid XML name is left out.
	// An element whose tag is not a valid XML name is written as its content only.
	// The parser reads <!DOCTYPE ...> as an element !DOCTYPE; that element is written as before, with all its attributes.
	xml2string(xml : XmlNode) -> string;
	xmlNode2String(xhml : XmlNode2) -> string;
	// The Name production of XML 1.0
	isXmlName(s : string) -> bool;

	// Preserve attributes; omit text escaping, so might fuck up quoting
	poorXml2text(xml : XmlNode) -> string;

	// Extract just the text, no tags
	xml2text(xml : XmlNode) -> string;

	//Service functions to check is GlueFraments should be inserted on rendering
	nodeSourceStartsWithSpace(xml : XmlNode) -> bool;
	nodeSourceEndsWithSpace(xml : XmlNode) -> bool;

	getXmlText(nodes: [XmlNode2]) -> string;

	getShorterText(nodes: [XmlNode2]) -> string;

	generateIsSpecificTagFn(
		tag : string
	) -> (XmlNode2)-> bool;

	generateHasSpecificAttributeValueFn(
		attribute : string,
		value : string
	) -> (XmlNode2)-> bool;
}

generateHasSpecificAttributeValueFn(
	attribute : string,
	value : string
) -> (XmlNode2)-> bool {
	\el -> switch (el : XmlNode2) {
		XmlElement2(__, atr, __): {
			getXmlAttr(atr, attribute) == value
		};
		default : false
	}
}

generateIsSpecificTagFn(
	tag : string
) -> (XmlNode2)-> bool {
	\el -> switch(el : XmlNode2) {
		XmlElement2(t, __, __) : t == tag;
		default : false;
	};
}

xmlEscape(s : string) -> string {
	s0 = strReplace(s, "&", "&amp;");
	s1 = strReplace(s0, "<", "&lt;");
	s2 = strReplace(s1, ">", "&gt;");
	s3 = strReplace(s2, "'", "&apos;");
	s4 = strReplace(s3, "\"", "&quot;");
	s4;
}

// Escaping quote and apostrophe in text node is optional. 
// We don't escape it to make xml smaller and more readable.
xmlEscapeText(s : string) -> string {
	s0 = strReplace(s, "&", "&amp;");
	s1 = strReplace(s0, "<", "&lt;");
	s2 = strReplace(s1, ">", "&gt;");
	s2;
}

// Decodes &quot; &apos; &gt; &lt; &amp;, &#NNN; and &#xHHH; in one pass, each reference once.
// A reference that is incomplete, or that names no XML character, stays as written.
// https://www.w3.org/TR/REC-xml/#sec-references
xmlUnescape(s : string) -> string {
	if (strIndexOf(s, "&") < 0) s
	else list2string(xmlUnescapeFrom(s, 0, makeList()));
}

xmlNamedEntities = [
	Pair("&quot;", "\""), Pair("&apos;", "'"), Pair("&gt;", ">"), Pair("&lt;", "<"), Pair("&amp;", "&")
];

xmlUnescapeFrom(s : string, start : int, acc : List<string>) -> List<string> {
	amp = strRangeIndexOf(s, "&", start, strlen(s));
	if (amp < 0) {
		Cons(strRight(s, start), acc);
	} else {
		plain = substring(s, start, amp - start);
		decoded = xmlDecodeReference(s, amp);
		xmlUnescapeFrom(s, decoded.second, Cons(decoded.first, Cons(plain, acc)));
	}
}

// Decodes the reference at the "&" at amp: Pair(text, position after it)
xmlDecodeReference(s : string, amp : int) -> Pair<string, int> {
	keepAmp = Pair("&", amp + 1);
	if (xmlCharCodeAt(s, amp + 1) == 0x23) { // #
		isHex = xmlCharCodeAt(s, amp + 2) == 0x78; // x
		digitsStart = amp + 2 + b2i(isHex);
		digitsEnd = xmlScanDigits(s, digitsStart, isHex);
		if (digitsEnd > digitsStart && xmlCharCodeAt(s, digitsEnd) == 0x3B) { // ;
			code = xmlReferenceCode(s, xmlSkipZeros(s, digitsStart, digitsEnd), digitsEnd, isHex);
			if (isXmlChar(code)) Pair(fromCharCode(code), digitsEnd + 1) else keepAmp;
		} else {
			keepAmp;
		}
	} else {
		eitherMap(
			find(xmlNamedEntities, \e -> strContainsAt(s, amp, e.first)),
			\e -> Pair(e.second, amp + strlen(e.first)),
			keepAmp
		);
	}
}

// The char code at i, or -1 past the end
xmlCharCodeAt(s : string, i : int) -> int {
	if (i < strlen(s)) getCharCodeAt(s, i) else -1;
}

// The index of the first char at or after i that is not a decimal (or hex) digit
xmlScanDigits(s : string, i : int, isHex : bool) -> int {
	c = xmlCharCodeAt(s, i);
	digit = (0x30 <= c && c <= 0x39) || (isHex && ((0x41 <= c && c <= 0x46) || (0x61 <= c && c <= 0x66)));
	if (digit) xmlScanDigits(s, i + 1, isHex) else i;
}

// The first digit in [i, end) that is not a leading zero; the last digit always counts
xmlSkipZeros(s : string, i : int, end : int) -> int {
	if (i + 1 < end && getCharCodeAt(s, i) == 0x30) xmlSkipZeros(s, i + 1, end) else i;
}

// The code the digits in [start, end) name, or -1 when they are more than any XML character needs
xmlReferenceCode(s : string, start : int, end : int, isHex : bool) -> int {
	digits = substring(s, start, end - start);
	if (strlen(digits) > (if (isHex) 6 else 7)) -1
	else if (isHex) parseHex(digits)
	else s2i(digits);
}

// The Char production of XML 1.0: no controls but tab, newline and return, no surrogates, no U+FFFE or U+FFFF
isXmlChar(code : int) -> bool {
	code == 0x9 || code == 0xA || code == 0xD
	|| (0x20 <= code && code <= 0xD7FF)
	|| (0xE000 <= code && code <= 0xFFFD)
	|| (0x10000 <= code && code <= 0x10FFFF);
}

// The Name production of XML 1.0: a NameStartChar, then any NameChars
isXmlName(s : string) -> bool {
	s != "" && isXmlNameFrom(s, 0);
}

isXmlNameFrom(s : string, i : int) -> bool {
	c = xmlCharCodeAt(s, i);
	if (c == -1) true
	else if (0xD800 <= c && c <= 0xDB7F) {
		// A surrogate pair: a char in [#x10000-#xEFFFF], which may start a name
		low = xmlCharCodeAt(s, i + 1);
		if (0xDC00 <= low && low <= 0xDFFF) isXmlNameFrom(s, i + 2) else false;
	} else if (isXmlNameStartChar(c) || (i > 0 && isXmlNameRestChar(c))) {
		isXmlNameFrom(s, i + 1);
	} else {
		false;
	}
}

isXmlNameStartChar(c : int) -> bool {
	c == 0x3A || (0x41 <= c && c <= 0x5A) || c == 0x5F || (0x61 <= c && c <= 0x7A)
	|| (0xC0 <= c && c <= 0xD6) || (0xD8 <= c && c <= 0xF6) || (0xF8 <= c && c <= 0x2FF)
	|| (0x370 <= c && c <= 0x37D) || (0x37F <= c && c <= 0x1FFF) || (0x200C <= c && c <= 0x200D)
	|| (0x2070 <= c && c <= 0x218F) || (0x2C00 <= c && c <= 0x2FEF) || (0x3001 <= c && c <= 0xD7FF)
	|| (0xF900 <= c && c <= 0xFDCF) || (0xFDF0 <= c && c <= 0xFFFD);
}

// NameChar without NameStartChar
isXmlNameRestChar(c : int) -> bool {
	c == 0x2D || c == 0x2E || (0x30 <= c && c <= 0x39) || c == 0xB7
	|| (0x300 <= c && c <= 0x36F) || (0x203F <= c && c <= 0x2040);
}


makeTextParser(parameters : [XmlParsingOption]) -> (string, DynamicBehaviour<XmlEvent>) -> void {
	flags : XmlParseLeadingSpaces = fold(parameters, XmlParseLeadingSpaces(false, false), \acc, p -> {
		switch (p : XmlParsingOption) {
			XmlParseLeadingSpaces(preserve, makeEventForSpaces): p;
			default: acc;
		}
	});

	unescape = {
		if (contains(parameters, StandardEscaping())) 
			xmlUnescape
		else
			idfn
	};

	if (flags.preserve && flags.makeEventForSpaces) {
		\s : string, events : DynamicBehaviour<XmlEvent> -> {
			// Get rid of all CRs
			s1 = strReplace(s, "\x0d", "");
			next(events, XmlTextEvent(unescape(s1)));
		}
	} else {
		\s, events -> {
			// Get rid of all CRs
			s1 = strReplace(s, "\x0d", "");
			s2 = ltrim2(s1, " \n\t");
			if (s2 != "") {
				next(events, XmlTextEvent(unescape(if (flags.preserve) s1 else s2)));
			} else {
				if (flags.makeEventForSpaces) {
					next(events, XmlTextEvent(unescape(s1)));
				}
			}
		}	
	}
}

// Function to find the proper end of an XML tag, accounting for attribute values that might contain angle brackets
// <span data-mathml="<span>data-mathml-internal-span</span>">
// quote is the quote of the attribute value open at i, or "" outside values. A value ends only at its
// own kind of quote, as parseAttributes reads it, so title="it's" ends at the second "
findTagEnd(s : string, i : int, quote : string) -> int {
	l = strlen(s);
	if (i >= l) {
		-1; // Base case - reached end of string without finding closing bracket
	} else {
		ch = getCharAt(s, i);

		// The character before is read only for a quote that opens or closes a value
		if ((ch == "\"" || ch == "'") && (quote == "" || ch == quote) && (i == 0 || getCharAt(s, i - 1) != "\\")) {
			// A quoted value starts or ends (if not escaped)
			findTagEnd(s, i + 1, if (quote == "") ch else "");
		} else if (ch == ">" && quote == "") {
			// Found the end of the tag, but only if not inside quotes
			i;
		} else {
			// Keep searching
			findTagEnd(s, i + 1, quote);
		}
	}
}

// After a '<' turns out to be text, every later '<' is tried as a tag, and their candidate
// tags overlap. This state keeps that from scanning the same input once per '<'.
XmlRecovery(
	mutable recovered : bool,
	// From the second recovery on, the tag end findTagEnd gives for each later '<', in input order.
	// Entries behind the scan are dropped, so this holds at most one per '<' still ahead.
	// One recovery alone does not need it, since only failed candidates are scanned twice.
	mutable tagEnds : Maybe<List<XmlTagEnd>>,
	// From the first recovery on, when validating: by the end of the range, the attribute positions
	// read by candidates that failed. Reading on from one of them in the same range fails the same way.
	// A candidate that parses moves the scan past its range, so its positions are never read again
	// and are not kept. Ranges that end behind the scan are dropped.
	mutable failedAttrs : Tree<int, Set<int>>
);

XmlTagEnd(lt : int, end : int);

// Walks i down to from, carrying where findTagEnd(s, i, quote) ends for each quote, and
// keeps the end for each '<' at i - 1.
cacheXmlTagEnds(s : string, i : int, from : int, outside : int, single : int, quoted : int, acc : List<XmlTagEnd>) -> List<XmlTagEnd> {
	if (i < from) acc
	else {
		c = xmlCharCodeAt(s, i);
		unescaped = i == 0 || getCharCodeAt(s, i - 1) != 0x5C; // \
		singleQuote = c == 0x27 && unescaped; // '
		doubleQuote = c == 0x22 && unescaped; // "
		o = if (singleQuote) single else if (doubleQuote) quoted else if (c == 0x3E) i else outside; // >
		cacheXmlTagEnds(s, i - 1, from, o,
			if (singleQuote) outside else single,
			if (doubleQuote) outside else quoted,
			if (i > 0 && getCharCodeAt(s, i - 1) == 0x3C) Cons(XmlTagEnd(i - 1, o), acc) else acc // <
		);
	}
}

// The '<' at start is text. The scan only moves on, so the cache covers the '<' characters after it.
recoverXml(s : string, start : int, rec : XmlRecovery) -> void {
	if (!rec.recovered) {
		rec.recovered ::= true;
	} else if (isNone(rec.tagEnds)) {
		rec.tagEnds ::= Some(cacheXmlTagEnds(s, strlen(s), start + 2, -1, -1, -1, makeList()));
	}
}

// findTagEnd(s, start + 1, "") for the '<' at start
xmlTagEnd(s : string, start : int, rec : XmlRecovery) -> int {
	switch (rec.tagEnds) {
		Some(tagEnds): xmlCachedTagEnd(s, tagEnds, start, rec);
		None(): findTagEnd(s, start + 1, "");
	}
}

// The cache has an entry for every '<' after it was made. Should start have none, its end is
// scanned for, rather than taken from the next '<'.
xmlCachedTagEnd(s : string, tagEnds : List<XmlTagEnd>, start : int, rec : XmlRecovery) -> int {
	switch (tagEnds) {
		Cons(e, rest): {
			if (e.lt < start) xmlCachedTagEnd(s, rest, start, rec)
			else if (e.lt == start) {
				rec.tagEnds ::= Some(rest);
				e.end;
			} else {
				rec.tagEnds ::= Some(tagEnds);
				findTagEnd(s, start + 1, "");
			}
		}
		EmptyList(): {
			rec.tagEnds ::= Some(tagEnds);
			findTagEnd(s, start + 1, "");
		}
	}
}

// Drops the failed attribute positions of ranges that end before start
xmlDropFailedAttrs(rec : XmlRecovery, start : int) -> void {
	switch (popmin(rec.failedAttrs)) {
		PopResult(end, __, rest): if (end < start) {
			rec.failedAttrs ::= rest;
			xmlDropFailedAttrs(rec, start);
		}
		EmptyPopResult(): {}
	}
}

doParseXml(s : string, events : DynamicBehaviour<XmlEvent>, parseText : (string, DynamicBehaviour<XmlEvent>) -> void, validateNames : bool) -> void {
	doParseXmlFrom(s, 0, events, parseText, validateNames, XmlRecovery(false, None(), makeTree()));
}

doParseXmlFrom(
	s : string, start : int, events : DynamicBehaviour<XmlEvent>, parseText : (string, DynamicBehaviour<XmlEvent>) -> void,
	validateNames : bool, rec : XmlRecovery
) -> void {
	l = strlen(s);
	tagStart = strRangeIndexOf(s, "<", start, l);
	if (tagStart == -1) {
		// OK, the rest is just text
		if (start < l) {
			parseText(substring(s, start, l - start), events);
		}
		// Signal the end!
		next(events, XmlEndEvent());
	} else if (tagStart == start) {
		// We have a tag or comment!
		// A comment or CDATA section that is never closed takes the rest of the input, except <!--> and <!--->
		// A <!--> or <!---> with no --> after it cannot be followed by another, since each holds a -->
		if (strContainsAt(s, start, "<!--")) {
			endComment = strRangeIndexOf(s, "-->", start + 4, l);
			if (endComment == -1) {
				if (strContainsAt(s, start, "<!-->") || strContainsAt(s, start, "<!--->")) {
					// With no --> at all, <!--> and <!---> are an empty comment, as in HTML5
					next(events, XmlCommentEvent(""));
					doParseXmlFrom(s, start + (if (strContainsAt(s, start, "<!-->")) 5 else 6), events, parseText, validateNames, rec);
				} else {
					next(events, XmlCommentEvent(strRight(s, start + 4)));
					next(events, XmlEndEvent());
				}
			} else {
				next(events, XmlCommentEvent(substring(s, start + 4, endComment - start - 4)));
				doParseXmlFrom(s, endComment + 3, events, parseText, validateNames, rec);
			}
		} else if (strContainsAt(s, start, "<![CDATA[")) {
			endComment = strRangeIndexOf(s, "]]>", start + 9, l);
			if (endComment == -1) {
				next(events, XmlTextEvent(strRight(s, start + 9)));
				next(events, XmlEndEvent());
			} else {
				next(events, XmlTextEvent(substring(s, start + 9, endComment - start - 9)));
				doParseXmlFrom(s, endComment + 3, events, parseText, validateNames, rec);
			}
		} else {
			// It's a tag
			endTag = xmlTagEnd(s, start, rec);
			event = if (endTag == -1) None() else parseTag(s, start, endTag, validateNames, rec);
			switch (event) {
				Some(e): {
					// Everything looks good, so send that and do the rest
					next(events, e);
					doParseXmlFrom(s, endTag + 1, events, parseText, validateNames, rec);
				}
				None(): {
					// No end, or names that are not valid: treat the '<' as text
					parseText("<", events);
					recoverXml(s, start, rec);
					doParseXmlFrom(s, start + 1, events, parseText, validateNames, rec);
				}
			}
		}
	} else {
		// Before the tag, there is some text
		parseText(substring(s, start, tagStart - start), events);
		// Recursively handle the rest
		doParseXmlFrom(s, tagStart, events, parseText, validateNames, rec);
	}
};

// http://www.w3.org/TR/xml/#NT-NameStartChar
// A tag has to start with one of these:
// ":" | [A-Z] | "_" | [a-z] | [#xC0-#xD6] | [#xD8-#xF6] | [#xF8-#x2FF]
//   | [#x370-#x37D] | [#x37F-#x1FFF] | [#x200C-#x200D] | [#x2070-#x218F]
//   | [#x2C00-#x2FEF] | [#x3001-#xD7FF] | [#xF900-#xFDCF] | [#xFDF0-#xFFFD] | [#x10000-#xEFFFF]
// and the rest can also be be one of these:
// "-" | "." | [0-9] | #xB7 | [#x0300-#x036F] | [#x203F-#x2040]

// We approximate, and say anything from 0xc0 is valid, as are the letters below it.
isValidXmlName(t : string) -> bool {
	t != "" && isXmlNameStartChar(getCharCodeAt(t, 0)) && isRestAValidName(t, 1);
}

isRestAValidName(t : string, i : int) -> bool {
	if (i >= strlen(t)) true
	else isXmlNameChar(getCharCodeAt(t, i)) && isRestAValidName(t, i + 1);
}

isXmlNameStartChar(c : int) -> bool {
	(0x61 <= c && c <= 0x7A) || (0x41 <= c && c <= 0x5A) || c == 0x3A || c == 0x5F || c >= 0xC0 // a-z A-Z : _
	|| (c >= 0x80 && isLetter(fromCharCode(c)));
}

isXmlNameChar(c : int) -> bool {
	isXmlNameStartChar(c) || (0x30 <= c && c <= 0x39) || c == 0x2D || c == 0x2E; // 0-9 - .
}

parseXmlWithStrategy(s, events, strategy) {
	doParseXml(s, events, makeTextParser(strategy), contains(strategy, XmlValidateNames()))
}


parseXml(s, events) {
	parseXmlWithStrategy(s, events, [])
}

// The tag in s[start, end], from its '<' to its '>'. When validating, None for a tag or attribute
// name that is not valid. It reads s in place: copying a long candidate for each '<' on recovery
// would make the scan quadratic.
parseTag(s : string, start : int, end : int, validate : bool, rec : XmlRecovery) -> Maybe<XmlTagEvent> {
	// The length between < and >
	ul = end - start - 1;
	if (ul == 0) {
		if (validate) None() else Some(XmlElementStart("", []));
	} else {
		firstchar = getCharAt(s, start + 1);
		lastchar = getCharAt(s, end - 1);

		// "</" ... ">" ?
		endTag = (firstchar == "/");

		// "<" ... "/>"  ?
		emptyElement = (lastchar == "/");

		// "<?" ... "?>" ?
		processing = (firstchar == "?" && lastchar == "?");

		// The body. "</a/>" keeps its last /, and "<?>" has none
		skip = b2i(endTag || processing);
		bodyLength = ul - b2i(emptyElement || processing) - b2i(processing);
		bodyStart = start + 1 + skip;
		bodyEnd = if (bodyLength < 1 || skip >= ul) bodyStart else start + 1 + min(ul, skip + bodyLength);

		// Separate tag from attributes at the first space
		sep = xmlTagNameEnd(s, bodyStart, bodyEnd, validate);
		if (sep == -1) None()
		else {
			tag = if (sep == bodyEnd) substring(s, bodyStart, bodyEnd - bodyStart) else xmlTrimmedTagName(s, bodyStart, bodyEnd, sep);
			if (validate && !isValidXmlName(tag)) None()
			else if (endTag && !emptyElement) Some(XmlElementEnd(tag))
			else {
				attrs = if (sep == bodyEnd) Some(makeList())
				else if (validate && rec.recovered) {
					// The scan only moves on, so no later candidate ends before start
					xmlDropFailedAttrs(rec, start);
					failed = lookupTreeDef(rec.failedAttrs, bodyEnd, makeSet());
					xmlAttributes(XmlAttrRange(s, bodyEnd, validate, Some(failed), rec), sep + 1, makeList(), makeList());
				} else xmlAttributes(XmlAttrRange(s, bodyEnd, validate, None(), rec), sep + 1, makeList(), makeList());
				maybeMap(attrs, \as -> {
					a = list2array(as);
					if (emptyElement) XmlEmptyElement(tag, a)
					else if (processing) XmlProcessingEvent(tag, a)
					else XmlElementStart(tag, a);
				});
			}
		}
	}
}

// The first space in s[i, end), or end. When validating, -1 at a character no name can have, other
// than one the trims in parseTag may take. isValidXmlName still checks the trimmed name.
xmlTagNameEnd(s : string, i : int, end : int, validate : bool) -> int {
	if (i >= end) end
	else {
		c = getCharCodeAt(s, i);
		if (isXmlSpace(c)) i
		else if (validate && !isXmlTrimSpace(c) && !isXmlNameChar(c)) -1
		else xmlTagNameEnd(s, i + 1, end, validate);
	}
}

// The tag name when the body s[bodyStart, bodyEnd) has a space at sep:
// trim2(strLeft(trim(body), sep - bodyStart), " \x0d\n\t"), where trim takes spaces and U+00A0
xmlTrimmedTagName(s : string, bodyStart : int, bodyEnd : int, sep : int) -> string {
	from = xmlSkipSpaces(s, bodyStart, bodyEnd);
	if (from >= bodyEnd) ""
	else {
		w = min(from + sep - bodyStart, bodyEnd);
		to = if (xmlSkipSpaces(s, w, bodyEnd) == bodyEnd) xmlBackSpaces(s, w, from) else w;
		trim2(substring(s, from, to - from), " \x0d\n\t");
	}
}

isXmlSpace(c : int) -> bool {
	c == 0x20 || c == 0x09 || c == 0x0A || c == 0x0D;
}

// What trim, ltrim and rtrim take: space and U+00A0
isXmlTrimSpace(c : int) -> bool {
	c == 0x20 || c == 0xA0;
}

// The first index in [i, end) that ltrim would keep, or end
xmlSkipSpaces(s : string, i : int, end : int) -> int {
	if (i < end && isXmlTrimSpace(getCharCodeAt(s, i))) xmlSkipSpaces(s, i + 1, end) else i;
}

// e, less what rtrim would take just before it, but not below from
xmlBackSpaces(s : string, e : int, from : int) -> int {
	if (e > from && isXmlTrimSpace(getCharCodeAt(s, e - 1))) xmlBackSpaces(s, e - 1, from) else e;
}

// The attributes of a tag are read from s up to end. With failed, the positions read by earlier
// candidates that failed in this range: reading on from one fails, and a walk that fails adds its own.
XmlAttrRange(s : string, end : int, validate : bool, failed : Maybe<Set<int>>, rec : XmlRecovery);

// The attributes in s[i, end), reversed onto acc. When validating, None for a name that is not valid.
// read has the positions read so far, when failed is given.
xmlAttributes(r : XmlAttrRange, i : int, read : List<int>, acc : List<XmlAttribute>) -> Maybe<List<XmlAttribute>> {
	s = r.s;
	end = r.end;
	if (i >= end) {
		Some(acc);
	} else if (isXmlSpace(getCharCodeAt(s, i))) {
		// Whitespace to be eaten first
		xmlAttributes(r, i + 1, read, acc);
	} else if (eitherMap(r.failed, \f -> containsSet(f, i), false)) {
		// An earlier candidate failed from here in the same range
		xmlAttributesFailed(r, read);
	} else {
		// The name runs to the first = or space
		j = xmlNameStop(s, i, end);
		name = substring(s, i, j - i);
		read2 = if (isSome(r.failed)) Cons(i, read) else read;
		if (r.validate && !isValidXmlName(name)) {
			xmlAttributesFailed(r, read2);
		} else if (j == end) {
			// "abc"
			Some(Cons(XmlAttribute(name, ""), acc));
		} else if (getCharCodeAt(s, j) != 0x3D || (j + 1 < end && isXmlSpace(getCharCodeAt(s, j + 1)))) { // =
			// "abcd rest=something" or "abc= rest=something"
			xmlAttributes(r, j + 1 + b2i(getCharCodeAt(s, j) == 0x3D), read2, Cons(XmlAttribute(name, ""), acc));
		} else {
			// "abc=def something"
			v = j + 1;
			q = if (v < end) getCharCodeAt(s, v) else -1;
			if (q == 0x22 || q == 0x27) { // " '
				quote = fromCharCode(q);
				endQuote = xmlEndQuote(s, v + 1, end, quote);
				if (endQuote == -1) {
					// Missing end quote, so we take the lot
					Some(Cons(XmlAttribute(name, substring(s, v, end - v)), acc));
				} else {
					value = strReplace(substring(s, v + 1, endQuote - v - 1), "\\" + quote, quote) |> xmlUnescape;
					xmlAttributes(r, endQuote + 1, read2, Cons(XmlAttribute(name, value), acc));
				}
			} else {
				// Unquoted
				nextSpace = xmlValueStop(s, v, end);
				value = substring(s, v, nextSpace - v);
				if (nextSpace == end) {
					// No more stuff, so we take the lot
					Some(Cons(XmlAttribute(name, value), acc));
				} else {
					xmlAttributes(r, nextSpace + 1, read2, Cons(XmlAttribute(name, value), acc));
				}
			}
		}
	}
}

// The candidate fails: keep the positions it read, for the candidates after it in the same range
xmlAttributesFailed(r : XmlAttrRange, read : List<int>) -> Maybe<List<XmlAttribute>> {
	switch (r.failed) {
		Some(failed): {
			rec = r.rec;
			rec.failedAttrs ::= setTree(rec.failedAttrs, r.end, foldList(read, failed, insertSet));
		}
		None(): {}
	}
	None();
}

// The first = or space in s[i, end), or end
xmlNameStop(s : string, i : int, end : int) -> int {
	if (i < end && getCharCodeAt(s, i) != 0x3D && !isXmlSpace(getCharCodeAt(s, i))) xmlNameStop(s, i + 1, end) else i;
}

// The first space, newline or return in s[i, end), or end. A tab does not end an unquoted value.
xmlValueStop(s : string, i : int, end : int) -> int {
	if (i < end && getCharCodeAt(s, i) != 0x20 && getCharCodeAt(s, i) != 0x0A && getCharCodeAt(s, i) != 0x0D) xmlValueStop(s, i + 1, end) else i;
}

// The first quote in s[i, end) without a backslash just before it in that range, or -1.
// It ignores single escaped quotes (qwe\"asd"), but gives the wrong answer with multiple escapes (qwe\\"asd")
xmlEndQuote(s : string, i : int, end : int, quote : string) -> int {
	q = strRangeIndexOf(s, quote, i, end);
	if (q > i && getCharCodeAt(s, q - 1) == 0x5C) xmlEndQuote(s, q + 1, end, quote) else q;
}

parseXml2WithStrategy(xml : string, strategy : [XmlParsingOption]) -> XmlNode {
	// Collect all events
	events : DynamicBehaviour<XmlEvent> = make(XmlEndEvent());
	list = ref makeList();
	us = subscribe2(events, \e -> {
		if (e != XmlEndEvent()) {
			list := Cons(e, ^list);
		}
	});
	parseXmlWithStrategy(xml, events, strategy);
	us();
	tokens = list2array(^list);

	keepComments = contains(strategy, XmlKeepComments());

	result1 = buildXml(tokens, 0, keepComments);
	result2 = stripXmlComments([result1.first]);
	if (result1.second < length(tokens) - 1) {
		// println("Did not convert all of it!" + i2s(result.second) + "/" + i2s(length(tokens)));
	}
	result2[0];
}

parseXml2(xml : string) -> XmlNode {
	parseXml2WithStrategy(xml, [])
}

parseNextXmlGroup(i : int, tokens : [XmlEvent], result : ref [XmlNode2], keepComments : bool) -> void {
	if (length(tokens) > i) {
		tempXml = buildXml(tokens, i, keepComments);
		refArrayPush(result, tempXml.first);
		parseNextXmlGroup(tempXml.second, tokens, result, keepComments);
		{};
	}
}

parseXml3WithStrategy(xml : string, strategy : [XmlParsingOption]) -> [XmlNode2] {
	// Collect all events
	events : DynamicBehaviour<XmlEvent> = make(XmlEndEvent());
	list = ref makeList();
	us = subscribe2(events, \e -> {
		if (e != XmlEndEvent()) {
			list := Cons(e, ^list);
		}
	});
	parseXmlWithStrategy(xml, events, strategy);
	us();
	tokens = list2array(^list);

	keepComments = contains(strategy, XmlKeepComments());
	result = ref [];
	parseNextXmlGroup(0, tokens, result, keepComments);
	^result;
}

parseXml3(xml : string) -> [XmlNode] {
	stripXmlComments(parseXml3WithStrategy(xml, []))
}

stripXmlComments(xml : [XmlNode2]) -> [XmlNode] {
	fold(xml, makeList(), \acc : List<XmlNode>, c -> {
		switch (c : XmlNode2) {
			XmlElement2(tag, atts, children): {
				Cons(XmlElement(tag, atts, stripXmlComments(children)), acc)
			}
			XmlText(t): Cons(c, acc);
			XmlComment(t): acc;
		}
	}) |> list2array;
}

buildXml(tokens : [XmlEvent], index : int, keepComments : bool) -> Pair<XmlNode2, int> {
	if (index >= length(tokens)) {
		// Something is wrong
		Pair(XmlText(""), index);
	} else {
		token = tokens[index];
		switch (token : XmlEvent) {
			XmlEmptyElement(tag, attributes): { 
				xe : XmlNode2 = XmlElement2(tag, attributes, []); 
				Pair(xe, index + 1);
			}
			XmlElementStart(tag, attributes): {
				childrenList = ref makeList();
				nextPos = buildUntilEndTag(tokens, index + 1, tag, keepComments, childrenList);
				// Here, we could get rid of white-space only elements are the start and end of the children

				Pair(XmlElement2(tag, attributes, list2array(^childrenList)), nextPos);
			}
			XmlElementEnd(tag): {
				// Hm, not supposed to happen - skip ahead
				buildXml(tokens, index + 1, keepComments);
			}
			XmlTextEvent(text):
				if (index + 1 == length(tokens)) {
					// This is all we have, so that is it
					Pair(XmlText(text), index + 1);
				} else {
					// Skip ahead!
					r = buildXml(tokens, index + 1, keepComments);
					n = switch (r.first : XmlNode2) {
						XmlText(t): XmlText(text + t);
						XmlElement2(tag, attributes, children): {
							nws = trim2(text, " \n");
							if (nws != "") {
								//println("Xml parsing failed: Ignoring text: '" + text + "'");
							}
							r.first;
						}
						XmlComment(t): r.first;
					}
					Pair(n, r.second);
				}
			XmlEndEvent(): // Not supposed to happen
				Pair(XmlText(""), index + 1);
			XmlCommentEvent(c): {
				if (keepComments) {
					Pair(XmlComment(c), index + 1);
				} else {
					// Skip ahead
					buildXml(tokens, index + 1, keepComments);
				}
			}
			XmlProcessingEvent(c, a):
				buildXml(tokens, index + 1, keepComments);
		}
	}
}

// returns position to continue parsing from
buildUntilEndTag(tokens : [XmlEvent], index : int, endtag : string, keepComments : bool, resultNodes : ref List<XmlNode2>) -> int {
	if (index >= length(tokens)) {
		index;
	} else {
		token = tokens[index];
		switch (token : XmlEvent) {
			XmlElementEnd(tag): {
				if (tag == endtag) {
					index + 1;
				} else {
					// Not supposed to happen.

					// Let's see if it comes shortly
					e = min(index + 200, length(tokens));
					c = countUntil(index + 1, e, \i -> {
						switch (tokens[i] : XmlEvent) {
							XmlElementEnd(t): t == endtag;
							// To make this more robust against things like
							// <p> <br>  <br>   <br/>
							// we should look for starts and empty elements
							// here as well
							//XmlElementStart(t, att): t == endtag;
							//XmlEmptyElement(t, att): t == endtag;
							default: false;
						}
					});
					if (c == e) {
						// The end tag never comes, so let's just pretend it was here
						// println("Expected </" + endtag + "> but got <" + tag + ">");
						index;
					} else {
						// OK, we judge it to be a stray element and just ignore it
						// println("Ignoring <" + tag + ">");
						buildUntilEndTag(tokens, index + 1, endtag, keepComments, resultNodes);
					}
				}
			}
			XmlEndEvent(): {
				index + 1;
			}
			XmlCommentEvent(c): {
				if (keepComments) {
					head = XmlComment(c);
					resultNodes := Cons(head, ^resultNodes);
					buildUntilEndTag(tokens, index + 1, endtag, keepComments, resultNodes);
				} else {
					// Ignore this guy and proceed
					buildUntilEndTag(tokens, index + 1, endtag, keepComments, resultNodes);
				}
			}
			XmlProcessingEvent(c, a): // Ignore this guy and proceed
				buildUntilEndTag(tokens, index + 1, endtag, keepComments, resultNodes);
			XmlTextEvent(text): {
				head = XmlText(text);
				resultNodes := Cons(head, ^resultNodes);
				buildUntilEndTag(tokens, index + 1, endtag, keepComments, resultNodes);
			}
			default: {
				head = buildXml(tokens, index, keepComments);
				resultNodes := Cons(head.first, ^resultNodes);
				buildUntilEndTag(tokens, head.second, endtag, keepComments, resultNodes);
			}
		}
	}
}

getXmlChildren(xml : XmlNode) -> [XmlNode] {
	switch (xml : XmlNode) {
		XmlElement(tag, attributes, children): children;
		XmlText(t): [];
	}
}

getXmlChildren2(xml : XmlNode2) -> [XmlNode2] {
	switch (xml : XmlNode2) {
		XmlElement2(tag, attributes, children): children;
		XmlText(t): [];
		XmlComment(t): [];
	}
}

getXmlNodeById(nodes : [XmlNode], filterId : string) -> Maybe<XmlElement> {
	findmap(nodes, \node -> {
		switch(node : XmlNode) {
			XmlElement(tag, attributes, children): {
				id = getXmlAttribute(attributes, "id", "");
				if (id == filterId) {
					Some(node);
				} else {
					getXmlNodeById(children, filterId);
				};
			};
			XmlText(t): None();		
		}
	})
}

getXmlNode2ById(nodes : [XmlNode2], filterId : string) -> Maybe<XmlElement2> {
	findmap(nodes, \node -> {
		switch(node : XmlNode2) {
			XmlElement2(tag, attributes, children): {
				id = getXmlAttribute(attributes, "id", "");
				if (id == filterId) {
					Some(node)
				} else {
					getXmlNode2ById(children, filterId)
				};
			};
			XmlText(t): None();
			XmlComment(t): None();			
		}
	})
}

getXmlAttributes(xml : XmlNode) -> [XmlAttribute] {
	switch (xml : XmlNode) {
		XmlElement(tag, attributes, children): attributes;
		XmlText(t): [];
	}
}

getXmlAttribute(attrs, att, def) {
	attLocase = toLowerCase(att);
	switch (find(attrs, \xa -> toLowerCase(xa.key) == attLocase)) {
		None(): def;
		Some(attr): attr.value;
	}
}

getXmlAttributeM(attrs, att) {
	maybeMap(find(attrs, \xa -> xa.key == att), \a -> a.value)
}

getXmlAttr(attributes: [XmlAttribute], attr: string) -> string {
	getXmlAttribute(attributes, attr, "")
}

filterElements(children : [XmlNode], filterstr : string) -> [XmlElement] {
	wofilter = (filterstr == "");
	onlyElems = filter(children, \c -> switch (c : XmlNode) {
		XmlElement(tag,__,__): (wofilter || filterstr == toLowerCase(tag));
		default: false;
	});

	map(onlyElems, \c -> cast(c : XmlNode -> XmlElement))
}

filterElementsByTag(elements : [XmlNode2], tagFilter : string) -> [XmlElement2] {
	fold(elements, [], \acc, element -> {
		switch(element : XmlNode2) {
			XmlElement2(tag, attributes, children): {
				if (toLowerCase(tagFilter) == toLowerCase(tag)) {
					arrayPush(acc, element);
				} else {
					concat(acc, filterElementsByTag(children, tagFilter));
				};
			};
			XmlComment(text): acc;
			XmlText(text): acc;
		}
	})
}

getXmlElement(xmlroots: [XmlElement], tag: string) -> Maybe<XmlElement> {
	rl = length(xmlroots);
	if (rl == 1) {
		if (toLowerCase(xmlroots[0].tag) == tag)
			Some(xmlroots[0])
		else
			getXmlElement(xmlElements(xmlroots[0].children), tag)
	} else if (rl == 0) {
		None()
	} else {
		r0 = getXmlElement([xmlroots[0]], tag);
		if (r0 != None()) r0 else getXmlElement(subrange(xmlroots, 1, rl-1), tag);
	}
}

getXmlTagElements(xml : XmlNode, tag : string) -> [XmlElement] {
	filterElements(getXmlChildren(xml), tag);
}

getTopLevelElement(xmlroots: [XmlNode2], tag: string) -> Maybe<XmlElement2> {
	getTopLevelElementExt(xmlroots, tag, 0, Pair(None(), -1)).first
}

getTopLevelElementExt(xmlroots: [XmlNode2], tag: string, currendDeepness : int, initPair : Pair<Maybe<XmlElement2>, int>) -> Pair<Maybe<XmlElement2>, int> {
	fold(
		xmlroots,
		initPair,
		\acc, n -> if (acc.second == -1 || currendDeepness < acc.second) {
			switch (n : XmlNode2) {
				XmlElement2(xtag, attr, ch): {
					if (toLowerCase(xtag) == toLowerCase(tag)) {
						Pair(Some(n), currendDeepness)
					} else if (acc.second == -1 || currendDeepness + 1 < acc.second) {
						getTopLevelElementExt(ch, tag, currendDeepness + 1, acc)
					} else {
						acc
					}
				}
				XmlText(t): acc;
				XmlComment(t): acc;
			}
		} else {
			acc
		}
	)
}

getXmlElement2(xmlroots: [XmlNode2], tag: string) -> Maybe<XmlElement2> {
	fold(xmlroots, None(), \acc, n -> {
		if (acc == None()) {
			switch (n : XmlNode2) {
				XmlElement2(xtag, attr, ch): {
					if (toLowerCase(xtag) == toLowerCase(tag)) {
						Some(n)
					} else {
						rec = getXmlElement2(ch, tag);
						switch (rec) {
							None(): acc;
							Some(v): rec;
						}
					}
				}
				XmlText(t): acc;
				XmlComment(t): acc;
			}
		} else acc;
	});
}

getFirstXmlTextContents(children : [XmlNode]) -> string {
	if (length(children) > 0) {
		switch (children[0] : XmlNode) {
			XmlText(s): s;
			XmlElement(tag, attributes, children2): {
				getFirstXmlTextContents(children2);
			}
		}
	} else ""
}

poorXml2text(xml : XmlNode) -> string {
	switch (xml) {
		XmlElement(tag, attributes, children): {
			atts = fold(attributes, "", \acc, a -> 
				acc + " " + a.key + "=\"" + a.value + "\""
			);
			// fold(children, "<" + tag + atts + ">", \acc, c -> acc + poorXml2text(c)) + "</" + tag + ">";
			("<" + tag + atts + ">") + concatStrings(map(children, \c -> poorXml2text(c))) + ("</" + tag + ">");
		}
		XmlText(text): {
			text;
		}
	}
}

xml2string(xml : XmlNode) -> string {
	switch (xml) {
		XmlElement(tag, attributes, children): {
			content = concatStrings(map(children, \c -> xml2string(c)));
			doctype = isXmlDoctypeTag(tag);
			if (doctype || isXmlName(tag)) {
				("<" + tag + xmlAttributes2string(attributes, !doctype) + ">") + content + ("</" + tag + ">");
			} else {
				content;
			}
		}
		XmlText(text): {
			xmlEscapeText(text);
		}
	}
}

// The element the parser makes of <!DOCTYPE ...>, in the case it was written in
isXmlDoctypeTag(tag : string) -> bool {
	toLowerCase(tag) == "!doctype";
}

// Each attribute as ` key="value"`. With checkNames, those whose key is not a valid XML name are left out
xmlAttributes2string(attributes : [XmlAttribute], checkNames : bool) -> string {
	fold(attributes, "", \acc, a ->
		if (!checkNames || isXmlName(a.key)) acc + " " + a.key + "=\"" + xmlEscape(a.value) + "\"" else acc
	);
}

xmlNode2String(xhml : XmlNode2) -> string {
	switch(xhml) {
		XmlElement2(tag, attributes, children): {
				content = concatStrings(map(children, xmlNode2String));
				doctype = isXmlDoctypeTag(tag);
				if (doctype || isXmlName(tag)) {
					("<" + tag + xmlAttributes2string(attributes, !doctype) + ">")
					+ content
					+ ("</" + tag + ">");
				} else {
					content;
				}
		};
		XmlText(text): {
			xmlEscapeText(text);
		};
		XmlComment(comment): {
			""
		};
	};
}

xml2text(xml : XmlNode) -> string {
	switch (xml) {
		XmlElement(tag, attributes, children): {
			concatStrings(map(children, \c -> xml2text(c)))
		}
		XmlText(text): {
			text;
		}
	}
}

nodeSourceStartsWithSpace(xml : XmlNode) -> bool {
	switch (xml) {
		XmlElement(__, __, __) : false; //Source starts with "<""
		XmlText(text) : {
			strlen(text) > 0 && !isNotSpace(strLeft(text, 1));
		}
	}
}
nodeSourceEndsWithSpace(xml : XmlNode) -> bool {
	switch (xml) {
		XmlElement(__, __, __) : false; //Source starts with "<""
		XmlText(text) : {
			strlen(text) > 0 && !isNotSpace(strsubsmart(text, -1, 0));
		}
	}
}

getXmlText(nodes: [XmlNode2]) -> string {
	getXmlText0(nodes, "");
}

getXmlText0(nodes: [XmlNode2], acc: string) -> string {
	fold(nodes, acc, \textAcc, node -> {
		switch(node: XmlNode2) {
			XmlComment(text): textAcc;
			XmlElement2(tag, attributes, children): getXmlText0(children, textAcc);
			XmlText(text): textAcc + text;
		}
	})
}

getShorterText(nodes: [XmlNode2]) -> string {
	ellipsis(getXmlText(nodes), 100);
}
