import string;

export {
	// mml abbrevation means MathML - math markup language

	// returns header to be inserted into the heading of html generated
	mmlHeader () -> string;

	// encloses expression into the tag
	// The number, identifier, operator and text builders escape < > and & in their argument,
	// but keep a character reference such as &#x3B1; or &lt; as written.
	// makeMmlFenced escapes left and right the same way, and " too.
	// The other arguments are MathML markup and are not escaped.
	makeMmlExpression(expression : string) -> string;
	makeMmlNumber(number : string) -> string;
	makeMmlIdentifier(identifier : string) -> string;
	makeMmlOperator(operator : string) -> string;
	makeMmlText(text : string) -> string;
	makeMmlRow(text : string) -> string;
	makeMmlFrac(enumerator : string, denumerator : string) -> string;
	makeMmlSqrt(body : string) -> string;
	makeMmlRoot(degree : string, body : string) -> string;
	makeMmlOverscript(body : string, script : string) -> string;
	makeMmlUnderscript(body : string, script : string) -> string;
	makeMmlSubscript(body : string, script : string) -> string;
	makeMmlSuperscript(body : string, script : string) -> string;
	makeMmlDefineteControl(sign : string, to : string, from : string, body : string) -> string;
	makeMmlFenced(left : string, right : string, body : string) -> string;



	MathMlType ::= MathMlOperator, MathMlNumber, MathMlIdentifier, MathMlText;
		MathMlOperator : ();
		MathMlIdentifier : ();
		MathMlNumber : ();
		MathMlText : ();

	getMmlRepresentation(text : string, type : MathMlType) -> string;
}

mmlHeader() {
	// MathJax checks if browser supports MathMl and converts source to Html+Css if necessary
	// cdn.mathjax.org was retired in 2017: https://www.mathjax.org/cdn-shutting-down/
	"<script type=\"text/javascript\" src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.9/MathJax.js?config=TeX-AMS-MML_HTMLorMML\"></script>"
}

makeMmlExpression(expression) {
	ot = "<math xmlns=\"http://www.w3.org/1998/Math/MathML\">";
	ct = "</math>";
	ot + expression + ct
}

makeMmlNumber(number) {
	"<mn>" + escapeMmlText(number) + "</mn>"
}

makeMmlIdentifier(identifier) {
	"<mi>" + escapeMmlText(identifier) + "</mi>"
}

makeMmlOperator(operator) {
	"<mo>" + escapeMmlText(operator) + "</mo>"
}

makeMmlText(text) {
	"<mtext>" + escapeMmlText(text) + "</mtext>"
}

makeMmlRow(text) {
	"<mrow>" + text + "</mrow>"
}

makeMmlFrac(e, d) {
	"<mfrac>" + e + d + "</mfrac>"
}

makeMmlRoot(d, b) {
	"<mroot>" + b +  d + "</mroot>"
}

makeMmlSqrt(b) {
	"<msqrt>" + b + "</msqrt>"
}

makeMmlOverscript(body, script) {
	"<mover>" + body + script + "</mover>"
}
makeMmlUnderscript(body, script) {
	"<munder>" + body + script + "</munder>"
}

makeMmlSubscript(body, script) {
	"<msub>" + body + script + "</msub>"
}
makeMmlSuperscript(body, script) {
	"<msup>" + body + script + "</msup>"
}

makeMmlDefineteControl(signt, to, from, body) {
	("<munderover>" + signt + from + to + "</munderover>" + body)
	|> makeMmlRow
}

makeMmlFenced(ob, cb, body) {
	"<mfenced" + " open=\"" + escapeMmlAttribute(ob) + "\"" + " close=\"" + escapeMmlAttribute(cb) + "\"" + ">" + body + "</mfenced>"
}

getMmlRepresentation(text, type) {
	text |> switch(type : MathMlType) {
		MathMlIdentifier() : makeMmlIdentifier;
		MathMlOperator() : makeMmlOperator;
		MathMlText() : makeMmlText;
		MathMlNumber() : makeMmlNumber;
	}
}

escapeMmlText(s : string) -> string {
	escapeMmlAmpersands(strReplace(strReplace(s, "<", "&lt;"), ">", "&gt;"));
}

escapeMmlAttribute(s : string) -> string {
	strReplace(escapeMmlText(s), "\"", "&quot;");
}

// Each & that does not start a reference becomes &amp;
escapeMmlAmpersands(s : string) -> string {
	if (strIndexOf(s, "&") < 0) s
	else list2string(escapeMmlAmpersandsFrom(s, 0, makeList()));
}

escapeMmlAmpersandsFrom(s : string, start : int, acc : List<string>) -> List<string> {
	amp = strRangeIndexOf(s, "&", start, strlen(s));
	if (amp < 0) {
		Cons(strRight(s, start), acc);
	} else {
		upToAmp = substring(s, start, amp + 1 - start);
		escaped = if (isMmlReferenceAt(s, amp)) upToAmp else upToAmp + "amp;";
		escapeMmlAmpersandsFrom(s, amp + 1, Cons(escaped, acc));
	}
}

// Whether the & at amp starts &name; &#digits; or &#xhex;
isMmlReferenceAt(s : string, amp : int) -> bool {
	if (mmlCodeAt(s, amp + 1) == 0x23) { // #
		x = mmlCodeAt(s, amp + 2);
		isHex = x == 0x78 || x == 0x58; // x X
		digitsStart = if (isHex) amp + 3 else amp + 2;
		digitsEnd = mmlSkip(s, digitsStart, if (isHex) isMmlHexDigit else isMmlDigit);
		digitsEnd > digitsStart && mmlCodeAt(s, digitsEnd) == 0x3B; // ;
	} else {
		nameEnd = mmlSkip(s, amp + 1, \c -> isMmlLetter(c) || isMmlDigit(c));
		isMmlLetter(mmlCodeAt(s, amp + 1)) && mmlCodeAt(s, nameEnd) == 0x3B;
	}
}

// The char code at i, or -1 past the end
mmlCodeAt(s : string, i : int) -> int {
	if (i < strlen(s)) getCharCodeAt(s, i) else -1;
}

// The index of the first char at or after i that fails ok
mmlSkip(s : string, i : int, ok : (int) -> bool) -> int {
	if (ok(mmlCodeAt(s, i))) mmlSkip(s, i + 1, ok) else i;
}

isMmlDigit(c : int) -> bool {
	0x30 <= c && c <= 0x39;
}

isMmlHexDigit(c : int) -> bool {
	isMmlDigit(c) || (0x41 <= c && c <= 0x46) || (0x61 <= c && c <= 0x66);
}

isMmlLetter(c : int) -> bool {
	(0x41 <= c && c <= 0x5A) || (0x61 <= c && c <= 0x7A);
}
