import formats/json/json_pegop;
import lingo/pegcode/parsic;
import lingo/pegaction;

export {
	// Returns None if the whole input does not match Flow's JSON grammar. The grammar
	// accepts extensions, including raw control characters in strings, \x and \X escapes,
	// and numbers such as 01 and 5. A Some result does not establish strict JSON validity.
	parseJsonSafer(json : string) -> Maybe<Json>;
}

parseJsonSafer(json : string) -> Maybe<Json> {
	parsed = parsic3(pegOps4Json, json, defaultPegActions, JsonNull());
	if (parsed.third == "") Some(parsed.first) else None();
}
