import formats/json/json_pegop;
import formats/json/json_strict_pegop;
import lingo/pegcode/parsic;
import lingo/pegaction;

export {
	// Returns None if the whole input does not match Flow's JSON grammar. The grammar
	// accepts extensions, including raw control characters in strings, \x and \X escapes,
	// and numbers such as 01 and 5. Use parseJsonStrict for JSON interchange.
	parseJsonSafer(json : string) -> Maybe<Json>;
	// Parses one complete JSON text, with standard number syntax, escapes and whitespace.
	// Numbers use the same double conversion as parseJsonSafer.
	parseJsonStrict(json : string) -> Maybe<Json>;
}

parseJsonSafer(json : string) -> Maybe<Json> {
	parsed = parsic3(pegOps4Json, json, defaultPegActions, JsonNull());
	if (parsed.third == "") Some(parsed.first) else None();
}

strictJsonActions = pegActions([
	Pair("decodeJsonString", \args : [flow] -> concatStrings(map(cast(args[0] : flow -> [string]), decodeJsonStringPart)))
]);

// A part is either a run of ordinary characters or one complete, validated escape.
decodeJsonStringPart(s : string) -> string {
	if (!startsWith(s, "\\")) s else {
		c = substring(s, 1, 1);
		if (c == "u") fromCharCode(parseHex(substring(s, 2, 4)))
		else if (c == "b") "\u0008"
		else if (c == "f") "\u000c"
		else if (c == "n") "\n"
		else if (c == "r") "\u000d"
		else if (c == "t") "\t"
		else c // quote, solidus or backslash
	}
}

parseJsonStrict(json : string) -> Maybe<Json> {
	parsed = parsic3(pegOps4Strictjson, json, strictJsonActions, JsonNull());
	if (parsed.third == "") Some(parsed.first) else None();
}
