import dynamic;
import formats/json/json;

export {
	// Tries to convert any flow object to a corresponding json.
	// Doesn't work with native and functional types: these types are mapped onto JsonNull.
	// Refs are dereferenced, i.e. not kept. Shared refs are expanded at each use.
	// If a ref leads back to itself, the whole conversion returns JsonNull.
	// Currently is implemented in: java backend.
	flow2json(any : flow) -> Json;

	// Convert any json into some flow value. In case of error, or when a JsonNull is
	// met during the conversion, returns IllegalStruct().
	// Currently is implemented in: java backend.
	json2flow(json : Json) -> flow;
}

flow2json(any : flow) -> Json {
	cyclic = ref false;
	result = flowValue2json(any, makeList(), cyclic);
	if (^cyclic) JsonNull() else result;
}

flowValue2json(any : flow, activeRefs : List<ref flow>, cyclic : ref bool) -> Json {
	type = runtimeValueType(any);
	if (^cyclic || type == "void" || type == "function" || type == "undef") {
		JsonNull();
	} else if (type == "int") {
		JsonDouble(i2d(cast(any : flow -> int)));
	} else if (type == "double") {
		JsonDouble(cast(any : flow -> double));
	} else if (type == "bool") {
		JsonBool(cast(any : flow -> bool));
	} else if (type == "string") {
		JsonString(cast(any : flow -> string));
	} else if (type == "array") {
		JsonArray(map(cast(any : flow -> [flow]), \v -> flowValue2json(v, activeRefs, cyclic)));
	} else if (type == "ref") {
		cell = cast(any : flow -> ref flow);
		switch (lastJsonRef(cell, cell, false)) {
			Some(last): {
				if (existsList(activeRefs, \r -> isSameObj(r, last))) {
					cyclic := true;
					JsonNull();
				} else {
					flowValue2json(^last, Cons(last, activeRefs), cyclic);
				}
			}
			None(): {
				cyclic := true;
				JsonNull();
			}
		}
	} else {
		name = extractStructName(any);
		if (name == "") {
			// Not a struct
			JsonNull();
		} else {
			args = extractStructArguments(any);
			fields = structFieldNames(name);
			JsonObject(concat(
				[Pair("struct", JsonString(name))],
				mapi(fields, \i, field ->
					Pair(field, flowValue2json(args[i], activeRefs, cyclic))
				))
			);
		}
	}
}

// Collapse consecutive refs without growing the stack or keeping one path entry per hop.
// The slow cursor advances every other hop; meeting it means there is no last ref.
lastJsonRef(fast : ref flow, slow : ref flow, moveSlow : bool) -> Maybe<ref flow> {
	v = ^fast;
	if (getDataTagForValue(v) != reference_data_tag) Some(fast) else {
		next = cast(v : flow -> ref flow);
		if (isSameObj(next, slow)) None() else {
			lastJsonRef(next, if (moveSlow) cast(^slow : flow -> ref flow) else slow, !moveSlow);
		}
	}
}

json2flow(json : Json) -> flow {
	switch (json) {
		JsonObject(fields): {
			switch (find(fields, \f -> f.first == "struct")) {
				Some(str): {
					name = getJsonStringValue(str.second, "");
					field_names = structFieldNames(name);
					args = map(field_names, \field ->
						switch (find(fields, \f -> f.first == field)) {
							Some(f): json2flow(f.second);
							None(): IllegalStruct();
						}
					);
					if (exists(args, \arg -> arg == IllegalStruct())) {
						flow(IllegalStruct());
					} else {
						makeStructValue(name, args, IllegalStruct());
					}
				}
				None(): {
					IllegalStruct();
				}
			}
		}
		JsonArray(arr): {
			vals : flow = map(arr, json2flow);
			if (exists(vals, \val -> val == IllegalStruct())) {
				IllegalStruct();
			} else {
				vals;
			}
		}
		JsonBool(v): v;
		JsonString(s): s;
		JsonDouble(v): v;
		JsonNull(): IllegalStruct();
	}
}
