// Compile after json.lingo: keep its document, array and object grammar,
// overriding just the number and string productions for RFC 8259.
number = ('-'? ('0' | '1'-'9' digit*) ('.' digit+)? exponent?)$s { s2d($s) };

singlestring = '"' stringpart*:parts '"' ws { decodeJsonString(:parts) };
stringpart = (plainchar+ | '\\' escape)$s { $s };
plainchar = !('"' | '\\') '\u0020'-'\uffff';
escape = '"' | '\\' | '/' | 'b' | 'f' | 'n' | 'r' | 't' | 'u' hexdigit hexdigit hexdigit hexdigit;
