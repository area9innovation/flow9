import formats/html/html;

export {
	HtmlNode ::= HtmlTag, HtmlText, HtmlEntity, HtmlComment;
		HtmlTag(
			tag: string,
			attribs: [HtmlAttrib],
			children: [HtmlNode]
		);
		HtmlAttrib(key: string, val: string);
		HtmlText(text: string);
		HtmlComment(text: string);
		HtmlEntity(
			prefix : string, // Prefixes: &# - decimal, &#x - hex, & - string
			body : string    // codes:    8828,         22A4       forall
		);

	// Converts the HTML nodes back to a string (inverse function to `parseHtml`).
	// Texts, comments and attribute values hold source text, as `parseHtml` gives them, so "&amp;" stays "&amp;".
	// Only what would be read as markup is escaped, so the nodes that `parseHtml` gives are written as they were read:
	// - in a text, a "<" that would start a tag or a comment is written as &lt;, a "&" that would start an entity as &amp;;
	// - in a comment, the ">" of a "-->" that would end it early is written as &gt;;
	// - an attribute value is put in quotes that it does not hold.
	// The text of a script is written as it is.
	html2s(html : [HtmlNode]) -> string;
	htmlNode2s(elem : HtmlNode) -> string;

	// Unescape the underlying HTML entity
	unescapeHtmlEntity(entity : HtmlEntity) -> string;
}


html2s(html : [HtmlNode]) -> string {
	out = writeHtmlTexts(fold(html, Html2sOutput(makeList(), 0, makeList(), makeList()), writeHtmlNode));
	s = list2string(out.parts);
	// Where a node starts, parseHtml also reads a "<" with white space after it as a tag, as in "< b>",
	// and the ">" that ends such a tag can be in the output after the text. So each such "<" is checked
	// in the whole output. Writing one as &lt; does not change how the others are read.
	attribsEnds : ref Tree<int, int> = ref makeTree();
	tags = filter(list2array(out.tagStarts), \i -> isHtmlTagAt(s, i, attribsEnds));
	if (tags == []) s
	else {
		rest = fold(tags, Pair(makeList(), 0), \acc, i ->
			Pair(Cons("&lt;", Cons(substring(s, acc.second, i - acc.second), acc.first)), i + 1)
		);
		list2string(Cons(strRight(s, rest.second), rest.first));
	}
}

htmlNode2s(elem : HtmlNode) -> string {
	html2s([elem]);
}

// The output so far, last part first, and its length; the texts not written yet, last first;
// and where a "<" starts a node in the written texts, last first
Html2sOutput(parts : List<string>, length : int, texts : List<string>, tagStarts : List<int>);

writeHtmlNode(out : Html2sOutput, node : HtmlNode) -> Html2sOutput {
	switch (node) {
		HtmlTag(tag, attribs, body): {
			attribs_s = concatStrings(
				mapi(attribs, \i, attr -> 
					attr.key + "=" + htmlAttribValue2s(attr.val) + if (i + 1 != length(attribs)) " " else ""
				)
			);
			if (length(body) > 0) {
				open_tag = "<" + tag + (if (length(attribs) == 0) "" else " ") + attribs_s + ">";
				close_tag = "</" + tag + ">";
				addHtml2s(writeHtmlTagBody(addHtml2s(out, open_tag), tag, body), close_tag);
			} else {
				addHtml2s(out, "<" + tag + (if (length(attribs) == 0) "" else " ") + attribs_s + "/>");
			}
		}
		// Neighbouring texts are escaped as one text: a "<" at the end of one can start a tag with the next
		HtmlText(text):       Html2sOutput(out.parts, out.length, Cons(text, out.texts), out.tagStarts);
		HtmlComment(text):    addHtml2s(out, "<!--" + htmlComment2s(text) + "-->");
		HtmlEntity(prefix, body): addHtml2s(out, prefix + body + ";");
	}
}

// parseHtml keeps the text of a script as it is, so it is written as it is
writeHtmlTagBody(out : Html2sOutput, tag : string, body : [HtmlNode]) -> Html2sOutput {
	if (tag == "script") {
		fold(body, out, \acc, node -> switch (node) {
			HtmlText(text): addHtml2s(acc, text);
			HtmlTag(__, __, __): writeHtmlNode(acc, node);
			HtmlEntity(__, __): writeHtmlNode(acc, node);
			HtmlComment(__): writeHtmlNode(acc, node);
		});
	} else {
		fold(body, out, writeHtmlNode);
	}
}

// Writes the texts not written yet, then s
addHtml2s(out : Html2sOutput, s : string) -> Html2sOutput {
	written = writeHtmlTexts(out);
	Html2sOutput(Cons(s, written.parts), written.length + strlen(s), written.texts, written.tagStarts);
}

writeHtmlTexts(out : Html2sOutput) -> Html2sOutput {
	if (isEmptyList(out.texts)) out
	else {
		text = htmlText2s(list2string(out.texts));
		starts = htmlTagStarts(text, out.length, 0, if (startsWith(text, "<")) Cons(out.length, out.tagStarts) else out.tagStarts);
		Html2sOutput(Cons(text, out.parts), out.length + strlen(text), makeList(), starts);
	}
}

// The places in a written text, from index from, of a "<" right after a "&" written as &amp;.
// A node starts there, as it does at the start of the text.
htmlTagStarts(text : string, offset : int, from : int, acc : List<int>) -> List<int> {
	i = strRangeIndexOf(text, "&amp;<", from, strlen(text));
	if (i < 0) acc
	else htmlTagStarts(text, offset, i + 6, Cons(offset + i + 5, acc));
}

// A value is written in single quotes, or in double quotes when it holds a single quote.
// A value with both is written without quotes, as parseHtml reads it, when it can be:
// with no white space, ">", "/" or "=", and no quote at its start. Else its single quotes are written as &#39;
htmlAttribValue2s(val : string) -> string {
	if (!strContains(val, "'")) "'" + val + "'"
	else if (!strContains(val, "\"")) "\"" + val + "\""
	else if (!startsWith(val, "'") && !startsWith(val, "\"") && strFindFirstOf(val, " \t\n\r>/=") == -1) val
	else "'" + strReplace(val, "'", "&#39;") + "'";
}

// In a text, parseHtml reads a "<" before a letter or "!", or before "/" and a letter or "!", as markup,
// so it is written as &lt;. A "&" that is not before white space, which it reads as the start of an entity,
// is written as &amp;. parseHtml never gives these in a text, so a text that it gives is written as it is.
htmlText2s(text : string) -> string {
	if (!strContains(text, "<") && !strContains(text, "&")) text
	else concatStrings(generate(0, strlen(text), \i -> {
		c = getCharAt(text, i);
		next = getCharAt(text, i + 1);
		if (c == "<" && (isHtmlTagLetter(next) || (next == "/" && isHtmlTagLetter(getCharAt(text, i + 2))))) "&lt;"
		else if (c == "&" && !isHtmlSpace(next)) "&amp;"
		else c;
	}));
}

// Whether parseHtml reads a script or a tag at i, by the rules `script` and `tag` of
// lib/formats/html/parser/html.gringo: "<" or "</", white space, a name, attributes, then ">" or "/>"
isHtmlTagAt(s : string, i : int, attribsEnds : ref Tree<int, int>) -> bool {
	closing = strContainsAt(s, i, "</");
	name = skipHtmlSpaces(s, i + (if (closing) 2 else 1));
	if (!closing && strContainsAt(s, name, "script") && strContainsAt(s, htmlAttribsEnd(s, skipHtmlSpaces(s, name + 6), attribsEnds, makeList()), ">")) true
	else if (!isHtmlTagLetter(getCharAt(s, name))) false
	else {
		end = htmlAttribsEnd(s, skipHtmlSpaces(s, htmlCharsEnd(s, name + 1, " \t\n\r>/")), attribsEnds, makeList());
		strContainsAt(s, end, ">") || strContainsAt(s, end, "/>");
	}
}

// The end of the attributes from i. The end is kept in ends for each attribute on the way,
// so a later "<" whose attributes reach one of them stops there.
htmlAttribsEnd(s : string, i : int, ends : ref Tree<int, int>, starts : List<int>) -> int {
	known = lookupTreeDef(^ends, i, -1);
	keyEnd = if (known < 0) htmlCharsEnd(s, i, " \t\n\r=>/") else i;
	if (keyEnd > i) {
		afterKey = skipHtmlSpaces(s, keyEnd);
		next = skipHtmlSpaces(s, if (getCharAt(s, afterKey) == "=") htmlAttribValueEnd(s, afterKey) else afterKey);
		htmlAttribsEnd(s, next, ends, Cons(i, starts));
	} else {
		end = if (known < 0) i else known;
		iterList(starts, \start -> ends := setTree(^ends, start, end));
		end;
	}
}

// The end of the value after the "=" at i; i when there is no value
htmlAttribValueEnd(s : string, i : int) -> int {
	start = skipHtmlSpaces(s, i + 1);
	quote = getCharAt(s, start);
	close = if (quote == "'" || quote == "\"") strRangeIndexOf(s, quote, start + 1, strlen(s)) else -1;
	if (close >= 0) close + 1
	else {
		end = htmlCharsEnd(s, start, " \t\n\r>/=");
		if (end > start) end else i;
	}
}

// The index of the first char from i that is one of chars, or the length of s
htmlCharsEnd(s : string, i : int, chars : string) -> int {
	countUntil(i, strlen(s), \j -> strContains(chars, getCharAt(s, j)));
}

skipHtmlSpaces(s : string, i : int) -> int {
	countUntil(i, strlen(s), \j -> !isHtmlSpace(getCharAt(s, j)));
}

isHtmlTagLetter(c : string) -> bool {
	c == "!" || ("a" <= c && c <= "z") || ("A" <= c && c <= "Z");
}

isHtmlSpace(c : string) -> bool {
	c == " " || c == "\t" || c == "\n" || c == "\r";
}

// A comment ends at "-->", and in a browser also at a ">" or "->" right after "<!--".
// The ">" there is written as &gt;, so that the comment keeps all of its text.
htmlComment2s(text : string) -> string {
	escaped = strReplace(text, "-->", "--&gt;");
	if (startsWith(escaped, ">")) "&gt;" + strRight(escaped, 1)
	else if (startsWith(escaped, "->")) "-&gt;" + strRight(escaped, 2)
	else escaped;
}

unescapeHtmlEntity(entity : HtmlEntity) -> string {
	if (entity.prefix == "&#") {
		fromCharCode(s2i(entity.body)); // like &#8828,
	} else if (entity.prefix == "&#x") {
		fromCharCode(parseHex(entity.body)); // like &#x22A4;
	} else {
		unescapeHtml2("&" + entity.body + ";"); // like &forall;
	}
}
