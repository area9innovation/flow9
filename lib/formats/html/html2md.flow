import formats/html/html_node;
import math/matrix;

export {
	// Converts HTML into markdown. Following markdown constructions are supported:
	// - headings
	// - line breaks
	// - emphasize with bold/itallic font
	// - block code quotations
	// - lists (ordered, unordered)
	// - tables
	ruHtml2md(html : [HtmlNode]) -> string;
}

ruHtml2md(html : [HtmlNode]) -> string {
	output = ruDoHtml2md(html, "*", false);
	// OK, now clean it up and avoid too many empty lines
	lines = strSplit(output, "\n");
	// Clean out whitespace
	trimmedLines = map(lines, \line -> {
		trim2(line, " \t\r");
	});
	// Reduce two empty lines to one
	simplify = fold(trimmedLines, [], \acc, line -> {
		if (acc != [] && line == "" && lastElement(acc, "") == "") acc else arrayPush(acc, line)
	});
	strGlue(simplify, "\n");
}

// In code, Markdown shows the text as it is written, so nothing is escaped there
ruDoHtml2md(html : [HtmlNode], indent : string, code : bool) -> string {
	ruJoinHtml2md(html, map(html, \elem -> ruHtmlNode2md(elem, indent, code)), code);
}

// A & from an entity is written as &amp; if it could make a new entity with the text after it, as in &amp;copy;.
// A \ right before an entity written here, a link or an image would make it plain text, so it is written as &#92;.
ruJoinHtml2md(html : [HtmlNode], parts : [string], code : bool) -> string {
	if (code) {
		concatStrings(parts);
	} else {
		list2string(foldi(parts, makeList(), \i, acc, part -> {
			md = switch (html[i]) {
				HtmlEntity(__, __): if (part == "&" && ruMayStartEntity(parts, i + 1, 0, false)) "&amp;" else part;
				HtmlTag(__, __, __): part;
				HtmlText(__): part;
				HtmlComment(__): part;
			};
			Cons(md, if (ruIsMdEscapeStart(html[i], md)) ruEscapeMdPartsEnd(acc, makeList()) else acc);
		}));
	}
}

ruIsMdEscapeStart(node : HtmlNode, md : string) -> bool {
	switch (node) {
		HtmlTag(tag, __, __): {
			tag == "a" && startsWith(md, "[") || tag == "img" && startsWith(md, "![") || ruStartsWithMdEntity(md);
		}
		HtmlEntity(__, __): ruStartsWithMdEntity(md);
		HtmlText(__): ruStartsWithMdEntity(md);
		HtmlComment(__): false;
	}
}

ruStartsWithMdEntity(md : string) -> bool {
	startsWith(md, "&") && exists(["&lt;", "&amp;", "&#91;", "&#92;", "&#93;"], \entity -> startsWith(md, entity));
}

ruHtmlNode2md(html : HtmlNode, indent : string, code : bool) -> string {
	switch (html) {
		HtmlTag(tag, attribs, body): {
			inCode = code || tag == "code" || tag == "pre" || tag == "tt";
			// In the text of a link, [ and ] are written as entities, as a ] would end the text
			linkText = !code && tag == "a" && ruIsWebUrl(ruHtmlUrl(attribs, "href"));
			contents = ruDoHtml2md(if (linkText) ruHtmlLinkText(body) else body, indent, inCode);
			if (strlen(tag) == 2 && getCharAt(tag, 0) == "h") {
				ruHtmlHeading2md(s2i(getCharAt(tag, 1)), contents);
			} else if (tag == "p" || tag == "div" || tag == "body" || tag == "section" || tag == "html") {
				trim2(contents, " \n\t\r") + "\n\n";
			} else if (tag == "br") {
				"\n";
			} else if (tag == "strong" || tag == "b") {
				"**" + contents + "**";
			} else if (tag == "pre" || tag == "tt") {
				"`" + contents + "`";
			} else if (tag == "sup") {
				"^" + contents + "^";
			} else if (tag == "sub") {
				"~" + contents + "~";
			} else if (tag == "em" || tag == "i" || tag == "it") {
				"*" + contents + "*";
			} else if (tag == "blockquote") {
				strGlue(map(strSplit(contents, "\n"), \line -> "> " + line), "\n");
			} else if (tag == "ol" || tag == "ul" || tag == "li") {
				ruHtmlList2md(tag, body, indent, code);
			} else if (tag == "sub") {
				"_" + contents;
			} else if (tag == "table") {
				ruHtmlTable2md(body, code);
			} else if (tag == "span") {
				trimmed = trim2(contents, " \n\t\r");
				if (trimmed != contents) trimmed + " " else trimmed
			} else if (tag == "a") {
				href = ruHtmlUrl(attribs, "href");
				if (ruIsWebUrl(href)) {
					ruMdLink(trim2(contents, " \n\t\r"), href, code);
				} else {
					// Internal link. Ignore
					trim2(contents, " \n\t\r");
				}
			} else if (tag == "head" || tag == "header" || tag == "style" || tag == "script" || tag == "link" || tag == "title") {
				// Ignore these
				"";
			} else if (tag == "tr" || tag == "th" || tag == "td") {
				// These tags are processed in `ruHtmlTable2md`
				"";
			} else if (tag == "img") {
				// ![Image](http://example.com/image.png)
				src = ruHtmlUrl(attribs, "src");
				alt = fold(attribs, None(), \acc, attrib -> if (attrib.key == "alt") Some(attrib.val) else acc);
				alt2md = \text -> if (code) text else ruEscapeMdAlt(text);
				if (ruIsWebUrl(src) || startsWith(toLowerCase(strLeft(src, 11)), "data:image/")) {
					"!" + ruMdLink(alt2md(either(alt, "Image")), src, code);
				} else {
					// Markdown can not show this image, so only its text is kept
					alt2md(either(alt, ""));
				}
			} else if (tag == "code") {
				if (strContains(contents, "\n")) {
					"```\n" + contents + "\n```";
				} else {
					"`" + contents + "`";
				}
			} else if (tag != "") {
				println("TODO: Support " + tag + " in ruHtmlNode2md");
				contents;
			} else {
				contents;
			}
		}
		HtmlText(text): text;
		HtmlComment(text): "";
		HtmlEntity(prefix, body): {
			text = unescapeHtmlEntity(html);
			// A < from an entity is written as &lt;, so that it does not start a tag
			if (text == "<" && !code) "&lt;" else text;
		}
	}
}

ruHtmlLinkText(body : [HtmlNode]) -> [HtmlNode] {
	map(body, \node -> switch (node) {
		HtmlTag(tag, attribs, children): {
			if (tag == "code" || tag == "pre" || tag == "tt") node else HtmlTag(tag, attribs, ruHtmlLinkText(children));
		}
		HtmlText(text): HtmlText(ruEscapeMdBrackets(text));
		HtmlEntity(__, __): {
			text = unescapeHtmlEntity(node);
			if (text == "[" || text == "]") HtmlText(ruEscapeMdBrackets(text)) else node;
		}
		HtmlComment(__): node;
	});
}

// Whether a & before the parts from i on starts an entity in Markdown: a name or #number, then ;.
// At the end of an element the text after it is not known here, so a & there counts as one.
// name is the length of the name in the parts before i, hash tells if it starts with #.
// The parts are read only up to the end of the name, so a long name is not read again and again.
ruMayStartEntity(parts : [string], i : int, name : int, hash : bool) -> bool {
	if (i < length(parts)) {
		part = parts[i];
		start = b2i(name == 0 && !hash && startsWith(part, "#"));
		end = countUntil(start, strlen(part), \j -> {
			c = getCharCodeAt(part, j);
			!(c >= 0x30 && c <= 0x39 || c >= 0x41 && c <= 0x5A || c >= 0x61 && c <= 0x7A);
		});
		if (end < strlen(part)) {
			name + end - start > 0 && getCharAt(part, end) == ";";
		} else {
			ruMayStartEntity(parts, i + 1, name + end - start, hash || start == 1);
		}
	} else {
		name == 0 && !hash;
	}
}

// Browsers drop tabs and line breaks from a url, and spaces around it
ruHtmlUrl(attribs : [HtmlAttrib], key : string) -> string {
	url = fold(attribs, "", \acc, attrib -> if (attrib.key == key) attrib.val else acc);
	trim2(strReplaces(url, ["\t", "", "\n", "", "\r", ""]), " ");
}

ruIsWebUrl(url : string) -> bool {
	scheme = toLowerCase(strLeft(url, 8));
	startsWith(scheme, "http://") || startsWith(scheme, "https://");
}

ruEscapeMdBrackets(text : string) -> string {
	ruEscapeMdChars(text, "[]");
}

// Entities in an attribute value are not decoded, so they are kept. A < is written as &lt;
ruEscapeMdAlt(alt : string) -> string {
	ruEscapeMdChars(alt, "[]<");
}

// Writes these characters as entities. A \ right before them would make the entity plain text,
// so it is written as &#92;.
ruEscapeMdChars(text : string, chars : string) -> string {
	if (strFindFirstOf(text, chars) == -1) {
		text;
	} else {
		// The parts written so far, last first, and where the text after them starts
		done = stringFoldi(text, Pair(makeList(), 0), \i, acc, c -> {
			ch = fromCharCode(c);
			if (!strContains(chars, ch)) acc else {
				before = ruEscapeMdEnd(substring(text, acc.second, i - acc.second));
				Pair(Cons(if (ch == "<") "&lt;" else "&#" + i2s(c) + ";", Cons(before, acc.first)), i + 1);
			}
		});
		list2string(Cons(strRight(text, done.second), done.first));
	}
}

// Writes the \ at the end of the text as &#92;
ruEscapeMdEnd(text : string) -> string {
	if (endsWith(text, "\\")) {
		trimmed = rtrim2(text, "\\");
		trimmed + strRepeat("&#92;", strlen(text) - strlen(trimmed));
	} else {
		text;
	}
}

// Writes the \ at the end of the parts as &#92;. The last part is the first in the list.
ruEscapeMdPartsEnd(parts : List<string>, done : List<string>) -> List<string> {
	switch (parts) {
		EmptyList(): ruPrependParts(done, parts);
		Cons(part, rest): {
			escaped = Cons(ruEscapeMdEnd(part), done);
			if (rtrim2(part, "\\") == "") ruEscapeMdPartsEnd(rest, escaped) else ruPrependParts(escaped, rest);
		}
	}
}

ruPrependParts(parts : List<string>, to : List<string>) -> List<string> {
	foldList(parts, to, \acc, part -> Cons(part, acc));
}

// In code, Markdown shows the text as it is written, so nothing is escaped there
ruMdLink(text : string, url : string, code : bool) -> string {
	if (code) {
		"[" + text + "](" + url + ")";
	} else {
		"[" + text + "](" + ruEscapeMdUrl(url) + ")";
	}
}

// A space or control character ends the url in Markdown, and so does a round bracket without its pair,
// so these are written as %XX. A \ is written too, as \) would not end the url. Browsers read a \ in
// an http(s) url before its ? or # as /, so there it is written as /, and elsewhere as %5C.
ruEscapeMdUrl(url : string) -> string {
	depth = stringFold(url, 0, \d, c -> if (d < 0) d else if (c == 0x28) d + 1 else if (c == 0x29) d - 1 else d);
	escape = \c -> c <= 0x20 || c == 0x7F || c == 0x5C || depth != 0 && (c == 0x28 || c == 0x29);
	if (stringFold(url, false, \acc, c -> acc || escape(c))) {
		query = strFindFirstOf(url, "?#");
		path = if (!ruIsWebUrl(url)) 0 else if (query == -1) strlen(url) else query;
		concatStrings(mapi(s2a(url), \i, c ->
			if (c == 0x5C && i < path) "/"
			else if (escape(c)) "%" + lpad(formatHex(c), "0", 2)
			else fromCharCode(c)
		));
	} else {
		url;
	}
}

ruHtmlHeading2md(level : int, body : string) -> string {
	if (level < 1 || level > 5) {
		// Illegal heading level
		body;
	} else if (strContains(body, "\n")) {
		// Heading has new lines
		body;
	} else {
		"\n\n" + strRepeat("#", level) + (if (startsWith(body, " ")) "" else " ") + body + "\n\n";
	}
}

insertPrefix2md(pref : string, s : string) -> string {
	non_space = findiDef(s2a(s), \code -> code > 32, -1);
	if (non_space == -1) {
		s + pref;
	} else {
		spaces = strLeft(s, non_space);
		contents = strRight(s, non_space);
		spaces + pref + contents;
	}
}

ruHtmlList2md(tag : string, body : [HtmlNode], indent : string, code : bool) -> string {
	i = ref 0;
	"\n" + ruJoinHtml2md(body,
		map(body, \elem ->  {
			str = ruHtmlNode2md(elem, indent, code);
			switch (elem) {
				HtmlTag(tag1, __,__): {
					if (tag1 != "li") str else {
						i := ^i + 1;
						if (tag == "ol") {
							insertPrefix2md(i2s(^i) + ". ", str);
						} else {
							insertPrefix2md(indent + " ", str);
						}
					}
				}
				default: str;
			}
		}),
		code
	);
}

ruExtractHtmlTags(body : [HtmlNode]) -> [HtmlTag] {
	filtermap(body, \elem ->
		switch(elem) {
			HtmlTag(tag, attibs, body1): Some(elem);
			default: None();
		}
	);
}

ruFirstTag(body : [HtmlNode]) -> HtmlTag {
	tags = ruExtractHtmlTags(body);
	firstElement(tags, HtmlTag("", [], [])); 
}

ruHtmlTable2md(children : [HtmlNode], code : bool) -> string {
	first_row = ruFirstTag(children);
	first_col = ruFirstTag(first_row.children);
	headers = if (first_col.tag != "th") None() else {
		Some(filtermap(first_row.children, \elem ->
			switch(elem) {
				HtmlTag(tag, __, children1): {
					if (tag != "th") None() else Some(ruDoHtml2md(children1, "", code));
				}
				default: None();
			}
		));
	}
	tags = filtermap(children, \elem ->
		switch(elem) {
			HtmlTag(__,__,__): Some(elem);
			default: None();
		}
	);
	rows = filtermap(children, \elem ->
		switch(elem) {
			HtmlTag(tag, __, children1): {
				if (tag != "tr") None() else {
					col_tags = ruExtractHtmlTags(children1);
					if (col_tags == []) None() else {
						if (col_tags[0].tag == "th") None() else {
							cols = filtermap(children1, \elem1 -> 
								switch(elem1) {
									HtmlTag(tag1, __, cell): {
										if (tag1 != "td") None() else {
											Some(ruDoHtml2md(cell, "", code));
										}
									}
									default: None();
								}
							);
							Some(cols);
						}
					}
				}
			}
			default: None();
		}
	);
	cols = transposeMatrix(rows);
	"\n" + stringMatrix2s(cols, headers, None());
}
