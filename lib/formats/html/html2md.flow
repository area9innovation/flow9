import formats/html/html_node;
import math/matrix;

export {
	// Converts HTML into markdown. Following markdown constructions are supported:
	// - headings
	// - line breaks
	// - emphasize with bold/itallic font
	// - block code quotations
	// - lists (ordered, unordered)
	// - tables
	ruHtml2md(html : [HtmlNode]) -> string;
}

ruHtml2md(html : [HtmlNode]) -> string {
	output = ruDoHtml2md(html, "*");
	// OK, now clean it up and avoid too many empty lines
	lines = strSplit(output, "\n");
	// Clean out whitespace
	trimmedLines = map(lines, \line -> {
		trim2(line, " \t\r");
	});
	// Reduce two empty lines to one
	simplify = fold(trimmedLines, [], \acc, line -> {
		if (acc != [] && line == "" && lastElement(acc, "") == "") acc else arrayPush(acc, line)
	});
	strGlue(simplify, "\n");
}

ruDoHtml2md(html : [HtmlNode], indent : string) -> string {
	parts = map(html, \elem -> ruHtmlNode2md(elem, indent));
	concatStrings(mapi(parts, \i, part -> switch (html[i]) {
		// A & from an entity is written as &amp; if it could make a new entity with the text after it, as in &amp;copy;
		HtmlEntity(__, __): if (part == "&" && ruMayStartEntity(parts, i + 1, "")) "&amp;" else part;
		HtmlTag(__, __, __): part;
		HtmlText(__): part;
		HtmlComment(__): part;
	}))
}

ruHtmlNode2md(html : HtmlNode, indent : string) -> string {
	switch (html) {
		HtmlTag(tag, attribs, body): {
			contents = ruDoHtml2md(ruHtmlBody2md(tag, attribs, body), indent);
			if (strlen(tag) == 2 && getCharAt(tag, 0) == "h") {
				ruHtmlHeading2md(s2i(getCharAt(tag, 1)), contents);
			} else if (tag == "p" || tag == "div" || tag == "body" || tag == "section" || tag == "html") {
				trim2(contents, " \n\t\r") + "\n\n";
			} else if (tag == "br") {
				"\n";
			} else if (tag == "strong" || tag == "b") {
				"**" + contents + "**";
			} else if (tag == "pre" || tag == "tt") {
				"`" + contents + "`";
			} else if (tag == "sup") {
				"^" + contents + "^";
			} else if (tag == "sub") {
				"~" + contents + "~";
			} else if (tag == "em" || tag == "i" || tag == "it") {
				"*" + contents + "*";
			} else if (tag == "blockquote") {
				strGlue(map(strSplit(contents, "\n"), \line -> "> " + line), "\n");
			} else if (tag == "ol" || tag == "ul" || tag == "li") {
				ruHtmlList2md(tag, body, indent);
			} else if (tag == "sub") {
				"_" + contents;
			} else if (tag == "table") {
				ruHtmlTable2md(body);
			} else if (tag == "span") {
				trimmed = trim2(contents, " \n\t\r");
				if (trimmed != contents) trimmed + " " else trimmed
			} else if (tag == "a") {
				href = ruHtmlUrl(attribs, "href");
				if (ruIsWebUrl(href)) {
					"[" + trim2(contents, " \n\t\r") + "](" + ruEscapeMdUrl(href) + ")";
				} else {
					// Internal link. Ignore
					trim2(contents, " \n\t\r");
				}
			} else if (tag == "head" || tag == "header" || tag == "style" || tag == "script" || tag == "link" || tag == "title") {
				// Ignore these
				"";
			} else if (tag == "tr" || tag == "th" || tag == "td") {
				// These tags are processed in `ruHtmlTable2md`
				"";
			} else if (tag == "img") {
				// ![Image](http://example.com/image.png)
				src = ruHtmlUrl(attribs, "src");
				alt = fold(attribs, None(), \acc, attrib -> if (attrib.key == "alt") Some(attrib.val) else acc);
				if (ruIsWebUrl(src) || startsWith(toLowerCase(strLeft(src, 11)), "data:image/")) {
					"![" + ruEscapeMdAlt(either(alt, "Image")) + "](" + ruEscapeMdUrl(src) + ")"
				} else {
					// Markdown can not show this image, so only its text is kept
					ruEscapeMdAlt(either(alt, ""));
				}
			} else if (tag == "code") {
				if (strContains(contents, "\n")) {
					"```\n" + contents + "\n```";
				} else {
					"`" + contents + "`";
				}
			} else if (tag != "") {
				println("TODO: Support " + tag + " in ruHtmlNode2md");
				contents;
			} else {
				contents;
			}
		}
		HtmlText(text): text;
		HtmlComment(text): "";
		HtmlEntity(prefix, body): {
			text = unescapeHtmlEntity(html);
			// A < from an entity is written as &lt;, so that it does not start a tag
			if (text == "<") "&lt;" else text;
		}
	}
}

// Markdown shows code as it is written, so entities in code become their characters.
// In the text of a link, [ and ] are written as entities, as a ] would end the text.
ruHtmlBody2md(tag : string, attribs : [HtmlAttrib], body : [HtmlNode]) -> [HtmlNode] {
	if (tag == "code" || tag == "pre" || tag == "tt") {
		ruHtmlCodeText(body);
	} else if (tag == "a" && ruIsWebUrl(ruHtmlUrl(attribs, "href"))) {
		ruHtmlLinkText(body);
	} else {
		body;
	}
}

ruHtmlCodeText(body : [HtmlNode]) -> [HtmlNode] {
	map(body, \node -> switch (node) {
		HtmlTag(tag, attribs, children): HtmlTag(tag, attribs, ruHtmlCodeText(children));
		HtmlEntity(__, __): HtmlText(unescapeHtmlEntity(node));
		HtmlText(__): node;
		HtmlComment(__): node;
	});
}

ruHtmlLinkText(body : [HtmlNode]) -> [HtmlNode] {
	map(body, \node -> switch (node) {
		HtmlTag(tag, attribs, children): {
			if (tag == "code" || tag == "pre" || tag == "tt") node else HtmlTag(tag, attribs, ruHtmlLinkText(children));
		}
		HtmlText(text): HtmlText(ruEscapeMdBrackets(text));
		HtmlEntity(__, __): {
			text = unescapeHtmlEntity(node);
			if (text == "[" || text == "]") HtmlText(ruEscapeMdBrackets(text)) else node;
		}
		HtmlComment(__): node;
	});
}

// Whether a & before these parts starts an entity in Markdown: a name or #number, then ;.
// At the end of an element the text after it is not known here, so a & there counts as one.
ruMayStartEntity(parts : [string], i : int, after : string) -> bool {
	end = ruEntityNameEnd(after);
	if (end < strlen(after)) {
		end > b2i(startsWith(after, "#")) && getCharAt(after, end) == ";";
	} else if (i < length(parts)) {
		ruMayStartEntity(parts, i + 1, after + parts[i]);
	} else {
		after == "";
	}
}

ruEntityNameEnd(s : string) -> int {
	countUntil(b2i(startsWith(s, "#")), strlen(s), \i -> {
		c = getCharCodeAt(s, i);
		!(c >= 0x30 && c <= 0x39 || c >= 0x41 && c <= 0x5A || c >= 0x61 && c <= 0x7A);
	});
}

// Browsers drop tabs and line breaks from a url, and spaces around it
ruHtmlUrl(attribs : [HtmlAttrib], key : string) -> string {
	url = fold(attribs, "", \acc, attrib -> if (attrib.key == key) attrib.val else acc);
	trim2(strReplaces(url, ["\t", "", "\n", "", "\r", ""]), " ");
}

ruIsWebUrl(url : string) -> bool {
	scheme = toLowerCase(strLeft(url, 8));
	startsWith(scheme, "http://") || startsWith(scheme, "https://");
}

ruEscapeMdBrackets(text : string) -> string {
	strReplaces(text, ["[", "&#91;", "]", "&#93;"]);
}

// Entities in an attribute value are not decoded, so they are kept. A < is written as &lt;
ruEscapeMdAlt(alt : string) -> string {
	ruEscapeMdBrackets(strReplace(alt, "<", "&lt;"));
}

// A space or control character ends the url in Markdown, and so does a round bracket without its pair,
// so these are written as %XX
ruEscapeMdUrl(url : string) -> string {
	depth = stringFold(url, 0, \d, c -> if (d < 0) d else if (c == 0x28) d + 1 else if (c == 0x29) d - 1 else d);
	escape = \c -> c <= 0x20 || c == 0x7F || depth != 0 && (c == 0x28 || c == 0x29);
	if (stringFold(url, false, \acc, c -> acc || escape(c))) {
		concatStrings(map(s2a(url), \c -> if (escape(c)) "%" + lpad(formatHex(c), "0", 2) else fromCharCode(c)));
	} else {
		url;
	}
}

ruHtmlHeading2md(level : int, body : string) -> string {
	if (level < 1 || level > 5) {
		// Illegal heading level
		body;
	} else if (strContains(body, "\n")) {
		// Heading has new lines
		body;
	} else {
		"\n\n" + strRepeat("#", level) + (if (startsWith(body, " ")) "" else " ") + body + "\n\n";
	}
}

insertPrefix2md(pref : string, s : string) -> string {
	non_space = findiDef(s2a(s), \code -> code > 32, -1);
	if (non_space == -1) {
		s + pref;
	} else {
		spaces = strLeft(s, non_space);
		contents = strRight(s, non_space);
		spaces + pref + contents;
	}
}

ruHtmlList2md(tag : string, body : [HtmlNode], indent : string) -> string {
	i = ref 0;
	"\n" + concatStrings(
		map(body, \elem ->  {
			str = ruHtmlNode2md(elem, indent);
			switch (elem) {
				HtmlTag(tag1, __,__): {
					if (tag1 != "li") str else {
						i := ^i + 1;
						if (tag == "ol") {
							insertPrefix2md(i2s(^i) + ". ", str);
						} else {
							insertPrefix2md(indent + " ", str);
						}
					}
				}
				default: str;
			}
		})
	);
}

ruExtractHtmlTags(body : [HtmlNode]) -> [HtmlTag] {
	filtermap(body, \elem ->
		switch(elem) {
			HtmlTag(tag, attibs, body1): Some(elem);
			default: None();
		}
	);
}

ruFirstTag(body : [HtmlNode]) -> HtmlTag {
	tags = ruExtractHtmlTags(body);
	firstElement(tags, HtmlTag("", [], [])); 
}

ruHtmlTable2md(children : [HtmlNode]) -> string {
	first_row = ruFirstTag(children);
	first_col = ruFirstTag(first_row.children);
	headers = if (first_col.tag != "th") None() else {
		Some(filtermap(first_row.children, \elem ->
			switch(elem) {
				HtmlTag(tag, __, children1): {
					if (tag != "th") None() else Some(ruDoHtml2md(children1, ""));
				}
				default: None();
			}
		));
	}
	tags = filtermap(children, \elem ->
		switch(elem) {
			HtmlTag(__,__,__): Some(elem);
			default: None();
		}
	);
	rows = filtermap(children, \elem ->
		switch(elem) {
			HtmlTag(tag, __, children1): {
				if (tag != "tr") None() else {
					col_tags = ruExtractHtmlTags(children1);
					if (col_tags == []) None() else {
						if (col_tags[0].tag == "th") None() else {
							cols = filtermap(children1, \elem1 -> 
								switch(elem1) {
									HtmlTag(tag1, __, cell): {
										if (tag1 != "td") None() else {
											Some(ruDoHtml2md(cell, ""));
										}
									}
									default: None();
								}
							);
							Some(cols);
						}
					}
				}
			}
			default: None();
		}
	);
	cols = transposeMatrix(rows);
	"\n" + stringMatrix2s(cols, headers, None());
}
