import runtime;
import string;
import ds/list;

export {
	// An .ini file. Uses "" for quoting " in values; unquoted values are trimmed.
	// Use ; for comments at the start of lines. Backslashes are always literal.
	// Name quoting is enabled only by an exact first line of "; flow9-ini: quoted-names-v1"
	// (LF or CRLF), after a byte order mark if there is one. Without that marker, quotes in
	// keys and section names stay literal.
	parseIniFile(v : string) -> IniFile;

	// Values are quoted as needed to read back the same. Legacy name spelling is kept unless a
	// key contains =, [ or ;, has edge whitespace, or either kind of name contains a line break
	// or a section name contains ]. Such files start with the marker above and quote every name,
	// doubling embedded quotes, just like values. This is a Flow INI extension: other readers
	// need support for the marker and quoted names to read these files with the same meaning.
	iniFile2string(v : IniFile) -> string;
		IniFile(sections : [IniSection]);
		IniSection(name : string, keys : [KeyValue]);
}

iniQuotedNamesMarker = "; flow9-ini: quoted-names-v1";
iniMarkerLf = iniQuotedNamesMarker + "\n";
iniMarkerCrlf = iniQuotedNamesMarker + "\u000d\n";

// Trimmed from the ends of unquoted keys; a key with any of these at an end is printed quoted
iniKeySpace = "\n \u000d\t";

parseIniFile(v : string) -> IniFile {
	// Editors on Windows often save with a byte order mark
	bom = if (strLeft(v, 1) == "\uFEFF") 1 else 0;
	markerEnd = if (strContainsAt(v, bom, iniMarkerLf)) bom + strlen(iniMarkerLf)
		else if (strContainsAt(v, bom, iniMarkerCrlf)) bom + strlen(iniMarkerCrlf)
		else -1;
	IniFile(list2array(doParseIniFile(v, max(markerEnd, bom), -1, markerEnd != -1, makeList())));
}

// The keys of one section, the position where they stop and the line end found last
IniKeys(keys : List<KeyValue>, next : int, lineEnd : int);

// A quoted section name or key read up to its delimiter
IniName ::= IniNameFound, IniNameMalformed;
	// The name and the position of its delimiter
	IniNameFound(name : string, delimiter : int);
	// A quoted name without its delimiter. The rest of the line from skipFrom is not read.
	IniNameMalformed(skipFrom : int);

// The text is scanned by position; only section names, keys and values are copied out
doParseIniFile(v : string, start : int, lineEnd : int, quotedNames : bool, acc : List<IniSection>) -> List<IniSection> {
	n = strlen(v);
	lb = strRangeIndexOf(v, "[", start, n);
	if (lb == -1 || lb + 1 >= n) {
		acc
	} else {
		nameStart = lb + 1;
		quoteStart = if (quotedNames) iniSkipAny(v, nameStart, n, " \t") else nameStart;
		quoted = quotedNames && quoteStart < n && getCharAt(v, quoteStart) == "\"";
		rb = if (quoted) -1 else strRangeIndexOf(v, "]", nameStart, n);
		if (!quoted && rb == -1) {
			// A header without ] takes the rest as its name
			Cons(IniSection(strRight(v, nameStart), []), acc)
		} else {
			name = if (quoted) grabIniQuotedName(v, quoteStart, "]") else IniNameFound(substring(v, nameStart, rb - nameStart), rb);
			switch (name) {
				IniNameFound(title, close): {
					headerEnd = iniLineEnd(v, close + 1, lineEnd);
					keys = doParseIniKeys(v, iniNextLine(close + 1, headerEnd, n), headerEnd, quotedNames, makeList());
					doParseIniFile(v, keys.next, keys.lineEnd, quotedNames, Cons(IniSection(title, list2array(keys.keys)), acc));
				}
				IniNameMalformed(skipFrom): {
					// The header is dropped with its keys, which are still read to find the next header
					keys = doParseIniKeys(v, skipFrom, lineEnd, quotedNames, makeList());
					doParseIniFile(v, keys.next, keys.lineEnd, quotedNames, acc);
				}
			}
		}
	}
}

// Keys up to the next "["; a ";" before the "=" starts a comment, except inside a quoted name.
// In marked documents a key ends at its line: a line without "=" is skipped.
doParseIniKeys(v : string, start : int, lineEnd : int, quotedNames : bool, acc : List<KeyValue>) -> IniKeys {
	n = strlen(v);
	keyStart = if (quotedNames) iniSkipAny(v, start, n, iniKeySpace) else start;
	quoted = quotedNames && keyStart < n && getCharAt(v, keyStart) == "\"";
	name : Maybe<IniName> = if (quoted) Some(grabIniQuotedName(v, keyStart, "=")) else None();
	special = switch (name) {
		None(): iniFindAny(v, keyStart, n, if (quotedNames) "=[;\n" else "=[;");
		Some(quotedName): switch (quotedName) {
			IniNameFound(__, eqPos): eqPos;
			// The rest of the line is skipped, unless a section starts on it
			IniNameMalformed(skipFrom): iniFindAny(v, skipFrom, n, "[\n");
		}
	};
	found = if (special == n) "" else getCharAt(v, special);
	if (found == "=") {
		key = switch (name) {
			None(): trim2(substring(v, keyStart, special - keyStart), iniKeySpace);
			Some(quotedName): switch (quotedName) {
				IniNameFound(text, __): text;
				IniNameMalformed(__): "";
			}
		};
		valueEnd = iniLineEnd(v, special + 1, lineEnd);
		value = parseIniValue(v, special + 1, valueEnd);
		doParseIniKeys(v, value.second, valueEnd, quotedNames, Cons(KeyValue(key, value.first), acc));
	} else if (found == ";") {
		commentEnd = iniLineEnd(v, special + 1, lineEnd);
		doParseIniKeys(v, iniNextLine(special + 1, commentEnd, n), commentEnd, quotedNames, acc);
	} else if (found == "\n") {
		doParseIniKeys(v, special + 1, lineEnd, quotedNames, acc);
	} else {
		IniKeys(acc, special, lineEnd)
	}
}

// A quoted name must be followed by its delimiter, with only spaces or tabs between, as in
// "key" = value. The name is copied out only when the delimiter is there. Otherwise, when the
// quote closes on its own line, the rest of that line is skipped. When it closes on a later line
// or never, the quote is taken as a stray one: only its own line is skipped, so a quote on a
// later line cannot pair with it and take valid keys and sections along.
grabIniQuotedName(v : string, start : int, delimiter : string) -> IniName {
	n = strlen(v);
	closed = iniQuotedEnd(v, start + 1, n);
	after = if (closed == -1) n else iniSkipAny(v, closed, n, " \t");
	if (closed != -1 && after < n && getCharAt(v, after) == delimiter) {
		IniNameFound(grabIniQuoted(v, start + 1, makeList()).first, after)
	} else {
		nl = strRangeIndexOf(v, "\n", start + 1, if (closed == -1) n else closed);
		IniNameMalformed(if (nl != -1) nl else if (closed == -1) n else closed);
	}
}

// The position after the quote that closes quoted text starting at start, or -1 when none does
iniQuotedEnd(v : string, start : int, n : int) -> int {
	closing = strRangeIndexOf(v, "\"", start, n);
	if (closing == -1) -1
	else if (closing + 1 < n && getCharAt(v, closing + 1) == "\"") iniQuotedEnd(v, closing + 2, n)
	else closing + 1;
}

// Position of the first char not in chars in [start, end), or end when there is none
iniSkipAny(v : string, start : int, end : int, chars : string) -> int {
	if (start < end && strIndexOf(chars, getCharAt(v, start)) != -1) iniSkipAny(v, start + 1, end, chars)
	else start;
}

// The value after "=": quoted when a quote comes before the line end, else the line trimmed
parseIniValue(v : string, start : int, lineEnd : int) -> Pair<string, int> {
	qu = strRangeIndexOf(v, "\"", start, lineEnd);
	if (qu != -1) {
		grabIniQuoted(v, qu + 1, makeList())
	} else {
		text = substring(v, start, lineEnd - start);
		if (lineEnd == strlen(v)) Pair(trim(text), lineEnd)
		else Pair(trim2(text, " \u000d"), lineEnd + 1)
	}
}

// Collects the quoted text after the opening quote; a doubled quote stands for one quote
grabIniQuoted(v : string, start : int, acc : List<string>) -> Pair<string, int> {
	n = strlen(v);
	closing = strRangeIndexOf(v, "\"", start, n);
	if (closing == -1) {
		Pair(list2string(Cons(strRight(v, start), acc)), n)
	} else {
		piece = substring(v, start, closing - start);
		if (closing + 1 < n && getCharAt(v, closing + 1) == "\"") {
			grabIniQuoted(v, closing + 2, Cons("\"", Cons(piece, acc)))
		} else {
			Pair(list2string(Cons(piece, acc)), closing + 1)
		}
	}
}

// Position of the first char from chars in [start, end), or end when there is none
iniFindAny(v : string, start : int, end : int, chars : string) -> int {
	if (start >= end) end
	else if (strIndexOf(chars, getCharAt(v, start)) != -1) start
	else iniFindAny(v, start + 1, end, chars);
}

// The first "\n" at or after pos, or the text length when there is none. known is an earlier
// answer, still valid while pos has not passed it, so no stretch of text is searched twice
iniLineEnd(v : string, pos : int, known : int) -> int {
	if (pos <= known) {
		known
	} else {
		nl = strRangeIndexOf(v, "\n", pos, strlen(v));
		if (nl == -1) strlen(v) else nl
	}
}

// The start of the line after lineEnd; a last line without "\n" is read from pos itself
iniNextLine(pos : int, lineEnd : int, n : int) -> int {
	if (lineEnd == n) pos else lineEnd + 1
}

iniFile2string(v : IniFile) -> string {
	quotedNames = exists(v.sections, \s -> strFindFirstOf(s.name, "]\n\u000d") != -1
		|| exists(s.keys, \kv -> strFindFirstOf(kv.key, "=[;\n\u000d") != -1 || iniHasEdgeSpace(kv.key)));
	initial = if (quotedNames) Cons(iniQuotedNamesMarker + "\n", makeList()) else makeList();
	list2string(fold(v.sections, initial, \acc, s -> {
		header = Cons("[" + (if (quotedNames) quoteIni(s.name) else s.name) + "]\n", acc);
		keys = fold(s.keys, header, \acc2, kv -> Cons((if (quotedNames) quoteIni(kv.key) else kv.key) + "=" + escapeIni(kv.value) + "\n", acc2));
		Cons("\n", keys)
	}));
}

// Whether a char from iniKeySpace starts or ends s, which trimming would lose
iniHasEdgeSpace(s : string) -> bool {
	s != "" && (strIndexOf(iniKeySpace, getCharAt(s, 0)) != -1 || strIndexOf(iniKeySpace, getCharAt(s, strlen(s) - 1)) != -1);
}

// Names and values share one quoting convention; backslashes are not escape characters.
quoteIni(s : string) -> string {
	"\"" + strReplace(s, "\"", "\"\"") + "\"";
}

// A value is quoted when it holds a quote or a line break, or has spaces at either end: read back
// unquoted, a line break would end it and could start a key or a section of its own
escapeIni(s : string) -> string {
	if (strFindFirstOf(s, "\"\n\u000d") != -1 || trim(s) != s)  {
		quoteIni(s);
	} else s;
}

