import mediabunny/mediabunny;
import runtime;
import fs/filesystem;
import ds/arrayutils;
import math/math;

reportMedia(label : string, expectedDuration : double, file : native) -> void {
	mbGetMediaDuration(file, \duration -> {
		mbGetVideoInfo(file, \w, h, bitrate -> {
			ok = abs(i2d(duration) - expectedDuration) < 1.0;
			println((if (ok) "PASS " else "FAIL ") + label
				+ ": duration=" + i2s(duration) + " expected~" + d2s(expectedDuration)
				+ " video=" + i2s(w) + "x" + i2s(h) + " bitrate=" + i2s(bitrate));
		})
	})
}

loadCopies(url : string, name : string, n : int, cb : ([native]) -> void) -> void {
	mapiAsync(arrayRepeat(url, n), \i, u, ff, rr -> makeFileByBlobUrl(u, name + "_" + i2s(i) + "." + takeAfterLast(url, ".", ""), ff, rr),
		cb, \err -> println("FAIL load: " + err))
}

main() {
	videoUrl = "./images/material_test/big_buck_bunny.mp4";

	// 1. Concatenate 3 MP4 videos
	loadCopies(videoUrl, "video", 3, \files -> {
		mbConcatMedia(files, "concat_mp4_x3", \out -> reportMedia("concat mp4 x3", 177.024, out),
			\err -> println("FAIL concat mp4 x3: " + err))
	});

	// 2. Concatenate 2 WAV files produced by conversion
	loadCopies(videoUrl, "audio", 2, \files -> {
		mapiAsync(files, \i, f, ff, rr -> mbConversion(f, MBAudioWAV(), [], ff, rr), \wavs -> {
			mbConcatMedia(wavs, "concat_wav_x2", \out -> reportMedia("concat wav x2", 117.974, out),
				\err -> println("FAIL concat wav x2: " + err))
		}, \err -> println("FAIL wav conversion: " + err))
	});

	// 3. Single file passthrough
	loadCopies(videoUrl, "single", 1, \files -> {
		mbConcatMedia(files, "concat_single", \out -> reportMedia("concat single", 59.008, out),
			\err -> println("FAIL concat single: " + err))
	});
}
