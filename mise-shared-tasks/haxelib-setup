#!/usr/bin/env bash
#MISE description="Install the Haxe libraries listed in flow9's mise-shared-tasks/haxelib.txt"
#
# The libraries go to .haxelib/ in the flow9 checkout this script is in, also
# when a project that includes flow9's mise-shared-tasks runs it. mise-shared.toml
# points HAXELIB_PATH at the same folder.
#
# A rerun with an unchanged list does nothing: the script keeps a copy of the
# list it installed and compares. It does not use mise's sources/outputs, since
# mise resolves those against the project the task is run from, not against
# flow9. To force a reinstall, delete .haxelib/.

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIST="$SCRIPT_DIR/haxelib.txt"

export HAXELIB_PATH="$(dirname "$SCRIPT_DIR")/.haxelib"
INSTALLED="$HAXELIB_PATH/.installed-haxelib.txt"

if cmp -s "$LIST" "$INSTALLED"; then
  echo "Haxe libraries in $HAXELIB_PATH match haxelib.txt, nothing to do"
  exit 0
fi

# haxelib does not create the folder, and fails without it.
mkdir -p "$HAXELIB_PATH"
# A failed run must not look complete.
rm -f "$INSTALLED"

while IFS=' ' read -r lib version; do
  [[ -z "$lib" || "$lib" =~ ^[[:space:]]*# ]] && continue

  echo "Installing $lib version $version..."
  if ! haxelib install --quiet "$lib" "$version" </dev/null; then
    echo "Failed to install $lib version $version" >&2
    exit 1
  fi
done <"$LIST"

cp "$LIST" "$INSTALLED"
