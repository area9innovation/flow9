#!/bin/bash

# Builds tools/flowc/flowc.jar with the flowc.jar currently in the repo (flowc1).
# Works from any directory and needs nothing on PATH but java (a JDK no newer than
# the oldest one the committed jar must run on - see check_java_version.java;
# mise.toml at the repo root pins it).
# If the old jar can compile the sources but the new one is broken, recover with
#   git restore tools/flowc/flowc.jar
# or keep working with bin/flowc, which runs the compiler sources without a jar but
# needs the native flowcpp (bin/setup-linux).

set -e

SCRIPT_DIR=$( cd "$( dirname "$0" )" && pwd -P )

BASE_DIR=$( cd "$( dirname "$SCRIPT_DIR" )" && pwd -P )

cd "$BASE_DIR"

if ! command -v java > /dev/null; then
    echo "java not found. Run 'mise install' in $BASE_DIR, or put a JDK 21 on PATH." >&2
    exit 1
fi

echo ""
echo "Compiling 'Flowc'"
echo "================="
echo ""

echo "* Checking java version"
java "$SCRIPT_DIR/check_java_version.java"

if [ -f tools/flowc/flowc.jar ]; then
    echo "* Stop running flowc server"
    "$SCRIPT_DIR/flowc1" server-shutdown=1
fi

echo "* Preparing version information"
echo "  -----------------------------"
echo ""

VERSION_FILE=tools/flowc/flowc_version.flow
VERSION_BACKUP=$(mktemp)
cp "$VERSION_FILE" "$VERSION_BACKUP"
# A failed build must not leave the version file rewritten.
trap 'cp "$VERSION_BACKUP" "$VERSION_FILE"; rm -f flowc_1.jar flowc_2.jar' ERR
trap 'rm -f "$VERSION_BACKUP"' EXIT

cat <<EOF > "$VERSION_FILE"
// This file is autogenerated.
// Edit 'build-flowc' instead.
export {
	flowc_version = "$(cat tools/flowc/flowc.version)";
	flowc_git_revision = "$(git rev-parse --short HEAD)";
}
EOF

# Natives compiled by an earlier build would otherwise end up in the jar.
rm -f platforms/java/com/area9innovation/flow/*.class

"$SCRIPT_DIR/flowc1" jar=flowc_1 tools/flowc/flowc.flow

# A new jar which cannot compile its own sources would break the next build-flowc,
# so it replaces the old one only once it has done that - from scratch, without the
# compile server or the incremental files of the build above.
echo "* Checking that the new flowc compiles itself"
java -jar -Xss32m -Xms256m "-Xmx${FLOWC_XMX:-8g}" flowc_1.jar server=0 incremental=0 jar=flowc_2 tools/flowc/flowc.flow
rm flowc_2.jar

mv flowc_1.jar tools/flowc/flowc.jar
