export {
	// Globals which the `env` option is expected to replace.
	A9_S : string = "default-s";
	A9_I : int = 0;
	A9_D : double = 0.0;
	A9_B : bool = false;

	// Globals which are shadowed locally elsewhere. The `env` value must reach the
	// global references only, never a local binding of the same name.
	A9_ARG : string = "global-arg";
	A9_LET : string = "global-let";
}
