import runtime;

Mode ::= ModeA, ModeB;
	ModeA();
	ModeB();

// A global whose type is not one of bool/int/double/string, used only as the subject of a
// switch. The subject of a switch must stay a variable, so this is the one position where
// a substitution would have to be refused rather than performed - see runtest.py.
A9_BAD_TYPE : Mode = ModeA();

readMode() -> string {
	switch (A9_BAD_TYPE) {
		ModeA(): "a";
		ModeB(): "b";
	}
}

main() -> void {
	println(readMode());
}
