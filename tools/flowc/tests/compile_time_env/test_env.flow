import string;
import maybe;
import test_env_globals;

globals() -> string {
	A9_S + "|" + i2s(A9_I) + "|" + d2s(A9_D) + "|" + b2s(A9_B);
}

// A function argument shadows the global.
shadowedByArg(A9_ARG : string) -> string {
	A9_ARG;
}

// A lambda argument shadows the global.
shadowedByLambdaArg() -> string {
	f = \A9_ARG : string -> A9_ARG;
	f("lambda-arg-value");
}

// A `let` shadows the global; the global is still read before and after it.
shadowedByLet() -> string {
	before = A9_LET;
	inner = {
		A9_LET = "let-value";
		A9_LET;
	};
	before + "|" + inner + "|" + A9_LET;
}

// A switch case binding named in `env` but with no global definition: `env` must not
// touch it. (flowc rejects a case binding which shadows a global, so this is the only
// shape a case binding of an `env` name can take.)
inCaseBinding(m : Maybe<string>) -> string {
	switch (m) {
		Some(A9_CASE): A9_CASE;
		None(): "none";
	}
}

// A `let` named in `env` but with no global definition: `env` must ignore it entirely.
notAGlobal() -> string {
	A9_NO_GLOBAL = "local-only-value";
	A9_NO_GLOBAL;
}

main() -> void {
	println(globals());
	println(shadowedByArg("arg-value"));
	println(shadowedByLambdaArg());
	println(shadowedByLet());
	println(inCaseBinding(Some("case-value")));
	println(notAGlobal());
}
