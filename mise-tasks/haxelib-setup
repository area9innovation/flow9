#!/usr/bin/env bash
#MISE description="Install the Haxe libraries listed in mise-tasks/haxelib.txt"
#MISE sources=["mise-tasks/haxelib.txt"]
#MISE outputs={auto=true}
#
# sources/outputs make a rerun with an unchanged list a no-op.
#
# The libraries go to .haxelib/ in the checkout. haxelib prefers that directory
# to the user's own repository whenever it runs from the checkout root, so a
# checkout that never ran this task keeps using the libraries its user installed.

set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

export HAXELIB_PATH="$(dirname "$SCRIPT_DIR")/.haxelib"
mkdir -p "$HAXELIB_PATH"

while IFS=' ' read -r lib version; do
  [[ -z "$lib" || "$lib" =~ ^[[:space:]]*# ]] && continue

  echo "Installing $lib version $version..."
  if ! haxelib install --quiet "$lib" "$version" </dev/null; then
    echo "Failed to install $lib version $version" >&2
    exit 1
  fi
done <"$SCRIPT_DIR/haxelib.txt"
