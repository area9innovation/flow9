#!/usr/bin/env bash
#MISE description="Make haxelib find libneko (runs as haxe postinstall, safe to rerun)"
#
# haxe itself doesn't need neko, but haxelib does, and doesn't know where it is
# (Linux: no RUNPATH, macOS: only /usr/local/lib). haxe runs `haxelib path` for every -lib.
# So move the real binary to haxelib.bin and put a wrapper in its place that sets
# the library path for haxelib only, instead of LD_LIBRARY_PATH for the whole shell.
#
# Called from the haxe postinstall in mise.toml with MISE_TOOL_INSTALL_PATH set.
# Run it manually with `mise run haxelib-patch` if haxelib complains about libneko.

set -euo pipefail
IFS=$'\n\t'

# Full backend names on purpose: plain "haxe"/"neko" may resolve to leftover installs from another backend.
dir="${MISE_TOOL_INSTALL_PATH:-$(mise where github:HaxeFoundation/haxe)}"
neko="$(mise where github:HaxeFoundation/neko)"
marker="# Generated by mise-tasks/haxelib-patch."

if [[ ! -e "$dir/haxelib.bin" ]]; then
  if grep -qF "$marker" "$dir/haxelib"; then
    echo "$dir/haxelib is a wrapper but haxelib.bin is gone. Reinstall: mise install -f github:HaxeFoundation/haxe" >&2
    exit 1
  fi
  mv "$dir/haxelib" "$dir/haxelib.bin"
fi

# Both live in <installs>/<tool>/<version>. Relative, so moving the mise data dir doesn't break it.
installs="${dir%/*/*}"
if [[ "$neko" != "$installs"/* ]]; then
  echo "neko ($neko) is not next to haxe ($dir)" >&2
  exit 1
fi

# Rewritten every time, so a neko bump is picked up.
{
  echo '#!/bin/sh'
  echo "$marker The real haxelib is haxelib.bin."
  echo "neko_rel='../../${neko#"$installs"/}'"
  cat <<'EOF'
here=$(cd "$(dirname "$0")" && pwd)
neko="$here/$neko_rel"
# Linux reads LD_LIBRARY_PATH, macOS DYLD_LIBRARY_PATH.
LD_LIBRARY_PATH="$neko${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
DYLD_LIBRARY_PATH="$neko${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}" \
  exec "$here/haxelib.bin" "$@"
EOF
} >"$dir/haxelib"
chmod +x "$dir/haxelib"

# Fail here rather than on the first -lib in a build.
"$dir/haxelib" version >/dev/null
echo "haxelib -> ${neko#"$installs"/}"
