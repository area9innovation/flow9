import material/extra/filesystem/localfilesystem_extended_api;

main() {
	api = localFilesystemExtAPI();
	check = \move, src, folder, success -> {
		calls = ref [];
		op = if (move) api.moveElement else api.copyElement;
		op(src, folder, \-> calls := concat(^calls, ["done"]), \err -> calls := concat(^calls, [if (err == "") "empty error" else "error"]));
		^calls == [if (success) "done" else "error"];
	};
	ok = check(false, "odd.dat", "out", true) && fileExists("odd.dat") &&
		check(false, "empty.dat", "out/", true) && fileExists("empty.dat") &&
		check(true, "large.dat", "out", true) && !fileExists("large.dat") &&
		check(false, "missing.dat", "out", false) && check(true, "missing.dat", "out", false) &&
		check(false, "blocked.dat", "out", false) && check(true, "blocked.dat", "out", false) &&
		check(true, "odd.dat", ".", false) && fileExists("blocked.dat") &&
		check(false, "alias-src/item", "alias-parent", false) && check(true, "alias-src/item", "alias-parent", false) &&
		check(false, "alias-src/item", "hardlink-dir", false) && check(true, "alias-src/item", "hardlink-dir", false) &&
		check(false, "alias-src", "alias-child", false) && check(true, "alias-src", "alias-child", false) &&
		check(false, "alias-src/item", "alias-out", true) &&
		check(false, "dir-link", "out", false) && check(true, "dir-link/", "out", false) &&
		check(false, "linked-tree", "out", false) && check(true, "linked-tree", "out", false) &&
		check(false, "tree", "tree/sub", false) && check(false, "tree", "copy-out", true) &&
		check(true, "tree", "out", true) && !fileExists("tree") &&
		!copyFile("missing.dat", "out/odd.dat");
	println(if (ok) "Local file contracts passed" else "Local file contracts failed");
	quit(if (ok) 0 else 1);
}
