import sys/system;
import fs/filesystem;
import text/binary;

// Run in a temporary directory with an isolated local store, with and without JIT.
checkCopy(name : string, bytes : string) -> bool {
	dest = name + ".copy";
	setFileContentBytes(name, bytes) && copyFile(name, dest) &&
		fileSize(dest) == i2d(strlen(bytes)) && getFileContentBinary(dest) == getFileContentBinary(name)
}

main() {
	copied = checkCopy("odd.dat", "ABC") && checkCopy("even.dat", "\u0000\u00ffAB") &&
		checkCopy("large.dat", strRepeat("\u00ff\u0000Z", 50001)) && checkCopy("empty.dat", "") &&
		!copyFile("missing.dat", "odd.dat.copy") && contains(readDirectory("."), "large.dat.copy");
	values = generate(0, 70000, \i -> i);
	key = "file-contracts";
	stored = setKeyValue(key, toBinary(values)) && contains(getKeysList(), key) &&
		deserializeBinary(getKeyValue(key, ""), flow([])) == flow(values) &&
		setKeyValue(key, "") && getKeyValue(key, "default") == "";
	removeKeyValue(key);
	ok = copied && stored && getKeyValue(key, "default") == "default";
	println(if (ok) "File contracts passed" else "File contracts failed");
	quit(if (ok) 0 else 1);
}
