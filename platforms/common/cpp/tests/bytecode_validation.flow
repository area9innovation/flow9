import runtime;

Item ::= Number, Other;
Number(mutable value : int, nested : [[int]]);
Other(mutable value : int);

countdown(n : int, acc : int) -> int {
	if (n == 0) acc else countdown(n - 1, acc + 1)
}

addOne(n : int) -> int { n + 1 }

makeCounter(start : int) -> (int) -> int {
	\n -> {
		local = countdown(n, 0);
		addOne(local) + start;
	}
}

update(item : Item, value : int) -> int {
	item.value ::= value;
	item.value
}

itemTotal(item : Item) -> int {
	switch (item) {
		Number(n, nested): n + nested[0][0];
		default: 0;
	}
}

main() {
	count = makeCounter(34);
	item = Number(0, [[3]]);
	other = Other(5);
	println(update(item, count(4)) == 39 && update(other, 7) == 7
		&& itemTotal(item) == 42 && itemTotal(other) == 0);
	println("Flow ✓");
}
