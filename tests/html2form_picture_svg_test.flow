import formats/html/html2form;

// Compile with bin/flowc1 html=picture.html tests/html2form_picture_svg_test.flow
// and open picture.html?renderer=html in Chrome. The tab title reports success.
checkPicture(url : string, remaining : int) -> void {
	if (isSome(getCachedPictureSize(url))) {
		assertEquals(getCachedPictureSize(url), Some(WidthHeight(24.0, 16.0)));
		markup = getClipHTML(getStage());
		assert(strContains(markup, "<img") && !strContains(markup, "<image "), "expected an image widget, not embedded SVG elements");
		setWindowTitle("SVG picture test passed");
	} else {
		assert(remaining > 0, "picture did not load");
		timer(50, \ -> checkPicture(url, remaining - 1));
	}
}

main() {
	// A legacy SVG embeds a one-pixel PNG with the historical img/png media type.
	// Use a data URL so the browser test is independent of an image server.
	png = "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC";
	svg = "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"24\" height=\"16\">"
		+ "<image width=\"24\" height=\"16\" preserveAspectRatio=\"none\" xlink:href=\"data:img/png;base64," + png + "\"/></svg>";
	url = "data:image/svg+xml;base64," + encodeBase64(svg) + "#picture.svg";
	render(html2form("<img src=\"" + url + "\"/>", makeTree(), []));
	checkPicture(url, 100);
}
