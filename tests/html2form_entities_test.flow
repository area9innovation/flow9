import formats/html/html2form;

main() {
	// A Form text field consumes HTML references. Read the text fragments
	// after layout and decode them once, as the text field does.
	text = \s -> {
		form = html2form(s, makeTree(), []);
		r = renderForm(form, const(WidthHeight(400.0, 100.0)), [], []);
		value = unescapeHtml2(trim(getFormText(form)));
		applyall(r.disposers);
		value
	};
	assertEquals(text("A&neq;B"), "A\u2260B");
	assertEquals(text("dis&shy;cretionary"), "dis\u00ADcretionary");
	assertEquals(text("&amp;neq;"), "&neq;");
	println("html2form entity tests passed");
	quit(0);
}
