import string;
import sys/target;

// Tests the control-character escapes of toStringForJson on every target.

main() {
	failures = fold(enumFromTo(0x0E, 0x1F), 0, \acc, code -> {
		hex = getCharAt("0123456789abcdef", code / 16) + getCharAt("0123456789abcdef", code % 16);
		expected = "\"\\u00" + hex + "\"";
		actual = toStringForJson(fromCharCode(code));
		if (actual == expected) acc else {
			println("FAIL: code " + i2s(code) + " gives " + actual + ", expected " + expected);
			acc + 1;
		}
	});
	println(if (failures == 0) "toStringForJson tests are OK in " + getTargetName() else i2s(failures) + " toStringForJson tests FAILED");
	quit(failures);
}
