import formats/uri2/uri2;
import sys/target;

// uri2string and uri2hostString in lib/formats/uri2/uri2.flow put the user
// information in front of the host and end it with '@', as RFC 3986 (3.2)
// writes it. They used to put it after the host with ':', so the port and
// the user ran together. URLs without user information come out as before.
// tests/uri_userinfo_test.flow checks the same in lib/formats/uri/uri.flow.

failures : ref int = ref 0;

check(name : string, actual : string, expected : string) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + toString(expected));
		println("  actual:   " + toString(actual));
	}
}

roundTrip(name : string, url : string) -> void {
	check(name, uri2string(parseURI(url)), url);
}

testUri2string() -> void {
	roundTrip("user and port", "http://user@host.test:8080/p?q=1#f");
	roundTrip("user and password", "http://user:pw@host.test/");
	roundTrip("encoded user and password", "https://u%40x:p%3Aw@h.test/");
	roundTrip("user without a path", "ftp://anon@ftp.test");
	roundTrip("no user", "http://host.test:8080/a?b=c#d");
	roundTrip("file url", "file:///usr/x");
	roundTrip("relative reference", "/rel/x?y=1");
	check("built by hand",
		uri2string(URI("https", URIAuthority("me", "example.test", "443"), "/x", "", "")),
		"https://me@example.test:443/x"
	);
}

testUri2hostString() -> void {
	check("host with user and port", uri2hostString(parseURI("http://user@host.test:8080/p?q=1")), "http://user@host.test:8080/");
	check("host with user and password", uri2hostString(parseURI("http://user:pw@host.test/a")), "http://user:pw@host.test/");
	check("host without user", uri2hostString(parseURI("http://host.test:8080/a")), "http://host.test:8080/");
	check("host without port", uri2hostString(parseURI("https://host.test/a/b")), "https://host.test/");
}

main() {
	testUri2string();
	testUri2hostString();

	if (^failures == 0) {
		println("uri2 userinfo tests: all passed in " + getTargetName());
		quit(0);
	} else {
		println(i2s(^failures) + " uri2 userinfo test(s) failed in " + getTargetName());
		quit(1);
	}
}
