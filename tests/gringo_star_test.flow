import text/gringo/dcode_lib;
import tools/gringo/gringo_parse;
import sys/target;

// Checks that a gringo star ends when an iteration matches without consuming
// input, both in the compiled parser runtime (parseStar in
// lib/text/gringo/dcode_lib.flow) and in the interpreter (GStar in
// lib/tools/gringo/gringo_parse.flow).
//
// A star over something that can match the empty string, such as ("a"?)* or
// (ws)* with ws = " "*, used to match the empty string again and again and
// never return. Now it stops there, and the empty iteration leaves no output
// and no error.
//
// The compiled checks give up after a fixed number of matcher calls, so they
// fail rather than hang on the old code. The interpreter checks, apart from the
// control "a"*, count the iterations of their stars and stop the run on the old
// code with an error that names the check.

failures : ref int = ref 0;

check(name : string, actual : string, expected : string) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + toString(expected));
		println("  actual:   " + toString(actual));
	}
}

maxCalls = 1000;

textAction = GringoAction(\o : string, v -> o + "[" + v + "]", \o : string, m -> o + "<" + m + ">");

makeAcc(input : string) -> DParseAcc<string> {
	DParseAcc(input, textAction, 0, "", makeTree(), makeList(), 0, 0);
}

// Runs parseStar and reports the result, the number of matcher calls and where it stopped
runStar(input : string, matcher : (DParseAcc<string>) -> bool) -> string {
	acc = makeAcc(input);
	calls = ref 0;
	r = parseStar(acc, \ -> {
		calls := ^calls + 1;
		^calls <= maxCalls && matcher(acc)
	});
	"result " + b2s(r) + ", calls " + i2s(^calls) + ", i " + i2s(acc.i)
	+ ", checkpoints left " + i2s(countList(acc.stack)) + showErrors(acc.errors) + ", output " + acc.output;
}

showErrors(errors : Tree<int, string>) -> string {
	if (isEmptyTree(errors)) ""
	else ", errors " + strGlue(map(tree2pairs(errors), \p -> i2s(p.first) + ": " + p.second), ", ");
}

// What the compiler produces for "a"?
optionalA(acc : DParseAcc<string>) -> bool {
	pushDCheckpoint(acc);
	if (matchString(acc, "a")) discardDCheckpoint(acc) else restoreDCheckpoint(acc);
	true;
}

testCompiledStar() -> void {
	check("an empty match ends the star at once",
		runStar("abc", \__ -> true),
		"result true, calls 1, i 0, checkpoints left 0, output "
	);
	check("(\"a\"?)* takes the a's and stops at the first non-a",
		runStar("aab", optionalA),
		"result true, calls 3, i 2, checkpoints left 0, output "
	);
	check("(\"a\"?)* stops at the end of the input",
		runStar("aa", optionalA),
		"result true, calls 3, i 2, checkpoints left 0, output "
	);
	check("the empty iteration leaves no output",
		runStar("aab", \acc -> {
			optionalA(acc);
			addVerbatim(acc, "x")
		}),
		"result true, calls 3, i 2, checkpoints left 0, output [x][x]"
	);
	// (#"b" "a"?)*: the second iteration reports the missing b and takes an a, the third takes nothing
	check("an error from the empty iteration is dropped",
		runStar("baa", \acc -> {
			(matchString(acc, "b") || addParseError(acc, "Expected \"b\"")) && optionalA(acc)
		}),
		"result true, calls 3, i 3, checkpoints left 0, errors 2: Expected \"b\", output "
	);
	check("a star that only fails is unchanged",
		runStar("aab", \acc -> matchString(acc, "a")),
		"result true, calls 3, i 2, checkpoints left 0, output "
	);
	check("a star over nothing matches nothing",
		runStar("", optionalA),
		"result true, calls 1, i 0, checkpoints left 0, output "
	);
}

// A test cannot stop the interpreter inside a parse. So the stars below start each
// iteration with a tick, an action that leaves no output, and the run fails when
// one parse ticks more than maxCalls times.
tickedStar(term : GTerm) -> GTerm {
	GStar(GSeq(GUnquote(GString("tick")), term));
}

// Passes the name of the check on, so that a run stopped by a star says which check it was
checkInterpreted(name : string, input : string, term : GTerm, expected : string) -> void {
	check(name, interpret(name, input, term), expected);
}

interpret(name : string, input : string, term : GTerm) -> string {
	ticks = ref 0;
	action = GringoAction(\o : string, v -> {
		if (v == "tick") {
			ticks := ^ticks + 1;
			if (^ticks > maxCalls) fail(name + ": an interpreted star did not end after " + i2s(maxCalls) + " iterations");
			o;
		} else textAction.addVerbatim(o, v)
	}, textAction.addMatched);
	env = GringoEnv(input, makeTree(), action, "", makeTree(), 0, false, 0);
	r = gringoParse(env, term);
	"fail " + b2s(r.fail) + ", i " + i2s(r.i) + showErrors(r.errors) + ", output " + r.output;
}

testInterpretedStar() -> void {
	a = GString("a");
	checkInterpreted("interpreted (\"a\"?)* stops at the first non-a",
		"aab", tickedStar(GOpt(a)),
		"fail false, i 2, output "
	);
	checkInterpreted("interpreted (\"a\"?)* stops at the end of the input",
		"aa", tickedStar(GOpt(a)),
		"fail false, i 2, output "
	);
	checkInterpreted("interpreted empty iteration leaves no output",
		"aab", tickedStar(GSeq(GOpt(a), GUnquote(GString("x")))),
		"fail false, i 2, output [x][x]"
	);
	checkInterpreted("interpreted error from the empty iteration is dropped",
		"baa", tickedStar(GSeq(GError(GString("b")), GOpt(a))),
		"fail false, i 3, errors 2: Expected \"b\", output "
	);
	checkInterpreted("interpreted rule ws = \" \"* inside a star",
		"  b", GRule("ws", GStar(GString(" ")), GSeq(tickedStar(GVar("ws")), GString("b"))),
		"fail false, i 3, output "
	);
	checkInterpreted("interpreted \"a\"* is unchanged",
		"aab", GStar(a),
		"fail false, i 2, output "
	);
}

main() {
	testCompiledStar();
	testInterpretedStar();

	if (^failures == 0) {
		println("gringo star tests: all passed in " + getTargetName());
		quit(0);
	} else {
		println(i2s(^failures) + " gringo star test(s) failed in " + getTargetName());
		quit(1);
	}
}
