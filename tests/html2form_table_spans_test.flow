import formats/html/html2form;

// Recognize the table's Grid by the size inspector installed on each cell.
tableColumns(rows : string) -> int {
	f = html2form("<table>" + rows + "</table>", makeTree(), []);
	r = renderForm(f, const(WidthHeight(400.0, 100.0)), [], []);
	columns = ref 0;
	FindForm(f, \form -> switch (form) {
		Grid(cells): if (length(cells) > 0 && length(cells[0]) > 0) switch (cells[0][0]) {
			Inspect(inspectors, __): if (containsStruct(inspectors, ISize(makeWH()))) {
				columns := length(cells[0]); true
			} else false;
			default: false;
		} else false;
		default: false;
	});
	applyall(r.disposers);
	^columns
}

main() {
	assertEquals(tableColumns("<tr><td colspan=\"2\" rowspan=\"2\">A</td></tr><tr><td>B</td></tr>"), 3);
	assertEquals(tableColumns("<tr><td colspan=\"0\">A</td><td colspan=\"-2\">B</td></tr>"), 2);
	assertEquals(tableColumns("<tr><td colspan=\"1001\">A</td><td>B</td></tr>"), 1001);
	// Individually valid spans can still describe a mostly empty dense grid.
	assertEquals(tableColumns("<tr><td colspan=\"1000\">A</td></tr>" + strRepeat("<tr><td>B</td></tr>", 69)), 0);
	println("html2form table span tests passed");
	quit(0);
}
