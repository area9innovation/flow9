import string;
import sys/target;

// Normal substring matching at positions and within half-open ranges.

check(name : string, ok : bool) -> void {
	if (!ok) fail(name);
}

main() {
	text = "éabcabc";
	check("match at the beginning", strContainsAt(text, 0, "éa"));
	check("match at the end", strContainsAt(text, 4, "abc"));
	check("mismatch at a valid position", !strContainsAt(text, 1, "b"));
	check("substring does not fit", !strContainsAt(text, 5, "abc"));
	check("single character in range", strRangeIndexOf(text, "a", 2, 5) == 4);
	check("multi-character match at the right boundary", strRangeIndexOf(text, "abc", 2, 7) == 4);
	check("incomplete match at the right boundary", strRangeIndexOf(text, "abc", 2, 6) == -1);
	check("no nonempty match in an empty range", strRangeIndexOf(text, "a", 1, 1) == -1);
	check("empty substring in a nonempty range", strRangeIndexOf(text, "", 0, 7) == 0);
	check("end clipped to the string length", strRangeIndexOf(text, "abc", 2, 9) == 4);
	check("whole-string search", strIndexOf(text, "abc") == 1);
	if (cpp && !hasTargetName("cpp3")) {
		end = strlen(text);
		check("empty substring matches the empty string", strContainsAt("", 0, ""));
		check("empty substring matches at the end", strContainsAt(text, end, ""));
		check("empty substring before the start", !strContainsAt(text, -1, ""));
		check("empty substring past the end", !strContainsAt(text, end + 1, ""));
		check("reversed range", strRangeIndexOf(text, "a", 4, 2) == -1);
		check("negative end searches to the end", strRangeIndexOf(text, "abc", 2, -1) == 4);
		check("empty search in the empty string returns zero", strRangeIndexOf("", "", 0, 0) == 0);
		check("empty search at the end returns zero", strRangeIndexOf(text, "", end, end) == 0);
	}
	println("String range tests passed");
	quit(0);
}
