import formats/css/cssterm;

check(label : string, actual : ?, expected : ?) -> void {
	if (actual != expected) {
		println(label + ": expected " + toString(expected) + ", got " + toString(actual));
		quit(1);
	}
}

main() {
	def = 37;
	check("largest whole em", cssTerm2int(CssEm(CssInt(134217727)), def), 2147483632);
	check("em outside int", cssTerm2int(CssEm(CssInt(134217728)), def), def);
	check("negative endpoint", cssTerm2int(CssNegate(CssEm(CssInt(134217728))), def), intMin);
	check("negative overflow", cssTerm2int(CssNegate(CssEm(CssInt(134217729))), def), def);
	check("negation of intMin", cssTerm2int(CssNegate(CssInt(intMin)), def), def);
	check("positive endpoint", cssTerm2int(CssDouble(2147483647.4), def), intMax);
	check("round past positive endpoint", cssTerm2int(CssDouble(2147483647.5), def), def);
	check("negative half rounds up", cssTerm2int(CssDouble(-42.5), def), -42);
	check("nonfinite", cssTerm2int(CssDouble(1.0/0.0), def), def);
	check("NaN", cssTerm2int(CssDouble(0.0/0.0), def), def);
	check("negative endpoint from wide double", cssTerm2int(CssNegate(CssDouble(2147483648.0)), def), intMin);
	check("integer em keeps rounding before scaling", cssTerm2int(CssEm(CssDouble(1.75)), def), 32);
	check("integer percentage rounds after scaling", cssTerm2int(CssPercentage(CssDouble(0.375)), 5), 2);
	check("positive channels only", cssTerm2int(CssList([CssInt(-1), CssInt(0x34), CssInt(0x56), CssInt(99)]), def), 0x3456);
	check("RGB sum outside int", cssTerm2int(CssList([CssInt(32768)]), def), def);
	check("wide ignored fourth channel", cssTerm2int(CssList([CssInt(1), CssInt(2), CssInt(3), CssEm(CssInt(intMax))]), def), 0x010203);
	check("nested fallback", cssTerm2int(CssNegate(CssName("unknown")), def), -def);
	check("inherit int", cssTerm2int(CssInherit(), def), -1);
	check("inherit double", cssTerm2double(CssInherit(), 2.0), 0.0);
	check("list is not a double", cssTerm2double(CssList([]), 2.0), 2.0);
	large = s2d("1e200");
	check("double percentages keep evaluation order", cssTerm2double(CssPercentage(CssPercentage(CssDouble(1.0/large))), large), large);

	// Exercise public constructors directly, including a list used as a channel of another list.
	term : CssTerm = foldRange(1, 64, CssInt(7), \t : CssTerm, __ -> CssList([CssInt(0), CssInt(0), CssNegate(CssNegate(CssPx(t)))]));
	check("composed RGB lists", cssTerm2int(term, def), 7);
	units : CssTerm = foldRange(1, 64, CssDouble(1.25), \t : CssTerm, __ -> CssPt(CssDeg(CssNegate(t))));
	check("composed units", cssTerm2double(CssEm(units), 0.0), 20.0);
	println("CSS numeric term tests passed");
	quit(0);
}
