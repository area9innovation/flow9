import dynamic;
import runtime;

TypedFields(numbers : [int], texts : [[string]], cell : ref [bool]);
GenericFields(value : ?, values : [?], cell : ref ?);
FlowFields(value : flow, values : [flow], cell : ref flow);
FunctionField(fn : (int) -> int);
UnionFields(value : Maybe<int>, values : [Maybe<int>]);
StructField(pair : Pair<int, int>);
FieldDefault();

failures = ref 0;

check(name : string, actual : flow, expected : flow) -> void {
	if (toString(actual) != toString(expected)) {
		println("FAIL: " + name + ": " + toString(actual));
		failures := ^failures + 1;
	}
}

main() {
	defaultValue = flow(FieldDefault());
	valid = TypedFields([1, 2], [["a"], []], ref [true, false]);
	check("valid typed fields", makeStructValue("TypedFields", [flow([1, 2]), flow([["a"], []]), flow(ref [true, false])], defaultValue), flow(valid));
	check("invalid array element", makeStructValue("TypedFields", [flow(["x"]), flow([["a"]]), flow(ref [true])], defaultValue), defaultValue);
	check("invalid nested array element", makeStructValue("TypedFields", [flow([1]), flow([[2]]), flow(ref [true])], defaultValue), defaultValue);
	check("invalid later nested element", makeStructValue("TypedFields", [flow([1]), flow([flow(["a"]), flow([2])]), flow(ref [true])], defaultValue), defaultValue);
	check("invalid ref payload", makeStructValue("TypedFields", [flow([1]), flow([["a"]]), flow(ref [1])], defaultValue), defaultValue);
	check("invalid ref shape", makeStructValue("TypedFields", [flow([1]), flow([["a"]]), flow([true])], defaultValue), defaultValue);
	check("field count", makeStructValue("TypedFields", [], defaultValue), defaultValue);
	check("empty typed arrays", makeStructValue("TypedFields", [flow([]), flow([[]]), flow(ref [])], defaultValue), flow(TypedFields([], [[]], ref [])));
	check("generic int fields", makeStructValue("GenericFields", [flow(1), flow([2]), flow(ref 3)], defaultValue), flow(GenericFields(1, [2], ref 3)));
	check("generic string fields", makeStructValue("GenericFields", [flow("a"), flow(["b"]), flow(ref "c")], defaultValue), flow(GenericFields("a", ["b"], ref "c")));
	check("generic arrays still require array shape", makeStructValue("GenericFields", [flow(1), flow(2), flow(ref 3)], defaultValue), defaultValue);
	check("generic refs still require ref shape", makeStructValue("GenericFields", [flow(1), flow([2]), flow(3)], defaultValue), defaultValue);
	check("unconstrained flow fields", makeStructValue("FlowFields", [flow("a"), flow([flow(1), flow(true)]), flow(ref flow(["b"]))], defaultValue), flow(FlowFields(flow("a"), [flow(1), flow(true)], ref flow(["b"]))));
	fn = \x : int -> x + 1;
	check("function fields", makeStructValue("FunctionField", [flow(fn)], defaultValue), flow(FunctionField(fn)));
	check("union members", makeStructValue("UnionFields", [flow(Some(1)), flow([flow(None()), flow(Some(2))])], defaultValue), flow(UnionFields(Some(1), [None(), Some(2)])));
	check("struct outside the union", makeStructValue("UnionFields", [flow(Pair(1, 2)), flow([])], defaultValue), defaultValue);
	check("struct outside the union in an array", makeStructValue("UnionFields", [flow(None()), flow([flow(Pair(1, 2))])], defaultValue), defaultValue);
	check("named struct", makeStructValue("StructField", [flow(Pair(1, 2))], defaultValue), flow(StructField(Pair(1, 2))));
	check("other struct for a named struct", makeStructValue("StructField", [flow(Some(1))], defaultValue), defaultValue);
	if (^failures == 0) println("Java struct field type tests passed") else println("Java struct field type tests failed");
	quit(^failures);
}
