import formats/xml;
import sys/target;
import math/math;

// Tests of xmlUnescape (lib/formats/xml.flow): one pass, each reference decoded once,
// only XML characters decoded. The performance test checks that decoding scales linearly.

failures : ref int = ref 0;

check(name : string, actual : string, expected : string) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + toString(expected) + " " + toString(s2a(expected)));
		println("  actual:   " + toString(actual) + " " + toString(s2a(actual)));
	}
}

testNamedEntities() -> void {
	check("quot", xmlUnescape("&quot;"), "\"");
	check("apos", xmlUnescape("&apos;"), "'");
	check("gt", xmlUnescape("&gt;"), ">");
	check("lt", xmlUnescape("&lt;"), "<");
	check("amp", xmlUnescape("&amp;"), "&");
	check("named in text", xmlUnescape("a&lt;b&gt;c&amp;d&quot;e&apos;f"), "a<b>c&d\"e'f");
	check("adjacent named", xmlUnescape("&lt;&lt;&gt;&gt;"), "<<>>");
	check("plain text", xmlUnescape("no references here"), "no references here");
	check("empty", xmlUnescape(""), "");
}

testNumericReferences() -> void {
	check("decimal", xmlUnescape("&#65;"), "A");
	check("decimal with leading zeros", xmlUnescape("&#0065;"), "A");
	check("hex", xmlUnescape("&#x42;"), "B");
	check("hex digits in both cases", xmlUnescape("&#xFF;&#xff;"), "ÿÿ");
	check("numeric in text", xmlUnescape("x&#65;y&#x42;z"), "xAyBz");
	check("decimal above 0xFFFF", xmlUnescape("&#128512;"), fromCharCode(128512));
	check("hex above 0xFFFF", xmlUnescape("&#x1F600;"), fromCharCode(0x1F600));
	check("named and numeric", xmlUnescape("&lt;&#60;"), "<<");
	check("many leading zeros", xmlUnescape("&#x00000041;&#0000000065;"), "AA");
}

testXmlCharEdges() -> void {
	check("tab newline return", xmlUnescape("&#9;&#xA;&#xD;"), "\t\n\r");
	check("space", xmlUnescape("&#x20;"), " ");
	check("last before surrogates", xmlUnescape("&#xD7FF;"), fromCharCode(0xD7FF));
	check("first after surrogates", xmlUnescape("&#xE000;"), fromCharCode(0xE000));
	check("last of the BMP", xmlUnescape("&#xFFFD;"), fromCharCode(0xFFFD));
	check("last code point", xmlUnescape("&#x10FFFF;"), fromCharCode(0x10FFFF));
	check("last code point, decimal", xmlUnescape("&#1114111;"), fromCharCode(0x10FFFF));
}

testCodesOutsideXmlChar() -> void {
	iter([
		"&#0;", "&#x0;", "&#8;", "&#x1F;", "&#11;", "&#12;",
		"&#xD800;", "&#xDFFF;", "&#55296;", "&#xFFFE;", "&#xFFFF;",
		"&#x110000;", "&#1114112;", "&#4294967356;", "&#x10000003C;", "&#99999999999999999999;",
		"&#x" + strRepeat("f", 4000) + ";", "&#" + strRepeat("9", 4000) + ";"
	], \s -> {
		check("kept as written: " + strLeft(s, 20), xmlUnescape(s), s);
	});
	check("kept in text", xmlUnescape("a&#0;b&#xD800;c"), "a&#0;b&#xD800;c");
}

testDecodedOnce() -> void {
	check("&amp;lt; stays &lt;", xmlUnescape("&amp;lt;"), "&lt;");
	check("&amp;#60; stays &#60;", xmlUnescape("&amp;#60;"), "&#60;");
	check("&amp;amp; stays &amp;", xmlUnescape("&amp;amp;"), "&amp;");
	check("&#38;lt; stays &lt;", xmlUnescape("&#38;lt;"), "&lt;");
	check("&&#97;mp; is &amp;", xmlUnescape("&&#97;mp;"), "&amp;");
}

testIncompleteReferences() -> void {
	iter(["&", "& ", "&foo", "a & b", "&lt", "&amp", "&#12", "&#x12", "&#;", "&#x;", "&#xZZ;", "&#1a;", "&#-5;", "&#X41;", "&#12 and; more"], \s -> {
		check("kept as written: " + s, xmlUnescape(s), s);
	});
	check("kept before a valid reference", xmlUnescape("&#12&#65;"), "&#12A");
}

testRoundTrip() -> void {
	sample = "a<b>c&d\"e'f &amp; &#65; &lt;x&gt; 😀 ÿ";
	check("xmlUnescape(xmlEscape(s)) == s", xmlUnescape(xmlEscape(sample)), sample);
	check("xmlUnescape(xmlEscapeText(s)) == s", xmlUnescape(xmlEscapeText(sample)), sample);
}

// Decodes n distinct references and returns the time taken
// The two parser paths that call xmlUnescape: attribute values always, text nodes only under StandardEscaping; CDATA stays raw
testParserPaths() -> void {
	source = "<a x=\"&lt;&amp;&#65;\" y='&quot;&#x42;'>t&lt;&#66;<![CDATA[&lt;raw]]>u&amp;#60;</a>";
	standard = parseXml2WithStrategy(source, [StandardEscaping()]);
	attributes = getXmlAttributes(standard);
	check("attribute in double quotes", getXmlAttribute(attributes, "x", ""), "<&A");
	check("attribute in single quotes", getXmlAttribute(attributes, "y", ""), "\"B");
	check("text under StandardEscaping, CDATA raw", xml2text(standard), "t<B&lt;rawu&#60;");
	legacy = parseXml2(source);
	check("attribute without StandardEscaping", getXmlAttribute(getXmlAttributes(legacy), "x", ""), "<&A");
	check("text without StandardEscaping", xml2text(legacy), "t&lt;&#66;&lt;rawu&amp;#60;");
}

timeDecode(n : int) -> double {
	// Distinct code points from 256 up: all inside the BMP and below the surrogate range
	codes = enumFromTo(256, 256 + n - 1);
	encoded = concatStrings(map(codes, \c -> "&#" + i2s(c) + ";"));
	start = timestamp();
	decoded = xmlUnescape(encoded);
	time = timestamp() - start;
	check("decode of " + i2s(n) + " distinct references", decoded, concatStrings(map(codes, fromCharCode)));
	println("  decode " + i2s(strlen(encoded)) + " chars with " + i2s(n) + " references: " + d2s(time) + " ms");
	time;
}

testPerformance() -> void {
	small = 5000;
	large = 50000;
	tSmall = timeDecode(small);
	tLarge = timeDecode(large);
	// Linear decoding gives a ratio of about 10, quadratic - about 100
	ratio = tLarge / max(tSmall, 1.0);
	println("  time ratio for " + i2s(large / small) + "x input: " + d2s(roundTo(ratio, 0.1)));
	if (ratio > 40.0) {
		failures := ^failures + 1;
		println("FAIL: decoding does not scale linearly, ratio " + d2s(roundTo(ratio, 0.1)));
	}
}

main() {
	testNamedEntities();
	testNumericReferences();
	testXmlCharEdges();
	testCodesOutsideXmlChar();
	testDecodedOnce();
	testIncompleteReferences();
	testRoundTrip();
	testParserPaths();
	testPerformance();

	if (^failures == 0) {
		println("xmlUnescape tests: all passed in " + getTargetName());
		quit(0);
	} else {
		println(i2s(^failures) + " xmlUnescape test(s) failed in " + getTargetName());
		quit(1);
	}
}
