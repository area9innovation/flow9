import net/http;
import net/url_parameter;

main() {
	url = getUrlParameter("url");
	dest = getUrlParameter("dest");
	done = \ -> { println("download: done"); quit(0) };
	error = \message -> { println("download: error: " + message); quit(1) };
	if (isUrlParameterTrue("headers")) downloadFileBinaryWithHeaders(url, [], dest, done, error)
	else downloadFileBinary(url, dest, done, error);
}
