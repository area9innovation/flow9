import formats/comap;
import formats/comap2;

// tree2comap escapes node text inside CDATA and the XML parser returns CDATA raw,
// so comap2topicTree decodes that text itself, exactly once. Attributes decode in the parser.

failures : ref int = ref 0;

check(name : string, actual : string, expected : string) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + expected);
		println("  actual:   " + actual);
	}
}

main() {
	leaf = TopicTree("child &lt; &#60; <", [], []);
	tree = TopicTree("a<b & c > d \"q\" 'e' &#169; &amp;lt; f", [Pair("label", "v<&>\"'&#65;")], [leaf]);
	back = comap2topicTree(tree2comap(tree));
	check("node text", back.text, tree.text);
	check("attribute feature", toString(back.features), toString(tree.features));
	check("child text", toString(map(back.subtopics, \t -> t.text)), toString([leaf.text]));
	check("whole tree", toString(back), toString(tree));
	check("leaf alone", toString(comap2topicTree(tree2comap(leaf))), toString(leaf));

	if (^failures == 0) {
		println("comap round-trip tests: all passed");
		quit(0);
	} else {
		println(i2s(^failures) + " comap round-trip test(s) failed");
		quit(1);
	}
}
