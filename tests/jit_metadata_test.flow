import runtime;

JitTestValue ::= JitTestEmpty, JitTestNumber;
JitTestEmpty();
JitTestNumber(number : int);

jitTestSeed = ref 3;
jitTestInitialValue = ^jitTestSeed;

jitTestIsEmpty(value : JitTestValue) -> bool {
	switch (value) {
		JitTestEmpty(): true;
		JitTestNumber(__): false;
	}
}

jitTestRead(value : JitTestValue) -> int {
	switch (value) {
		JitTestEmpty(): 0;
		JitTestNumber(number): number;
	}
}

jitTestMakeReader(seed : int) -> (int) -> int {
	// Keep several slots live so the closure captures locals from a larger frame.
	a = seed + 1;
	b = a + 1;
	c = b + 1;
	d = c + 1;
	e = d + 1;
	\n -> a + b + c + d + e + n;
}

main() {
	read = jitTestMakeReader(jitTestInitialValue);
	empty = JitTestEmpty();
	number = JitTestNumber(read(2));
	if (jitTestIsEmpty(empty) && !jitTestIsEmpty(number) && jitTestRead(empty) == 0 && jitTestRead(number) == 32) {
		println("JIT metadata smoke test passed");
		quit(0);
	} else {
		println("JIT metadata smoke test failed");
		quit(1);
	}
}
