import formats/html/html2form;

// Inspect the rendered label and activate its accessibility action, if any.
// The redirect hook captures the original URL; nothing is opened.
inspectLink(html : string) -> Pair<string, [string]> {
	urls = ref [];
	setRedirectAdditionalFn(\url, __ -> refArrayPush(urls, url));
	f = html2form(html, makeTree(), []);
	r = renderForm(f, const(WidthHeight(400.0, 100.0)), [], []);
	text = trim(getFormText(f));
	FindForm(f, \form -> switch (form) {
		Access(props, __): exists(props, \p -> switch (p) {
			AccessCallback(fn): { fn(); true }
			default: false;
		});
		default: false;
	});
	applyall(r.disposers);
	Pair(text, ^urls)
}

main() {
	anchor = \url -> inspectLink("<a href=\"" + xmlEscape(url) + "\"><b>Label</b></a>");
	iter(["chapter/one", "#note", "?q=x:y", "https://example.org/a?x=1&y=2", "mailto:a@example.org", "tel:123", "sms:123", "geo:0,0", "example-app:item"], \url ->
		assertEquals(anchor(url).second, [url]));
	iter(["data:,label", "JaVaScRiPt:", "vbscript:"], \url -> assertEquals(anchor(url), Pair("Label", [])));
	assertEquals(inspectLink("<newa href=\"data:,label\" title=\"A&amp;B\"/>").first, "A&amp;B");
	assert(strContains(inspectLink("<newa href=\"#note\" title=\"Label\"/>").first, "href=\"#note\""), "local newa link");
	println("html2form navigation tests passed");
	quit(0);
}
