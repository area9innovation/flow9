import formats/unicode/unidecode;

check(input : string, expected : string) -> void {
	actual = unidecode(input);
	if (actual != expected) {
		println("Expected " + toString(expected) + ", got " + toString(actual));
		quit(1);
	}
}

main() {
	check("", "");
	check("é", "e");
	check("\u04fa", "\u04fa");
	// Both table boundaries, expansion, deletion, and unmapped UTF-16 units.
	check("\u009f\u00a0áéü½\u00ad\u04f9\u04fa水🙂", "\u009f aeu1/2y\u04fa水🙂");
	check(strRepeat("Café ½! ", 128), strRepeat("Cafe 1/2! ", 128));
	println("unidecode: all checks passed");
	quit(0);
}
