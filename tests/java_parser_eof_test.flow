import tools/flowc/backends/java/parser/java_parser;

main() {
	valid = "package p; class A { char c = 'x'; String s = \"ok\"; /* comment */ }";
	parsed = parse_Compilation(valid);
	failed = ref false;
	if (parsed.first.choice == -1 || parsed.first.end != strlen(valid)) {
		println("Valid Java source was not fully consumed");
		failed := true;
	}
	iter(["package p; class A { char c = '", "package p; class A { String s = \"", "/* unfinished", "// unfinished"], \source -> {
		r = parse_Compilation(source);
		if (r.first.end == strlen(source) || r.second.pos != strlen(source)) {
			println("Expected a diagnostic at EOF for " + toString(source) + ", got " + toString(r.second));
			failed := true;
		}
	});
	quit(if (^failed) 1 else 0);
}
