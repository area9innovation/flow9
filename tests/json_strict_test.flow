import formats/json/json_parse;

failed = ref false;

check(ok : bool, label : string) -> void {
	if (!ok) {
		println("FAIL: " + label);
		failed := true;
	}
}

main() {
	check(parseJsonStrict(" \u000d\n{\"a\":[true,\tfalse,null,-12.5e+2,5E-1]} ") ==
		Some(JsonObject([Pair("a", JsonArray([JsonBool(true), JsonBool(false), JsonNull(), JsonDouble(-1250.0), JsonDouble(0.5)]))])),
		"object with JSON whitespace, array and numbers");
	check(parseJsonStrict("{\"a\\u0027b\":\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"}") ==
		Some(JsonObject([Pair("a'b", JsonString("\"\\/\u0008\u000c\n\u000d\t"))])), "all short escapes and an escaped key");
	check(parseJsonStrict("\"\\\\'\\\\b\\u03bb\\ud83d\\ude42 λ\"") == Some(JsonString("\\'\\bλ🙂 λ")), "backslashes, apostrophe and Unicode");
	check(parseJsonStrict("\"\\u0000\\u001f\"") == Some(JsonString("\u0000\u001f")), "escaped controls");
	iter(enumFromTo(0, 31), \i -> {
		c = fromCharCode(i);
		check(isNone(parseJsonStrict("\"a" + c + "b\"")), "raw control in a value: " + i2s(i));
		check(isNone(parseJsonStrict("{\"" + c + "\":0}")), "raw control in a key: " + i2s(i));
	});
	iter(["\"\\x41\"", "\"\\X0041\"", "\"\\q\"", "\"\\u12\"", "\"\\u0z12\"", "\"open",
		"01", "-01", ".5", "1.", "1.e2", "1e", "1e+", "+1", "[1,]", "{\"a\":0,}", "0 1", "\u000cnull", ""], \doc ->
		check(isNone(parseJsonStrict(doc)), "invalid JSON: " + toString(doc)));
	iter(["\"\\x41\"", "\"\\X0041\"", "\"\\q\"", "\"raw\nline\"", "01", ".5", "1."], \doc ->
		check(isSome(parseJsonSafer(doc)), "legacy grammar: " + toString(doc)));
	if (^failed) quit(1) else {
		println("Strict and legacy JSON checks passed");
		quit(0)
	}
}
