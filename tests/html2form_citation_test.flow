import formats/html/html2form;

// Capture the click through the redirect hook without opening a window.
citationTarget(attrs : string) -> string {
	url = ref "";
	setRedirectAdditionalFn(\u, __ -> url := u);
	form = html2form("<citation " + attrs + ">Source</citation>", makeTree(), []);
	r = renderForm(form, const(WidthHeight(400.0, 100.0)), [], []);
	FindForm(form, \f -> switch (f) {
		Interactive(listeners, __): exists(listeners, \e -> switch (e) {
			RespectHandled(event): switch (event) {
				MouseDown2(fn): fn(false, MouseDownInfo(0.0, 0.0, \ -> true));
				default: false;
			}
			default: false;
		});
		default: false;
	});
	applyall(r.disposers);
	^url
}

main() {
	assertEquals(citationTarget("doi=\"10.1000/a#b?c/d%20\""), "https://doi.org/10.1000/a%23b%3Fc/d%2520");
	assertEquals(citationTarget("doi=\"10.1000/a//b\""), "https://doi.org/10.1000/a//b");
	assertEquals(citationTarget("doi=\"10.1000/unused\" pubmedid=\"12345\""), "https://pubmed.ncbi.nlm.nih.gov/?term=12345");
	assertEquals(citationTarget("pubmedid=\"A+B &amp; C\""), "https://pubmed.ncbi.nlm.nih.gov/?term=A%2BB%20%26%20C");
	assertEquals(citationTarget(""), "");
	println("html2form citation tests passed");
	quit(0);
}
