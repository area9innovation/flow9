import formats/css/parse_css;

checkColor(value : string, expected : int) -> void {
	// An unrecognized second declaration should leave the first one in effect.
	styles = parseCss("p{color:red;color:" + value + "}").styles;
	got = lookupTreeDef(styles, "p", StyleWithSelectors(defCssStyle, makeTree())).style.color;
	if (got != expected) {
		println(value + ": expected " + i2s(expected) + ", got " + i2s(got));
		quit(1);
	}
}

main() {
	checkColor("#3aC", 0x33aacc);
	checkColor("#3aC8", 0x33aacc);
	checkColor("#12Ab34", 0x12ab34);
	checkColor("#12Ab3400", 0x12ab34);
	iter(["#0", "#12", "#12345", "#1234567", "#123456789", "#abz", "#123456fg", "#0xff"], \s -> checkColor(s, 0xff0000));

	// Numeric colors are a separate extension, including the legacy three-digit shorthand.
	checkColor("0xff", 255);
	checkColor("0xabc", 0xaabbcc);
	checkColor("0x1234", 0x1234);
	checkColor("0x00001234", 0x1234);
	checkColor("255", 255);
	checkColor("rgb(18,52,86)", 0x123456);
	styles = parseCss("p{border:1px solid #abc8;font-size:0x10px;line-height:#10}").styles;
	style = lookupTreeDef(styles, "p", StyleWithSelectors(defCssStyle, makeTree())).style;
	if (style.fontSize != 16.0 || style.lineHeight != 16.0 || !contains(style.border, Stroke(0xaabbcc))) {
		println("Unexpected border or numeric size");
		quit(1);
	}
	println("CSS hex colors: all checks passed");
	quit(0);
}
