import formats/lsp;

main() {
	id = JsonDouble(4.0);
	err = LspResponseError(-32602, "Invalid params", JsonString("position"));
	failure = LspResponseMessage("2.0", id, JsonNull(), Some(err));
	wire = parseJson("{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32602,\"message\":\"Invalid params\",\"data\":\"position\"}}");
	if (lspResponseMessage2Json(failure) != wire) {
		println("Expected an error with a numeric code and no result member");
		quit(1);
	} else if (json2LspResponseMessage(wire) != Some(failure)) {
		println("Expected an incoming numeric code to decode as an error");
		quit(1);
	} else if (json2LspResponseError(parseJson("{\"code\":\"-32602\",\"message\":\"Invalid params\"}")) !=
		Some(LspResponseError(-32602, "Invalid params", JsonNull()))) {
		println("Expected error codes from older Flow peers to remain readable");
		quit(1);
	} else if (lspResponseMessage2Json(LspResponseMessage("2.0", id, JsonNull(), None())) !=
		parseJson("{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":null}")) {
		println("Expected a successful empty response to include result: null");
		quit(1);
	} else {
		println("LSP response tests passed");
		quit(0);
	}
}
