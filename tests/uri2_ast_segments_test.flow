import formats/uri2/uri2_parser;
import formats/uri2/uri2_ast;
import lingo/compiler/syntaxtree_util;

failed = ref false;

check(description : string, ok : bool) -> void {
	if (!ok) {
		println("FAIL: " + description);
		failed := true;
	}
}

main() {
	uri = "https://example.test/first//last";
	path = get_URI_path_abempty(parse_URI(uri).first);
	groups = get_URI_path_abempty__auto29_s(path);
	segments = map(groups, get_URI_segment);
	check("one segment node per slash", forall(segments, \s -> s.rule == st_segment));
	check("path segments in order", map(segments, \s -> grabSTText(s, uri)) == ["first", "", "last"]);
	check("the path itself has no single segment", get_URI_segment(path) == failSyntaxTree);

	rel = "/first/last";
	relPath = get_URI_path_absolute(parse_URI(rel).first);
	first = get_URI_path_absolute__auto31_s(relPath);
	check("optional group after the first slash", length(first) == 1);
	group = firstElement(first, failSyntaxTree);
	check("first segment", grabSTText(get_URI_segment_nz(group), rel) == "first");
	rest = get_URI_path_absolute__auto30_s(group);
	check("remaining segments", map(rest, \g -> grabSTText(get_URI_segment(g), rel)) == ["last"]);
	check("absent optional group", get_URI_path_absolute__auto31_s(get_URI_path_absolute(parse_URI("/").first)) == []);
	if (!^failed) println("URI segment accessor checks passed");
	quit(if (^failed) 1 else 0);
}
