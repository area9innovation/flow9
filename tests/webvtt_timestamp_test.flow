import formats/webvtt/webvtt;

failed = ref false;

parseCue(timing : string, text : string) -> [CueBlock] {
	parseWebVTT("WEBVTT\n\n" + timing + "\n" + text + "\n").cues
}

check(ok : bool, message : string) -> void {
	if (!ok) {
		println("FAIL: " + message);
		failed := true;
	}
}

main() {
	cues = parseCue("00:01.001 --> 00:00:14.081", "One <00:03.010>two");
	check(length(cues) == 1, "timestamps with and without hours");
	cue = firstElement(cues, dummyCueBlock);
	check(cueTimestamp2double(cue.start) == 1.001, "one millisecond");
	check(cueTimestamp2double(cue.end) == 14.081, "leading zero in the end time");
	check(length(cue.text) == 2, "inline timestamp");
	inline = extractStruct(elementAt(cue.text, 1, CueText("", [])).style, dummyCueTimestamp);
	check(cueTimestamp2double(inline) == 3.010, "ten milliseconds in an inline timestamp");

	large = parseCue("600000:00:00.500 --> 0002147483647:59:59.000", "Long timeline");
	check(length(large) == 1, "representable hour fields");
	longCue = firstElement(large, dummyCueBlock);
	check(cueTimestamp2double(longCue.start) == 2160000000.5, "seconds beyond the int range");
	check(longCue.end == CueTimestamp(intMax, 59, 59, 0), "largest representable hour");

	check(parseCue("00:00.01 --> 00:02.000", "Short fraction") == [], "missing millisecond digit");
	check(parseCue("00:00.000 --> 00:02.0001", "Long fraction") == [], "fourth digit is not cue text");
	check(parseCue("00:00.000 --> 2147483648:00:00.000", "End") == [], "hour above the int range");
	check(parseCue("00:00.000 --> 00:01.000", "<2147483648:00:00.000>Text") == [], "inline hour above the int range");
	if (^failed) quit(1) else {
		println("WebVTT timestamp tests passed");
		quit(0)
	}
}
