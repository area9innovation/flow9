import formats/ini;
import sys/target;
import math/math;

// Tests of parseIniFile / iniFile2string (lib/formats/ini.flow).
// The timing tests check that parsing and printing stay fast for many keys and many sections.

failures : ref int = ref 0;

// Parsing and printing one generated file must each finish within this budget
timeBudgetMs = 1000.0;

check(name : string, actual : ?, expected : ?) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + toString(expected));
		println("  actual:   " + toString(actual));
	}
}

checkTime(name : string, ms : double) -> void {
	if (ms > timeBudgetMs) {
		failures := ^failures + 1;
		println("FAIL: " + name + " took " + d2s(ms) + " ms, budget " + d2s(timeBudgetMs) + " ms");
	}
}

sample = strGlue([
	"; a comment before the first section is skipped",
	"[owner]",
	"name=John Doe",
	"organization = Acme Widgets Inc.",
	"\ttabbed\t=indented value",
	"[database]",
	"; a comment with key=value inside is skipped",
	"server=192.0.2.62     ",
	"port=143",
	"file = \"payroll.dat\"",
	"quoted=\"\"",
	"quote=\"say \"\"hi\"\" twice\"",
	"multiline=\"first line",
	"second \"\"line\"\"\"",
	"padded=\"  spaces kept  \"",
	"empty=",
	"blank=   ",
	"[empty section]",
	"[last]",
	"tail=end"
], "\n");

expectedSample = IniFile([
	IniSection("owner", [
		KeyValue("name", "John Doe"),
		KeyValue("organization", "Acme Widgets Inc."),
		KeyValue("tabbed", "indented value")
	]),
	IniSection("database", [
		KeyValue("server", "192.0.2.62"),
		KeyValue("port", "143"),
		KeyValue("file", "payroll.dat"),
		KeyValue("quoted", ""),
		KeyValue("quote", "say \"hi\" twice"),
		KeyValue("multiline", "first line\nsecond \"line\""),
		KeyValue("padded", "  spaces kept  "),
		KeyValue("empty", ""),
		KeyValue("blank", "")
	]),
	IniSection("empty section", []),
	IniSection("last", [KeyValue("tail", "end")])
]);

expectedPrinted = strGlue([
	"[owner]",
	"name=John Doe",
	"organization=Acme Widgets Inc.",
	"tabbed=indented value",
	"",
	"[database]",
	"server=192.0.2.62",
	"port=143",
	"file=payroll.dat",
	"quoted=",
	"quote=\"say \"\"hi\"\" twice\"",
	"multiline=\"first line",
	"second \"\"line\"\"\"",
	"padded=\"  spaces kept  \"",
	"empty=",
	"blank=",
	"",
	"[empty section]",
	"",
	"[last]",
	"tail=end",
	"",
	""
], "\n");

testParse() -> void {
	check("parse sample", parseIniFile(sample), expectedSample);
	check("parse empty text", parseIniFile(""), IniFile([]));
	check("keys before the first section are skipped", parseIniFile("key=value\n"), IniFile([]));
	check("CRLF line ends", parseIniFile("[s]\u000d\nkey=value\u000d\nother = x \u000d\n"),
		IniFile([IniSection("s", [KeyValue("key", "value"), KeyValue("other", "x")])]));
	check("value keeps = and ; after the first =", parseIniFile("[s]\nurl=a=b;c\n"),
		IniFile([IniSection("s", [KeyValue("url", "a=b;c")])]));
	check("quoted value ignores spaces before the quote", parseIniFile("[s]\nk =   \"v\"\n"),
		IniFile([IniSection("s", [KeyValue("k", "v")])]));
}

// Current behaviour at the edges of the format, kept as is
testEdgeCases() -> void {
	check("trailing comment with = and no final newline is read as a key", parseIniFile("[s]\nk=v\n; note=1"),
		IniFile([IniSection("s", [KeyValue("k", "v"), KeyValue("note", "1")])]));
	check("text after a closing quote joins the next key", parseIniFile("[s]\na=\"x\" tail\nb=2\n"),
		IniFile([IniSection("s", [KeyValue("a", "x"), KeyValue("tail\nb", "2")])]));
	check("CR is trimmed before a newline but kept on the last line", parseIniFile("[s]\na=1\u000d\nb=2\u000d"),
		IniFile([IniSection("s", [KeyValue("a", "1"), KeyValue("b", "2\u000d")])]));
	check("a [ at the very end starts no section", parseIniFile("[s]\nk=v\n["),
		IniFile([IniSection("s", [KeyValue("k", "v")])]));
	check("a header without ] takes the rest as its name", parseIniFile("[s]\n[tail"),
		IniFile([IniSection("s", []), IniSection("tail", [])]));
	check("an unterminated quote takes the rest as the value", parseIniFile("[s]\nk=\"open\nmore"),
		IniFile([IniSection("s", [KeyValue("k", "open\nmore")])]));
}

testPrint() -> void {
	check("print sample", iniFile2string(parseIniFile(sample)), expectedPrinted);
	check("print empty file", iniFile2string(IniFile([])), "");
	check("print quotes a value with surrounding spaces", iniFile2string(IniFile([IniSection("s", [KeyValue("k", " v ")])])), "[s]\nk=\" v \"\n\n");
	check("print quotes a value with a line break", iniFile2string(IniFile([IniSection("s", [KeyValue("k", "a\n[b]")])])), "[s]\nk=\"a\n[b]\"\n\n");
	check("print quotes a value with a carriage return", iniFile2string(IniFile([IniSection("s", [KeyValue("k", "a\u000db")])])), "[s]\nk=\"a\u000db\"\n\n");
	check("print leaves = ; and brackets inside a value unquoted", iniFile2string(IniFile([IniSection("s", [KeyValue("k", "a=b;[c]")])])), "[s]\nk=a=b;[c]\n\n");
}

testRoundTrip() -> void {
	check("round trip of sample", parseIniFile(iniFile2string(parseIniFile(sample))), parseIniFile(sample));
	check("round trip of printed sample", iniFile2string(parseIniFile(expectedPrinted)), expectedPrinted);
	// A value that spans lines reads back as one value, and the lines inside it start no key or section
	values = IniFile([
		IniSection("s", [
			KeyValue("lines", "first\nsecond=2\n[other]\nthird"),
			KeyValue("crlf", "a\u000d\nb"),
			KeyValue("lone cr", "a\u000db"),
			KeyValue("ends with a cr", "a\u000d"),
			KeyValue("starts with a cr", "\u000da"),
			KeyValue("ends with a line break", "a\n"),
			KeyValue("brackets", "[x] = y; z"),
			KeyValue("next", "kept")
		]),
		IniSection("t", [KeyValue("k", "v")])
	]);
	check("round trip of values with line breaks", parseIniFile(iniFile2string(values)), values);
	names = IniFile([
		IniSection("with \"quotes\"", [KeyValue("k", "1")]),
		IniSection(" spaced ", [KeyValue("k", "2")]),
		IniSection("a [nested", [KeyValue("k", "3")])
	]);
	check("section names print as they are", iniFile2string(names), "[with \"quotes\"]\nk=1\n\n[ spaced ]\nk=2\n\n[a [nested]\nk=3\n\n");
	check("round trip of section names", parseIniFile(iniFile2string(names)), names);
}

testLegacyNames() -> void {
	text = strGlue([
		"[\"Section\"]",
		"\"Key\"=\"value\"",
		"'single'=plain",
		"a\"\"b=double",
		"C:\\new\\tab=\\n\\r\\t",
		"[  Mixed Case \t]",
		"  Mixed Key \t=value",
		"[\"\"\"quoted\"\"\"]",
		"\"\"=empty quotes",
		"[C:\\new\\tab]",
		"key=path"
	], "\n");
	names = IniFile([
		IniSection("\"Section\"", [KeyValue("\"Key\"", "value"), KeyValue("'single'", "plain"),
			KeyValue("a\"\"b", "double"), KeyValue("C:\\new\\tab", "\\n\\r\\t")]),
		IniSection("  Mixed Case \t", [KeyValue("Mixed Key", "value")]),
		IniSection("\"\"\"quoted\"\"\"", [KeyValue("\"\"", "empty quotes")]),
		IniSection("C:\\new\\tab", [KeyValue("key", "path")])
	]);
	check("unmarked names keep quotes, case, whitespace and backslashes", parseIniFile(text), names);
	check("legacy quoted names round trip without reinterpretation", parseIniFile(iniFile2string(names)), names);
	check("legacy names do not enable the extension", strLeft(iniFile2string(names), 1), "[");
	// Only the exact first line is reserved; ordinary comments and later lookalikes stay comments.
	iter(["; flow9-ini: quoted-names-v1 \n", "; before\n; flow9-ini: quoted-names-v1\n", "; flow9-ini: quoted-names-v2\n"], \prefix -> {
		check("marker lookalike keeps legacy names", parseIniFile(prefix + "[\"s\"]\n\"k\"=v\n"),
			IniFile([IniSection("\"s\"", [KeyValue("\"k\"", "v")])]));
	});
}

testQuotedNames() -> void {
	marker = "; flow9-ini: quoted-names-v1\n";
	file = IniFile([
		IniSection("a]b", [KeyValue("a=b;[c]", "v"), KeyValue("\"legacy\"", "\\n\\t")]),
		IniSection("\"literal\"", [KeyValue("safe", "\"quoted\"")])
	]);
	printed = marker + "[\"a]b\"]\n\"a=b;[c]\"=v\n\"\"\"legacy\"\"\"=\\n\\t\n\n"
		+ "[\"\"\"literal\"\"\"]\n\"safe\"=\"\"\"quoted\"\"\"\n\n";
	check("unrepresentable names select marked, fully quoted output", iniFile2string(file), printed);
	check("marked output reads back", parseIniFile(printed), file);
	check("marked output is stable", iniFile2string(parseIniFile(printed)), printed);
	check("CRLF marker", parseIniFile(strReplace(printed, "\n", "\u000d\n")), file);
	check("marked input may mix plain and quoted names", parseIniFile(marker + "[plain]\n\"a=b\"=x\nraw=y\n[\"q]s\"]\n\"\"=z\n"),
		IniFile([IniSection("plain", [KeyValue("a=b", "x"), KeyValue("raw", "y")]), IniSection("q]s", [KeyValue("", "z")])]));
	check("multiline names do not introduce keys or sections", parseIniFile(marker + "[\"a\n[b]=c;d\"]\n\"a\n[b]=c;d\"=v\n\"next\"=kept\n"),
		IniFile([IniSection("a\n[b]=c;d", [KeyValue("a\n[b]=c;d", "v"), KeyValue("next", "kept")])]));
	check("an unterminated quoted key skips only its line", parseIniFile(marker + "[\"s\"]\n\"a=1\nk=v\n[\"t\"]\nj=1"),
		IniFile([IniSection("s", [KeyValue("k", "v")]), IniSection("t", [KeyValue("j", "1")])]));
	check("a section on the line of an unterminated quoted key is read", parseIniFile(marker + "[\"a\"]\n\"k [b]\nj=1"),
		IniFile([IniSection("a", []), IniSection("b", [KeyValue("j", "1")])]));
	check("the rest of a malformed header line is not read as keys", parseIniFile(marker + "[\"s\" note=\"see\n[\"b\"]\nk=v\n"),
		IniFile([IniSection("b", [KeyValue("k", "v")])]));
	check("a stray quote pairs with a later quote and =, as a multiline name", parseIniFile(marker + "[\"a\"]\n\"note\nk=v\nlabel\" = 2\n"),
		IniFile([IniSection("a", [KeyValue("note\nk=v\nlabel", "2")])]));
	check("a stray quote in a key does not pair with a later header", parseIniFile(marker + "[\"a\"]\n\"note\n[\"sec\"]\nk=v\n"),
		IniFile([IniSection("a", []), IniSection("sec", [KeyValue("k", "v")])]));
	check("a stray quote in a header does not pair with the next header", parseIniFile(marker + "[\"abc]\nlost=1\n[\"real\"]\nk=v\n"),
		IniFile([IniSection("real", [KeyValue("k", "v")])]));
	check("a stray quote in a comment header does not take the first section", parseIniFile(marker + "; use [\"odd names\n[\"real\"]\nk=v"),
		IniFile([IniSection("real", [KeyValue("k", "v")])]));
	check("a multiline quoted name without = skips its first line", parseIniFile(marker + "[\"s\"]\n\"a\nb\" x\n\"c\"=1\n"),
		IniFile([IniSection("s", [KeyValue("c", "1")])]));
	check("quoted key without adjacent = skips its line", parseIniFile(marker + "[\"s\"]\n\"a\" tail=x\n[other]\nk=v"),
		IniFile([IniSection("s", []), IniSection("other", [KeyValue("k", "v")])]));
	check("quoted section without adjacent ] is dropped with its keys", parseIniFile(marker + "[\"s\" tail]\nk=v\n\"q\"=[x]\n[\"other\"]\nk2=v2"),
		IniFile([IniSection("other", [KeyValue("k2", "v2")])]));
	check("a quoted name alone on a line is skipped", parseIniFile(marker + "[\"a\"]\n\"note\"\n\"k\"=1\n[\"b\"]\n\"x\"=2"),
		IniFile([IniSection("a", [KeyValue("k", "1")]), IniSection("b", [KeyValue("x", "2")])]));
	check("a quoted token after a quoted value is skipped", parseIniFile(marker + "[\"s\"]\n\"k\"=\"v\" \"trailing\"\n\"n\"=2\n"),
		IniFile([IniSection("s", [KeyValue("k", "v"), KeyValue("n", "2")])]));
	check("quoted section with junk at the end of input is dropped", parseIniFile(marker + "[\"a\"]\nk=v\n[\"s\" tail"),
		IniFile([IniSection("a", [KeyValue("k", "v")])]));
	iter(["", "\n", "\u000d\n"], \ending -> {
		check("quoted section without ] at the end of input is dropped: " + toString(ending), parseIniFile(marker + "[\"a\"]\nk=v\n[\"s\" " + ending),
			IniFile([IniSection("a", [KeyValue("k", "v")])]));
		check("quoted key without = at the end of input is dropped: " + toString(ending), parseIniFile(marker + "[\"a\"]\nk=v\n\"s\" " + ending),
			IniFile([IniSection("a", [KeyValue("k", "v")])]));
	});
	check("a section on the line of a malformed quoted key is read", parseIniFile(marker + "[\"a\"]\n\"k\" [b]\nj=1\n"),
		IniFile([IniSection("a", []), IniSection("b", [KeyValue("j", "1")])]));
	check("a stray line does not join the next quoted key", parseIniFile(marker + "[\"s\"]\nstray\n\"a=b\"=1\n"),
		IniFile([IniSection("s", [KeyValue("a=b", "1")])]));
	check("text after a quoted value does not join the next quoted key", parseIniFile(marker + "[\"s\"]\n\"k\"=\"v\" tail\n\"a=b\"=1\n"),
		IniFile([IniSection("s", [KeyValue("k", "v"), KeyValue("a=b", "1")])]));
	check("a stray CRLF line is skipped", parseIniFile(marker + "[\"s\"]\u000d\nstray\u000d\nk=v\u000d\n"),
		IniFile([IniSection("s", [KeyValue("k", "v")])]));
	check("a quote left open after doubled quotes skips only its line", parseIniFile(marker + "[\"s\"]\nk=v\n\"a\"\"=1\n[\"t\"]\n"),
		IniFile([IniSection("s", [KeyValue("k", "v")]), IniSection("t", [])]));
	check("spaces and tabs may precede a quoted section name", parseIniFile(marker + "[ \t\"a]b\" ]\nk=v\n[ plain ]\n"),
		IniFile([IniSection("a]b", [KeyValue("k", "v")]), IniSection(" plain ", [])]));
	check("spaces and tabs may follow a quoted name", parseIniFile(marker + "[\"s\" \t]\n\"timeout\" = 30\n\"k=\"\t=\"v\"\n[\"t\" ]\nk=v\n"),
		IniFile([IniSection("s", [KeyValue("timeout", "30"), KeyValue("k=", "v")]), IniSection("t", [KeyValue("k", "v")])]));
	check("a line break after a quoted name skips it, and the next line is read on its own", parseIniFile(marker + "[\"s\"]\n\"a\"\n=x\n[other]\nk=v"),
		IniFile([IniSection("s", [KeyValue("", "x")]), IniSection("other", [KeyValue("k", "v")])]));
	bom = "\uFEFF";
	check("marker after a byte order mark", parseIniFile(bom + printed), file);
	check("unmarked text after a byte order mark", parseIniFile(bom + "[\"s\"]\n\"k\"=v\n"),
		IniFile([IniSection("\"s\"", [KeyValue("\"k\"", "v")])]));
	check("an unterminated quoted section skips only its line", parseIniFile(marker + "[\"a\n[other]\nk=v"),
		IniFile([IniSection("other", [KeyValue("k", "v")])]));
	check("an unterminated quote at the end of input", parseIniFile(marker + "[\"s\"]\nk=v\n\"open"),
		IniFile([IniSection("s", [KeyValue("k", "v")])]));
	check("whitespace before a quoted key is outside its name", parseIniFile(marker + "[\"s\"]\n; comment\n\t \" padded \"=v\n"),
		IniFile([IniSection("s", [KeyValue(" padded ", "v")])]));
	check("marker is omitted when parsed names need no extension", iniFile2string(parseIniFile(marker + "[\"s\"]\n\"k\"=v\n")), "[s]\nk=v\n\n");
	check("empty marked document", parseIniFile(marker), IniFile([]));

	parts = ["", "normal", "Mixed Case", "=", "[", "]", ";", "a=b;[c]", "\"", "\"\"", "\"quoted\"", "'single'",
		" ", " leading", "trailing ", "\t", "\tleading", "trailing\t", "\n", "\u000d", "\u000d\n",
		"a\nb", "a\u000db", "a\u000d\nb", "\n[other]\nk=v\n;comment", "\\", "\\n\\r\\t", "\\\"", "\"\\", "C:\\new\\tab", "æøå 😀"];
	iter(parts, \name -> {
		one = IniFile([IniSection(name, map(parts, \key -> KeyValue(key, name))), IniSection("tail", [KeyValue("next", "kept")])]);
		check("name and value matrix: " + toString(name), parseIniFile(iniFile2string(one)), one);
		// Safe names and empty names also work without forcing the marked path via another key.
		single = IniFile([IniSection(name, [KeyValue(name, name)])]);
		check("single name and value: " + toString(name), parseIniFile(iniFile2string(single)), single);
	});
	// Combine characters around quotes and delimiters, rather than only checking them in isolation.
	atoms = ["", "a", "=", "[", "]", ";", "\"", "\\", " ", "\t", "\n", "\u000d"];
	combinations = mapConcat(atoms, \a -> map(atoms, \b -> a + b));
	combined = IniFile(map(combinations, \name -> IniSection(name, [KeyValue(name, name)])));
	check("combined name and value characters", parseIniFile(iniFile2string(combined)), combined);
	duplicates = IniFile([IniSection("s]", [KeyValue("k=", "1"), KeyValue("k=", "2")]), IniSection("s]", []), IniSection("", [])]);
	check("marked duplicate names and empty sections keep their order", parseIniFile(iniFile2string(duplicates)), duplicates);
}

makeIni(sections : int, keysPerSection : int) -> string {
	concatStrings(generate(0, sections, \i -> {
		"[section" + i2s(i) + "]\n"
		+ concatStrings(generate(0, keysPerSection, \j -> "key" + i2s(j) + "=value" + i2s(j) + "\n"))
		+ "\n"
	}));
}

measure(sections : int, keysPerSection : int) -> void {
	text = makeIni(sections, keysPerSection);
	name = i2s(sections) + " sections x " + i2s(keysPerSection) + " keys";
	parseStart = timestamp();
	parsed = parseIniFile(text);
	parseMs = timestamp() - parseStart;
	printStart = timestamp();
	printed = iniFile2string(parsed);
	printMs = timestamp() - printStart;
	println("  " + name + ": parse " + d2s(parseMs) + " ms, print " + d2s(printMs) + " ms");
	check(name + ": section count", length(parsed.sections), sections);
	check(name + ": key count", fold(parsed.sections, 0, \acc, s -> acc + length(s.keys)), sections * keysPerSection);
	check(name + ": print gives the input back", printed, text);
	checkTime(name + ": parse", parseMs);
	checkTime(name + ": print", printMs);
}

// Text with no line end after some point must parse just as fast
measureParse(name : string, text : string, sections : int, keys : int) -> void {
	parseStart = timestamp();
	parsed = parseIniFile(text);
	parseMs = timestamp() - parseStart;
	println("  " + name + ": parse " + d2s(parseMs) + " ms");
	check(name + ": section count", length(parsed.sections), sections);
	check(name + ": key count", fold(parsed.sections, 0, \acc, s -> acc + length(s.keys)), keys);
	checkTime(name + ": parse", parseMs);
}

testPerformance() -> void {
	println("Performance:");
	small = makeIni(10, 10);
	check("warm-up round trip", iniFile2string(parseIniFile(small)), small);
	measure(200, 100);
	measure(1, 20000);
	measure(20000, 1);
	measureParse("20000 headers on one line", concatStrings(generate(0, 20000, \i -> "[s" + i2s(i) + "]")), 20000, 0);
	measureParse("20000 comment marks after the last line end", "[s]\n" + strRepeat(";x", 20000), 1, 0);
	measureParse("20000 quoted values on one line", "[s]\n" + strRepeat("k=\"v\" ", 20000), 1, 20000);
	marker = "; flow9-ini: quoted-names-v1\n";
	measureParse("20000 quoted names on one line", marker + "[\"s\"]\n" + strRepeat("\"k=[;\"=\"v\" ", 20000), 1, 20000);
	measureParse("20000 quoted headers on one line", marker + strRepeat("[\"s]\"]", 20000), 20000, 0);
	measureParse("20000 lines with a stray quote", marker + "[\"s\"]\n" + strRepeat("\"x\n", 20000) + "k=v\n", 1, 1);
	measureParse("20000 headers with a stray quote", marker + strRepeat("[\"x\n", 20000) + "[\"s\"]\nk=v\n", 1, 1);
}

main() {
	testParse();
	testEdgeCases();
	testPrint();
	testRoundTrip();
	testLegacyNames();
	testQuotedNames();
	testPerformance();

	if (^failures == 0) {
		println("all passed in " + getTargetName());
		quit(0);
	} else {
		println(i2s(^failures) + " INI test(s) failed in " + getTargetName());
		quit(1);
	}
}
