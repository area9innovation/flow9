import formats/csv;
import sys/target;

// Tests of the separator check in parseCsvData (lib/formats/csv.flow): an empty separator and one
// that holds a double quote are refused, any other separator parses.

failures : ref int = ref 0;

check(name : string, actual : Pair<[[string]], string>, expected : Pair<[[string]], string>) -> void {
	if (actual != expected) {
		failures := ^failures + 1;
		println("FAIL: " + name);
		println("  expected: " + toString(expected));
		println("  actual:   " + toString(actual));
	}
}

refused = Pair([], "invalid separator");

testRefused() -> void {
	iter(["", "\"", "a\"", "\"b", ";\";"], \sep -> {
		check("separator " + toString(sep) + " is refused", parseCsvData("a,b", [ParseCsvSeparator(sep)]), refused);
		check("separator " + toString(sep) + " is refused without quoted escapes",
			parseCsvData("a,b", [ParseCsvSeparator(sep), ParseCsvQuotedEscapes(false)]), refused);
	});
}

testAccepted() -> void {
	iter([",", ";", "\t", "|", " ", "::", "\\", "'"], \sep -> {
		data = "a" + sep + "b\n\"x\"" + sep + "\"y\"\"z\"";
		check("separator " + toString(sep) + " parses", parseCsvData(data, [ParseCsvSeparator(sep)]), Pair([["a", "b"], ["x", "y\"z"]], ""));
	});
	check("default separator", parseCsvData("a,b\n1,2", []), Pair([["a", "b"], ["1", "2"]], ""));
}

main() {
	testRefused();
	testAccepted();

	if (^failures == 0) {
		println("CSV separator tests: all passed in " + getTargetName());
		quit(0);
	} else {
		println(i2s(^failures) + " CSV separator test(s) failed in " + getTargetName());
		quit(1);
	}
}
