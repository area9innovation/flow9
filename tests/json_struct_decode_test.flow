import formats/json/flow2json;

// Run on the Java backend, which implements the reflection natives.
DecodeRecord(a : string, b : string, c : string, d : string, e : string, f : string,
	g : string, h : string, i : string, j : string, k : string, l : string,
	m : string, n : string, o : string, p : string, q : string, r : string);

main() {
	expected = DecodeRecord("a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r");
	fields = reverseA(getJsonObjectValue(flow2json(expected), []));
	assert(json2flow(JsonObject(fields)) == flow(expected), "reordered fields");
	// Match by declared name regardless of order; only the first occurrence counts.
	assert(json2flow(JsonObject(concat3([Pair("unused", JsonNull())], fields, [
		Pair("p", JsonNull()), Pair("struct", JsonString("None"))
	]))) == flow(expected), "extra fields and later duplicates");
	assert(isSameStructType(json2flow(JsonObject(concat([Pair("p", JsonNull())], fields))), IllegalStruct()), "first occurrence is null");
	assert(isSameStructType(json2flow(JsonObject(tail(fields))), IllegalStruct()), "missing field");
	pairTag = Pair("struct", JsonString("Pair"));
	assert(json2flow(JsonObject([Pair("second", JsonBool(true)), pairTag, Pair("first", JsonString("a"))])) == flow(Pair("a", true)), "small record");
	assert(isSameStructType(json2flow(JsonObject([pairTag, Pair("second", JsonBool(true))])), IllegalStruct()), "missing field in small record");
	// Primitive values and nested arrays are valid decoded values, not structs.
	assert(json2flow(JsonArray([JsonString("a"), JsonArray([JsonBool(true)])])) == flow([flow("a"), flow([true])]), "mixed array");
	assert(isSameStructType(json2flow(JsonArray([JsonArray([JsonNull()])])), IllegalStruct()), "nested null");
	println("JSON struct decode tests passed");
	quit(0);
}
