import formats/php/php_ast;
import sys/system;

check(label : string, ok : bool) -> void {
	if (!ok) {
		println("FAIL: " + label);
		quit(1);
	}
}

main() {
	// Labels, literal keys, qualified calls and formula source are not names
	// introduced by the generated function.
	arg = PhpVar("café_2");
	result = PhpVar("_résultat2");
	stmt = PhpAssign(result, PhpFunctionCall("\\strtoupper", [arg]));
	append = PhpFunctionCallStub("$" + result.name + " .= '!'");
	block = PhpBlock([arg], [result], [stmt, PhpIf_If("0 < 1", PhpBlock([], [], [append], []))], [result]);
	source = phpElement2string(PhpFunction("résumé_2", block));
	label = "line-total (2026)";
	data = phpElement2string(PhpArray([PhpVarVal(label, PhpConstString("ordinary label"))]));
	output = ref "";
	call = "echo résumé_2(" + data + "['" + label + "'])['_résultat2'];";
	code = execSystemProcess("php", ["-n", "-r", source + call], ".", \line -> output := ^output + line, println);
	check("PHP CLI reads the named function and its result", code == 0 && ^output == "ORDINARY LABEL!");

	checkProblem = \f, role -> check(role, phpElement2string(f) == "/* Cannot generate PHP: " + role + " is not a PHP identifier. */\n");
	checkProblem(PhpFunction("quarter totals", block), "function name \"quarter totals\"");
	checkProblem(PhpFunction("report", PhpBlock(block with externalVars = [arg, PhpVar("line-total")])), "parameter #2 \"line-total\"");
	checkProblem(PhpFunction("report", PhpBlock(block with declaredVars = [PhpVar("2nd")])), "local variable #1 \"2nd\"");
	checkProblem(PhpFunction("report", PhpBlock(block with returnVars = [PhpVar("")])), "return variable #1 \"\"");
	checkProblem(PhpFunction("item*/unit\nprice", block), "function name \"item*\\u002funit\\nprice\"");
	println("PHP function name tests passed");
	quit(0);
}
